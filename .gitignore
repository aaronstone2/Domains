# Claude Code
.claude/
# .mcp.json is committed — registers the harness MCP server + companion DBs
# so claude code on a fresh clone can call ask/lookup/playbook as tools.

# Local data — _db is gitignored EXCEPT the snapshot DB which is committed
# so a fresh clone has the corpus available immediately (interview-day
# robustness). Raw fetched pages and intermediate staging stay ignored.
_db/raw/
_db/staging/
_db/*.duckdb.wal
_db/*.duckdb.tmp/

# Personal scratch — paste logs/reports here. Concrete rules below the
# global `logs/` and `*.log` rules so they take precedence (last wins).

# Per-domain raw fetched HTML/MD caches — rebuildable from sources.yaml + ingest pipeline.
# (extract/ stays committed: the corpus is reproducible from JSON without re-fetching.)
domains/**/raw/

# Project-root MD files. Only intentional ones are allowlisted below; everything else
# (e.g. scratch dumps from Explore agents during research) is ignored so they don't
# accidentally get committed via `git add .`. If a future doc legitimately belongs at
# repo root, add an explicit allowlist line here.
/*.md
!/CLAUDE.md
!/README.md
!/Start.md

# Tokens / API keys captured during DevBox inspection — extra-paranoid, in addition to .env / *.key
*.token
*sensitive*

# OS
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
!packages/bootstrap/src/lib/secrets.ts
credentials.*

# _secrets/ holds age-encrypted files only — plaintext is gitignored, encrypted is committed.
# The age ciphertext requires the user's SSH PRIVATE key to decrypt; safe in a public repo.
# See packages/bootstrap/src/modules/anthropic-key.ts and DEVBOX-INSTALL.md.
_secrets/*
!_secrets/.gitkeep
!_secrets/*.age
!_secrets/README.md

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Personal scratch — notes/ — must come AFTER the global logs/ and *.log
# rules so the re-include wins (last matching rule applies in gitignore).
!notes/logs/
!notes/reports/
notes/logs/*
notes/reports/*
!notes/README.md
!notes/logs/README.md
!notes/reports/README.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!packages/*/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg
.venv/
venv/
env/
ENV/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.ipynb_checkpoints/

# Node / JS
node_modules/
.npm
.yarn/
.pnp.*
.next/
.nuxt/
.parcel-cache/
.turbo/
.svelte-kit/
.cache/

# DuckDB / data — *.duckdb gitignored globally, but _db/knowledge.duckdb is
# explicitly allowlisted because it ships with the repo so fresh clones can
# query the corpus without rebuilding from JSONLs.
*.duckdb
!_db/knowledge.duckdb
*.duckdb.wal
*.duckdb.tmp/
*.db
*.sqlite
*.sqlite3

# Build / temp
tmp/
temp/
*.tmp
*.bak
*.orig
