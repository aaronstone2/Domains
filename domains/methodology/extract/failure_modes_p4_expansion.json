  {"id":"methodology.fm.5whys-not-finding-root","symptom":"5-whys analysis terminates with 'human error' or 'process broken'; no actionable cause","error_patterns":["5 whys","human error","process broken","blame"],"root_cause_class":"meta","affected_concepts":["methodology.5-whys","methodology.symptoms-vs-causes","methodology.contributing-cause"],"diagnostic_steps":[{"step":1,"action":"Re-read postmortem chain","command":"# look for 'human' in any 'why'","expected":"chain stopped early","source_id":"sre-postmortem-culture"}],"fix_steps":[{"step":1,"action":"Treat 'human error' as a symptom; ask 'why was this human in a position to fail?'","command":"# next why: lacking automation/training/safeguard","validation":"chain reaches systemic cause","rollback":null,"source_id":"sre-postmortem-culture"},{"step":2,"action":"Switch to causal-graph (multiple contributing causes)","command":"# acknowledge several factors enabled the failure","validation":"richer model","rollback":null,"source_id":"sre-postmortem-culture"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["sre-postmortem-culture","sre-effective-troubleshooting"]},
