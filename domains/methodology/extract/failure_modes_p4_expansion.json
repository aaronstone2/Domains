  {"id":"methodology.fm.flame-graph-misread","symptom":"Engineer reads flame graph as 'time' but it's 'samples'; wrong conclusion","error_patterns":["flame graph","misread","width","samples"],"root_cause_class":"profiling","affected_concepts":["methodology.flame-graph","methodology.cpu-flame-graph","methodology.flame-chart"],"diagnostic_steps":[{"step":1,"action":"Confirm what the x-axis represents","command":"# CPU flame graph: width = sample count = on-CPU time proxy; flame chart: width = wall-clock","expected":"matches the question being asked","source_id":"brendangregg-flamegraphs"}],"fix_steps":[{"step":1,"action":"For wall-clock latency: use flame chart (chronological)","command":"# Chrome trace viewer or Perfetto","validation":"answers 'when' not just 'how much'","rollback":null,"source_id":"brendangregg-flamegraphs"},{"step":2,"action":"For off-CPU time: off-CPU flame graph","command":"# perf record sched events; FlameGraph collapse","validation":"see blocked-time stacks","rollback":null,"source_id":"brendangregg-offcpu"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["brendangregg-flamegraphs","brendangregg-offcpu"]},
