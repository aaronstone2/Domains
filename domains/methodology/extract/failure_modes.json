[
  {"id":"methodology.fm.applied-wrong-method","symptom":"Investigating service-throughput problem with USE Method finds nothing useful","error_patterns":["USE Method blank","wrong methodology"],"root_cause_class":"meta","affected_concepts":["methodology.use-method","methodology.red-method"],"diagnostic_steps":[{"step":1,"action":"Identify problem domain","command":"# is it: resource exhaustion (USE) OR request behavior (RED) OR latency (Four Golden Signals) OR off-CPU?","expected":"clear classification","source_id":"sre-monitoring-signals"}],"fix_steps":[{"step":1,"action":"Switch methodology","command":"# resource issue → USE; service request issue → RED; latency → Golden Signals; off-CPU → off-CPU flame graph","validation":"new methodology surfaces issue","rollback":"go back","source_id":"brendangregg-usemethod"}],"confidence":0.7,"last_verified":"2026-05-03","source_ids":["sre-monitoring-signals","brendangregg-usemethod"]},
  {"id":"methodology.fm.cpu-utilization-misleading","symptom":"CPU utilization is high but app slow — but RED metrics show OK","error_patterns":["high CPU","but throughput OK","misleading util"],"root_cause_class":"observability","affected_concepts":["methodology.cpu-utilization-misleading"],"diagnostic_steps":[{"step":1,"action":"Check actual instructions retired (vs cycles)","command":"perf stat -e cycles,instructions sleep 10","expected":"low IPC = stalled CPU not actually busy","source_id":"man7-perf-stat-1"},{"step":2,"action":"Check off-CPU time","command":"# off-CPU flame graph","expected":"see what's blocking","source_id":"brendangregg-linux-perf"}],"fix_steps":[{"step":1,"action":"Diagnose stalls","command":"# perf-stat with stalled-cycles-{frontend,backend}","validation":"identify stall source","rollback":null,"source_id":"man7-perf-stat-1"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["brendangregg-linux-perf","man7-perf-stat-1"]},
  {"id":"methodology.fm.no-baseline-cant-debug","symptom":"User reports 'system slow' but no baseline metrics","error_patterns":["no baseline","historical data missing"],"root_cause_class":"observability","affected_concepts":["methodology.monitoring","methodology.four-golden-signals"],"diagnostic_steps":[{"step":1,"action":"Quick capture current state","command":"# vmstat 1 30 ; iostat -x 1 30 ; ps aux ; ss -s ; w","expected":"snapshot for comparison","source_id":"debian-vmstat-8"}],"fix_steps":[{"step":1,"action":"Install monitoring","command":"# node_exporter + Prometheus + Grafana, or DataDog, etc.","validation":"metrics flowing","rollback":"uninstall","source_id":"sre-monitoring-signals"},{"step":2,"action":"Capture USE-Method snapshots routinely","command":"# scripted: linux-perf-tools.sh on cron","validation":"baseline data accumulating","rollback":null,"source_id":"brendangregg-linux-crisis-tools"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["sre-monitoring-signals","brendangregg-linux-crisis-tools"]},
  {"id":"methodology.fm.alert-fatigue","symptom":"Operators stop responding to alerts; everyone knows they're noise","error_patterns":["alert fatigue","alert storm","ignored alerts"],"root_cause_class":"alerting","affected_concepts":["methodology.alert-fatigue","methodology.four-golden-signals"],"diagnostic_steps":[{"step":1,"action":"Audit alerts: pages per week per oncall","command":"# count from incident system","expected":"<3 actionable per oncall-week is healthy","source_id":"sre-managing-incidents"},{"step":2,"action":"Audit by % actionable","command":"# of alerts paged, what % required action vs auto-recovered","expected":">90% actionable","source_id":"sre-monitoring-signals"}],"fix_steps":[{"step":1,"action":"Symptom-based alerts only","command":"# move alerting to user-visible symptoms (RED/Golden Signals); demote cause-based to dashboards","validation":"reduced page rate","rollback":"restore","source_id":"sre-monitoring-signals"},{"step":2,"action":"Tune thresholds + windows","command":"# require sustained breach (5min) and per-hostgroup not per-host","validation":"flap-page rate down","rollback":"restore","source_id":"sre-monitoring-signals"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["sre-monitoring-signals","sre-managing-incidents"]},
  {"id":"methodology.fm.postmortem-blame","symptom":"Engineer reluctant to participate in postmortem; team morale damaged","error_patterns":["blame culture","postmortem avoided","engineer reluctant"],"root_cause_class":"culture","affected_concepts":["methodology.blameless-postmortem","methodology.psychological-safety"],"diagnostic_steps":[{"step":1,"action":"Re-read existing postmortems","command":"# look for personal blame / reprimand language","expected":"found","source_id":"sre-postmortem-culture"}],"fix_steps":[{"step":1,"action":"Adopt blameless template","command":"# pagerduty/response.pagerduty.com or sre/postmortem-templates","validation":"new postmortems use it","rollback":"old format","source_id":"sre-postmortem-culture"},{"step":2,"action":"Train team","command":"# review SRE Book Ch.15","validation":"culture shift","rollback":null,"source_id":"sre-postmortem-culture"}],"confidence":0.75,"last_verified":"2026-05-03","source_ids":["sre-postmortem-culture"]},
  {"id":"methodology.fm.no-incident-commander","symptom":"During incident, no clear lead; multiple people stepping on each other","error_patterns":["chaos in incident","no IC","conflicting commands"],"root_cause_class":"incident-process","affected_concepts":["methodology.incident-commander","methodology.managing-incidents"],"diagnostic_steps":[{"step":1,"action":"Observe team comms","command":"# review chat during incident","expected":"no clear command structure","source_id":"sre-managing-incidents"}],"fix_steps":[{"step":1,"action":"Adopt ICS-style roles","command":"# IC + Ops Lead + Comms Lead + Scribe","validation":"clear chain","rollback":"informal","source_id":"sre-managing-incidents"},{"step":2,"action":"Practice with chaos drills / fire drills","command":"# regular game days","validation":"team familiar with roles","rollback":null,"source_id":"sre-managing-incidents"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["sre-managing-incidents"]},
  {"id":"methodology.fm.bpf-tool-not-found","symptom":"BCC tool (e.g. opensnoop, biolatency) not found","error_patterns":["command not found","bcc-tools missing"],"root_cause_class":"tooling","affected_concepts":["methodology.bcc","methodology.bpftrace"],"diagnostic_steps":[{"step":1,"action":"Check installation","command":"which opensnoop; ls /usr/share/bcc/tools/","expected":"missing","source_id":"iovisor-bcc-readme"}],"fix_steps":[{"step":1,"action":"Install bcc + tools","command":"# Ubuntu: sudo apt install bpfcc-tools linux-headers-$(uname -r)","validation":"opensnoop -h works","rollback":"apt remove","source_id":"iovisor-bcc-readme"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["iovisor-bcc-readme"]},
  {"id":"methodology.fm.flame-graph-flat","symptom":"Flame graph generated but appears flat / shallow","error_patterns":["flame graph flat","no stack info","missing frames"],"root_cause_class":"profiling","affected_concepts":["methodology.flame-graph","linux.debugging.frame-pointer-vs-dwarf"],"diagnostic_steps":[{"step":1,"action":"Check unwinder used","command":"# perf record with --call-graph fp vs dwarf","expected":"fp without -fno-omit-frame-pointer = flat stacks","source_id":"man7-perf-record-1"}],"fix_steps":[{"step":1,"action":"Use DWARF unwinding","command":"perf record -g --call-graph dwarf ...","validation":"deeper stacks","rollback":"--call-graph fp","source_id":"man7-perf-record-1"},{"step":2,"action":"Recompile with frame pointers","command":"# -fno-omit-frame-pointer in CFLAGS","validation":"reliable stacks","rollback":"omit","source_id":"brendangregg-linux-perf"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["brendangregg-linux-perf","man7-perf-record-1"]},
  {"id":"methodology.fm.error-budget-exhausted","symptom":"SLO breach; team must halt feature work","error_patterns":["error budget exhausted","SLO breach","slowdown release"],"root_cause_class":"slo","affected_concepts":["methodology.error-budget","methodology.sli","methodology.slo"],"diagnostic_steps":[{"step":1,"action":"Confirm budget exhaustion","command":"# SLO dashboard","expected":"budget < 0","source_id":"sre-postmortem-culture"}],"fix_steps":[{"step":1,"action":"Stop feature deploys; reliability work only","command":"# enforce policy","validation":"SLO recovers next window","rollback":"resume features","source_id":"sre-postmortem-culture"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["sre-postmortem-culture","sre-monitoring-signals"]},
  {"id":"methodology.fm.tracing-no-signal","symptom":"Distributed trace exists but doesn't pinpoint slow component","error_patterns":["trace no signal","sampling missed","incomplete trace"],"root_cause_class":"tracing","affected_concepts":["methodology.tracing-taxonomy","methodology.otel-concepts"],"diagnostic_steps":[{"step":1,"action":"Check sampling rate","command":"# probably 1% — slow request not captured","expected":"low sampling","source_id":"otel-concepts"}],"fix_steps":[{"step":1,"action":"Tail-based sampling","command":"# OTel Collector tail-sampling: keep slow + errored","validation":"slow traces captured","rollback":"head sampling","source_id":"otel-concepts"},{"step":2,"action":"Add span events","command":"# instrument key sub-operations","validation":"more granularity","rollback":"remove","source_id":"otel-concepts"}],"confidence":0.7,"last_verified":"2026-05-03","source_ids":["otel-concepts"]},
  {"id":"methodology.fm.kprobe-attach-fails","symptom":"bpftrace kprobe attach fails — function not found","error_patterns":["function not found","kprobe attach failed","unknown symbol"],"root_cause_class":"tooling","affected_concepts":["methodology.bpftrace","linux.debugging.kprobes"],"diagnostic_steps":[{"step":1,"action":"List available symbols","command":"sudo bpftrace -l 'kprobe:tcp_*'","expected":"matches","source_id":"bpftrace-language"},{"step":2,"action":"Check kallsyms","command":"sudo grep tcp_send /proc/kallsyms","expected":"symbol exists","source_id":"man7-proc-5"}],"fix_steps":[{"step":1,"action":"Use available symbol","command":"# adjust to actual kernel symbol name","validation":"bpftrace runs","rollback":"restore","source_id":"bpftrace-language"},{"step":2,"action":"For inlined functions","command":"# kfunc:func instead of kprobe:func (BPF type 5.5+)","validation":"attaches","rollback":"kprobe","source_id":"bpftrace-language"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["bpftrace-language"]},
  {"id":"methodology.fm.metric-cardinality-explosion","symptom":"Prometheus storage growing fast; queries timing out","error_patterns":["cardinality explosion","high cardinality","Prometheus OOM"],"root_cause_class":"observability","affected_concepts":["methodology.monitoring"],"diagnostic_steps":[{"step":1,"action":"Top metrics by cardinality","command":"# count by __name__","expected":"top offenders","source_id":"sre-monitoring-signals"}],"fix_steps":[{"step":1,"action":"Drop high-card labels","command":"# in scrape config: metric_relabel_configs to drop label","validation":"cardinality drops","rollback":"restore","source_id":"sre-monitoring-signals"}],"confidence":0.8,"last_verified":"2026-05-03","source_ids":["sre-monitoring-signals"]}
