[
  {"id": "ecs.agent.cfg.env.ecs-cluster", "scope": "ecs-agent-env", "key": "ECS_CLUSTER", "type": "string", "default_value": "default", "description": "Cluster name the agent registers into. Common cause of 'instance not appearing in cluster' = wrong value or unset.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-reserved-ports", "scope": "ecs-agent-env", "key": "ECS_RESERVED_PORTS", "type": "JSON array of int", "default_value": "[22, 2375, 2376, 51678, 51679] (Linux)", "description": "TCP ports excluded from task placement on this instance. Add ports any host-process needs.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-reserved-ports-udp", "scope": "ecs-agent-env", "key": "ECS_RESERVED_PORTS_UDP", "type": "JSON array of int", "default_value": "[]", "description": "UDP ports excluded from task placement.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-engine-auth-type", "scope": "ecs-agent-env", "key": "ECS_ENGINE_AUTH_TYPE", "type": "enum (docker|dockercfg)", "default_value": null, "description": "Format of registry credentials in ECS_ENGINE_AUTH_DATA.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-engine-auth-data", "scope": "ecs-agent-env", "key": "ECS_ENGINE_AUTH_DATA", "type": "JSON", "default_value": null, "description": "Docker registry credentials; format per ECS_ENGINE_AUTH_TYPE. Stored on instance — sensitive; consider per-task repositoryCredentials with Secrets Manager instead.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.aws-default-region", "scope": "ecs-agent-env", "key": "AWS_DEFAULT_REGION", "type": "string (region)", "default_value": "from EC2 IMDS", "description": "AWS region for ECS API calls. Override only if cross-region debugging.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.docker-host", "scope": "ecs-agent-env", "key": "DOCKER_HOST", "type": "URL", "default_value": "unix:///var/run/docker.sock (Linux); npipe:////./pipe/docker_engine (Windows)", "description": "Docker daemon endpoint. Override for non-default Docker socket location.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-loglevel", "scope": "ecs-agent-env", "key": "ECS_LOGLEVEL", "type": "enum (crit|error|warn|info|debug)", "default_value": "info", "description": "Agent log verbosity.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-loglevel-on-instance", "scope": "ecs-agent-env", "key": "ECS_LOGLEVEL_ON_INSTANCE", "type": "enum", "default_value": "depends on ECS_LOG_DRIVER", "description": "Override log level for the on-instance log file separately from logging-driver-collected logs.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-logfile", "scope": "ecs-agent-env", "key": "ECS_LOGFILE", "type": "path", "default_value": "blank", "description": "Where the agent writes its log file. Bind-mounted to /var/log/ecs/ecs-agent.log on Amazon Linux.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-checkpoint", "scope": "ecs-agent-env", "key": "ECS_CHECKPOINT", "type": "bool", "default_value": "true if ECS_DATADIR set", "description": "Persist agent state across restarts. Loss of state forces re-discovery of running tasks.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-datadir", "scope": "ecs-agent-env", "key": "ECS_DATADIR", "type": "path (in agent container)", "default_value": "/data/", "description": "Inside the agent container, where state is persisted. Pair with ECS_HOST_DATA_DIR via bind-mount.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-host-data-dir", "scope": "ecs-agent-env", "key": "ECS_HOST_DATA_DIR", "type": "path (host)", "default_value": "/var/lib/ecs", "description": "Host-side directory bind-mounted into the agent container for state + metadata files.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-updates-enabled", "scope": "ecs-agent-env", "key": "ECS_UPDATES_ENABLED", "type": "bool", "default_value": "false", "description": "Whether to exit-for-update when ECS service requests an agent update. Required for managed agent updates.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-disable-metrics", "scope": "ecs-agent-env", "key": "ECS_DISABLE_METRICS", "type": "bool", "default_value": "false", "description": "Disable per-task metrics gathering. Saves CPU on instances with very high task density.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-poll-metrics", "scope": "ecs-agent-env", "key": "ECS_POLL_METRICS", "type": "bool", "default_value": "false", "description": "Switch from streaming docker stats to polling. Reduces dockerd CPU usage on dense instances.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-polling-metrics-wait-duration", "scope": "ecs-agent-env", "key": "ECS_POLLING_METRICS_WAIT_DURATION", "type": "duration", "default_value": "10s", "description": "Interval for ECS_POLL_METRICS=true. Range 5-20s. Recommended <18s to avoid memory-reservation metric instability.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-reserved-memory", "scope": "ecs-agent-env", "key": "ECS_RESERVED_MEMORY", "type": "int (MiB)", "default_value": "0", "description": "MiB to subtract from the instance's reported memory capacity. Used by scheduler when placing tasks. Doesn't actually reserve.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-available-logging-drivers", "scope": "ecs-agent-env", "key": "ECS_AVAILABLE_LOGGING_DRIVERS", "type": "JSON array", "default_value": "[\"json-file\",\"none\"]", "description": "Docker logging drivers tasks can use. Must include 'awslogs' for CloudWatch Logs integration.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-disable-privileged", "scope": "ecs-agent-env", "key": "ECS_DISABLE_PRIVILEGED", "type": "bool", "default_value": "false", "description": "Forbid task definitions from setting privileged=true. Recommended for multi-tenant clusters.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-selinux-capable", "scope": "ecs-agent-env", "key": "ECS_SELINUX_CAPABLE", "type": "bool", "default_value": "false", "description": "Advertise SELinux support to ECS so task defs can request SELinux opts (Z-mode mounts only).", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-apparmor-capable", "scope": "ecs-agent-env", "key": "ECS_APPARMOR_CAPABLE", "type": "bool", "default_value": "false", "description": "Advertise AppArmor support to ECS so task defs can request AppArmor profiles.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-engine-task-cleanup-wait-duration", "scope": "ecs-agent-env", "key": "ECS_ENGINE_TASK_CLEANUP_WAIT_DURATION", "type": "duration", "default_value": "3h", "description": "How long to keep stopped task containers around (for log + exit-code retrieval) before cleanup.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-engine-task-cleanup-wait-duration-jitter", "scope": "ecs-agent-env", "key": "ECS_ENGINE_TASK_CLEANUP_WAIT_DURATION_JITTER", "type": "duration", "default_value": "blank", "description": "Random jitter added to per-task cleanup wait. Prevents thundering-herd cleanup.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-manifest-pull-timeout", "scope": "ecs-agent-env", "key": "ECS_MANIFEST_PULL_TIMEOUT", "type": "duration", "default_value": "1m", "description": "Timeout for image manifest fetch. Raise on slow networks or large image registries.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-container-stop-timeout", "scope": "ecs-agent-env", "key": "ECS_CONTAINER_STOP_TIMEOUT", "type": "duration", "default_value": "30s", "description": "Instance-scoped default time to wait for SIGTERM-then-SIGKILL on container stop. Per-task override available via stopTimeout in task def.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-container-start-timeout", "scope": "ecs-agent-env", "key": "ECS_CONTAINER_START_TIMEOUT", "type": "duration", "default_value": "3m (Linux); 8m (Windows)", "description": "Timeout for docker-start to complete. Raise for slow-starting containers.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-container-create-timeout", "scope": "ecs-agent-env", "key": "ECS_CONTAINER_CREATE_TIMEOUT", "type": "duration", "default_value": "4m", "description": "Timeout for docker-create. Minimum 1m enforced.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-enable-task-iam-role", "scope": "ecs-agent-env", "key": "ECS_ENABLE_TASK_IAM_ROLE", "type": "bool", "default_value": "false", "description": "Master switch for IAM Roles for Tasks. Must be true for task-IAM credentials endpoint to work.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-enable-task-iam-role-network-host", "scope": "ecs-agent-env", "key": "ECS_ENABLE_TASK_IAM_ROLE_NETWORK_HOST", "type": "bool", "default_value": "false", "description": "Extend task-IAM-role injection to host-network-mode tasks (requires extra iptables setup).", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-disable-image-cleanup", "scope": "ecs-agent-env", "key": "ECS_DISABLE_IMAGE_CLEANUP", "type": "bool", "default_value": "false", "description": "Disable automated image cleanup. Set to true if you want full control over image GC.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-image-cleanup-interval", "scope": "ecs-agent-env", "key": "ECS_IMAGE_CLEANUP_INTERVAL", "type": "duration", "default_value": "30m", "description": "Time between image cleanup cycles. Min 10m enforced.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-image-minimum-cleanup-age", "scope": "ecs-agent-env", "key": "ECS_IMAGE_MINIMUM_CLEANUP_AGE", "type": "duration", "default_value": "1h", "description": "Minimum age (since pull) before an image is eligible for cleanup.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-image-pull-behavior", "scope": "ecs-agent-env", "key": "ECS_IMAGE_PULL_BEHAVIOR", "type": "enum (default|always|once|prefer-cached)", "default_value": "default", "description": "Image-pull policy. 'always' is the secure choice (always pull, fail task on pull failure). 'default' falls back to cache.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-image-pull-inactivity-timeout", "scope": "ecs-agent-env", "key": "ECS_IMAGE_PULL_INACTIVITY_TIMEOUT", "type": "duration", "default_value": "1m (Linux); 3m (Windows)", "description": "After Docker pull completes, wait this long for extraction. Raise for large Windows containers.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-image-pull-timeout", "scope": "ecs-agent-env", "key": "ECS_IMAGE_PULL_TIMEOUT", "type": "duration", "default_value": "2h", "description": "Total docker-pull timeout. Raise for huge images on slow networks.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-instance-attributes", "scope": "ecs-agent-env", "key": "ECS_INSTANCE_ATTRIBUTES", "type": "JSON object", "default_value": "{}", "description": "Custom attributes registered on initial instance registration only. After registration, use PutAttributes API.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-instance-ip-compatibility", "scope": "ecs-agent-env", "key": "ECS_INSTANCE_IP_COMPATIBILITY", "type": "enum (ipv4|ipv6)", "default_value": "auto-detected", "description": "Override instance IP-stack. Set to ipv6 for IPv6-only instances.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-enable-task-eni", "scope": "ecs-agent-env", "key": "ECS_ENABLE_TASK_ENI", "type": "bool", "default_value": "false", "description": "Enable per-task ENI (awsvpc network mode). Must be true for awsvpc-mode tasks to launch.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-enable-high-density-eni", "scope": "ecs-agent-env", "key": "ECS_ENABLE_HIGH_DENSITY_ENI", "type": "bool", "default_value": "true", "description": "ENI trunking — exceed per-instance ENI limit for awsvpc tasks. Requires Nitro instance + IAM perms.", "source_ids": ["ecs-agent-readme", "ecs-agent-proposal-eni"]},
  {"id": "ecs.agent.cfg.env.ecs-cni-plugins-path", "scope": "ecs-agent-env", "key": "ECS_CNI_PLUGINS_PATH", "type": "path", "default_value": "/amazon-ecs-cni-plugins", "description": "Where the ECS CNI binaries live. Override if vendoring custom CNI.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-awsvpc-block-imds", "scope": "ecs-agent-env", "key": "ECS_AWSVPC_BLOCK_IMDS", "type": "bool", "default_value": "false", "description": "Block 169.254.169.254 from awsvpc tasks. Defends against SSRF leaking the instance role. Recommend true for multi-tenant.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-awsvpc-additional-local-routes", "scope": "ecs-agent-env", "key": "ECS_AWSVPC_ADDITIONAL_LOCAL_ROUTES", "type": "JSON array of CIDRs", "default_value": "[]", "description": "In awsvpc mode, route these prefixes via the host bridge instead of the task ENI.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-enable-container-metadata", "scope": "ecs-agent-env", "key": "ECS_ENABLE_CONTAINER_METADATA", "type": "bool", "default_value": "false", "description": "Write per-container metadata file inside each container; path injected as $ECS_CONTAINER_METADATA_FILE. Older alternative to Task Metadata Endpoint.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-enable-task-cpu-mem-limit", "scope": "ecs-agent-env", "key": "ECS_ENABLE_TASK_CPU_MEM_LIMIT", "type": "bool", "default_value": "true (Linux); false (Windows)", "description": "Enforce task-level cpu+memory cgroup. Sum of containers can't exceed task-level cap.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-cgroup-cpu-period", "scope": "ecs-agent-env", "key": "ECS_CGROUP_CPU_PERIOD", "type": "duration (8-100ms)", "default_value": "100ms", "description": "CFS period for task-level CPU bandwidth. Range 8-100ms. Lower = finer scheduling granularity, more overhead.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-task-metadata-rps-limit", "scope": "ecs-agent-env", "key": "ECS_TASK_METADATA_RPS_LIMIT", "type": "comma-separated int", "default_value": "40,60", "description": "Steady-state and burst rate limits (req/sec) for task-metadata + agent-API endpoints. Raise for metadata-heavy workloads.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-enable-spot-instance-draining", "scope": "ecs-agent-env", "key": "ECS_ENABLE_SPOT_INSTANCE_DRAINING", "type": "bool", "default_value": "false", "description": "Auto-DRAIN on Spot interruption notice. STRONGLY recommend true on any Spot-backed cluster.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-log-driver", "scope": "ecs-agent-env", "key": "ECS_LOG_DRIVER", "type": "enum (awslogs|fluentd|gelf|json-file|journald|syslog|splunk)", "default_value": "json-file", "description": "Logging driver for the AGENT container itself (not tasks).", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-log-output-format", "scope": "ecs-agent-env", "key": "ECS_LOG_OUTPUT_FORMAT", "type": "enum (logfmt|json)", "default_value": "logfmt", "description": "Agent log line format. JSON pairs better with structured-log shippers.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-log-rollover-type", "scope": "ecs-agent-env", "key": "ECS_LOG_ROLLOVER_TYPE", "type": "enum (size|hourly)", "default_value": "size", "description": "Log rotation trigger.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-log-max-file-size-mb", "scope": "ecs-agent-env", "key": "ECS_LOG_MAX_FILE_SIZE_MB", "type": "int", "default_value": "5", "description": "Max log file size before rotation (when rollover-type=size).", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-container-instance-tags", "scope": "ecs-agent-env", "key": "ECS_CONTAINER_INSTANCE_TAGS", "type": "JSON object", "default_value": "{}", "description": "Tags applied to the container instance on registration.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-container-instance-propagate-tags-from", "scope": "ecs-agent-env", "key": "ECS_CONTAINER_INSTANCE_PROPAGATE_TAGS_FROM", "type": "enum (none|ec2_instance)", "default_value": "none", "description": "If ec2_instance, propagate EC2 instance tags to the container instance. Requires ec2:DescribeTags IAM perm.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-disable-docker-health-check", "scope": "ecs-agent-env", "key": "ECS_DISABLE_DOCKER_HEALTH_CHECK", "type": "bool", "default_value": "false", "description": "Disable Docker container HEALTHCHECK monitoring by the agent.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-nvidia-runtime", "scope": "ecs-agent-env", "key": "ECS_NVIDIA_RUNTIME", "type": "string", "default_value": "nvidia", "description": "Docker runtime name for NVIDIA GPU passthrough. Linux only.", "source_ids": ["ecs-agent-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-agent-pid-namespace-host", "scope": "ecs-agent-env", "key": "ECS_AGENT_PID_NAMESPACE_HOST", "type": "bool", "default_value": "false", "description": "Run agent container with --pid=host. Required for SELinux-enforcing + Docker SELinux policy. DISABLES Exec/EBS-attach/ServiceConnect/FireLens. Agent ≥1.94.0.", "source_ids": ["ecs-dg-agent-config"]},
  {"id": "ecs.agent.cfg.env.ecs-agent-labels", "scope": "ecs-agent-env", "key": "ECS_AGENT_LABELS", "type": "JSON object", "default_value": null, "description": "Labels added to the agent container itself (visible via docker inspect). Read by ecs-init, not the agent.", "source_ids": ["ecs-init-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-skip-localhost-traffic-filter", "scope": "ecs-init-env", "key": "ECS_SKIP_LOCALHOST_TRAFFIC_FILTER", "type": "bool", "default_value": "false", "description": "Disable ecs-init's iptables rule that drops non-local packets to 127.0.0.0/8. Insecure; for diagnostic use only.", "source_ids": ["ecs-init-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-allow-offhost-introspection-access", "scope": "ecs-init-env", "key": "ECS_ALLOW_OFFHOST_INTROSPECTION_ACCESS", "type": "bool", "default_value": "false", "description": "Disable ecs-init's iptables rule blocking off-host access to introspection port 51678. Insecure; diagnostic only.", "source_ids": ["ecs-init-readme"]},
  {"id": "ecs.agent.cfg.env.ecs-offhost-introspection-interface-name", "scope": "ecs-init-env", "key": "ECS_OFFHOST_INTROSPECTION_INTERFACE_NAME", "type": "string", "default_value": "auto-detected from default route", "description": "Primary interface used for the off-host introspection block rule. Override if auto-detection picks the wrong interface.", "source_ids": ["ecs-init-readme"]}
]
