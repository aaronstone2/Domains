      {"step": 2, "action": "Or use larger instances with higher ENI limits", "command": "Switch to instance type with more ENI slots (e.g., m5.4xlarge has 8 vs m5.large's 3)", "validation": "More tasks fit per instance", "rollback": null, "source_id": "ecs-dg-task-networking"}
