      {"step": 2, "action": "Or migrate to awsvpc mode (task IAM works by default)", "command": "Update networkMode=awsvpc", "validation": "Cleaner — recommended for new workloads", "rollback": null, "source_id": "ecs-dg-task-networking"}
    ],
    "confidence": 0.85,
    "last_verified": "2026-05-03",
