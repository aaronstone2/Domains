  {"id": "ecs.task-defs.cfg.container.linux-parameters.init-process-enabled", "scope": "task-definition.containerDefinitions.linuxParameters", "key": "initProcessEnabled", "type": "bool", "default_value": "false", "description": "Inject tini as PID 1. Reaps zombies; forwards signals. Recommend true for any non-init-aware container.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.linux-parameters.shared-memory-size", "scope": "task-definition.containerDefinitions.linuxParameters", "key": "sharedMemorySize", "type": "int (MiB)", "default_value": null, "description": "/dev/shm size. Forbidden on Fargate.", "source_ids": ["ecs-dg-task-defs-params"]},
