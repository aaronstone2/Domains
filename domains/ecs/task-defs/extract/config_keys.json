  {"id": "ecs.task-defs.cfg.container.ulimits", "scope": "task-definition.containerDefinitions", "key": "ulimits", "type": "array of {name, softLimit, hardLimit}", "default_value": "[]", "description": "Per-container ulimits. Common: nofile (raise to 65535+ for fd-heavy apps), nproc, memlock.", "source_ids": ["ecs-dg-task-defs-params"]},
