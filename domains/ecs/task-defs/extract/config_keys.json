  {"id": "ecs.task-defs.cfg.service.health-check-grace-period-seconds", "scope": "service-definition", "key": "healthCheckGracePeriodSeconds", "type": "int (0-2147483647)", "default_value": "0", "description": "Grace period after task start before unhealthy LB checks count toward task replacement. Critical for slow-starting apps behind a load balancer.", "source_ids": ["ecs-dg-service-defs-params"]}
