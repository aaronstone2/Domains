  {"id": "ecs.task-defs.cfg.container.log-options", "scope": "task-definition.containerDefinitions.logConfiguration", "key": "options", "type": "object", "default_value": "{}", "description": "Driver-specific KV. For awslogs: awslogs-group, awslogs-region, awslogs-stream-prefix, awslogs-create-group, mode (blocking|non-blocking).", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.log-secret-options", "scope": "task-definition.containerDefinitions.logConfiguration", "key": "secretOptions", "type": "array of {name, valueFrom}", "default_value": "[]", "description": "Driver options sourced from Secrets Manager / SSM (e.g., splunk-token).", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.repository-credentials", "scope": "task-definition.containerDefinitions", "key": "repositoryCredentials", "type": "{credentialsParameter}", "default_value": null, "description": "Secrets Manager ARN holding {username, password} for private registry. Per-task alternative to ECS_ENGINE_AUTH_DATA on the agent.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.user", "scope": "task-definition.containerDefinitions", "key": "user", "type": "string (UID[:GID] or name)", "default_value": null, "description": "Run container process as this user. Best practice: non-root (UID > 0).", "source_ids": ["ecs-dg-task-defs-params"]},
