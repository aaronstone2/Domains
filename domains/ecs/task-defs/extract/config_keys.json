  {"id": "ecs.task-defs.cfg.container.firelens-config.type", "scope": "task-definition.containerDefinitions.firelensConfiguration", "key": "type", "type": "enum (fluentbit|fluentd)", "default_value": null, "description": "FireLens log-router engine.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.firelens-config.options", "scope": "task-definition.containerDefinitions.firelensConfiguration", "key": "options", "type": "object", "default_value": "{}", "description": "Common: enable-ecs-log-metadata=true|false, config-file-type=s3|file, config-file-value=<path-or-arn>.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.system-controls", "scope": "task-definition.containerDefinitions", "key": "systemControls", "type": "array of {namespace, value}", "default_value": "[]", "description": "Per-container sysctls. e.g. net.ipv4.tcp_keepalive_time. Restricted set on Fargate.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.dns-servers", "scope": "task-definition.containerDefinitions", "key": "dnsServers", "type": "array of IP", "default_value": null, "description": "Override container /etc/resolv.conf nameservers.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.extra-hosts", "scope": "task-definition.containerDefinitions", "key": "extraHosts", "type": "array of {hostname, ipAddress}", "default_value": null, "description": "Inject /etc/hosts entries. Doesn't apply on Fargate (use service-discovery).", "source_ids": ["ecs-dg-task-defs-params"]},
