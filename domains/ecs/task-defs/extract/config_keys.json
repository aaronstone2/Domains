  {"id": "ecs.task-defs.cfg.container.port-mappings", "scope": "task-definition.containerDefinitions", "key": "portMappings", "type": "array", "default_value": "[]", "description": "Per-container port bindings. Each: containerPort, hostPort (0 = ephemeral on EC2; must = containerPort on awsvpc), protocol (tcp|udp), name (for serviceConnect), appProtocol (http|http2|grpc).", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.mount-points", "scope": "task-definition.containerDefinitions", "key": "mountPoints", "type": "array of {sourceVolume, containerPath, readOnly}", "default_value": "[]", "description": "Bind a task-level volume into a container path.", "source_ids": ["ecs-dg-task-defs-params"]},
