  {"id": "ecs.task-defs.cfg.service.deployment-maximum-percent", "scope": "service-definition.deploymentConfiguration", "key": "maximumPercent", "type": "int (≥100)", "default_value": "200", "description": "% of desiredCount the deployer may run simultaneously. 200% = double-up before scale-down (rolling).", "source_ids": ["ecs-dg-service-defs-params"]},
