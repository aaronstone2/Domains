  {"id": "ecs.task-defs.cfg.container.privileged", "scope": "task-definition.containerDefinitions", "key": "privileged", "type": "bool", "default_value": "false", "description": "Docker --privileged. Forbidden on Fargate. Blocked instance-wide via ECS_DISABLE_PRIVILEGED.", "source_ids": ["ecs-dg-task-defs-params"]},
