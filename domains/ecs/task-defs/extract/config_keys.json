  {"id": "ecs.task-defs.cfg.container.depends-on", "scope": "task-definition.containerDefinitions", "key": "dependsOn", "type": "array of {containerName, condition}", "default_value": "[]", "description": "Conditions: START, COMPLETE, SUCCESS, HEALTHY. Defines startup ordering and lifecycle gates.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.start-timeout", "scope": "task-definition.containerDefinitions", "key": "startTimeout", "type": "int (seconds)", "default_value": "agent ECS_CONTAINER_START_TIMEOUT", "description": "Per-container override of how long to wait for dependsOn conditions to be satisfied.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.stop-timeout", "scope": "task-definition.containerDefinitions", "key": "stopTimeout", "type": "int (seconds)", "default_value": "agent ECS_CONTAINER_STOP_TIMEOUT", "description": "Per-container SIGTERM-to-SIGKILL grace period.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.health-check.command", "scope": "task-definition.containerDefinitions.healthCheck", "key": "command", "type": "array of string", "default_value": null, "description": "First element: 'CMD' (exec form) or 'CMD-SHELL' (shell form). Rest is the command/args.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.health-check.interval", "scope": "task-definition.containerDefinitions.healthCheck", "key": "interval", "type": "int (5-300)", "default_value": "30", "description": "Seconds between health checks.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.health-check.timeout", "scope": "task-definition.containerDefinitions.healthCheck", "key": "timeout", "type": "int (2-60)", "default_value": "5", "description": "Per-check timeout.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.health-check.retries", "scope": "task-definition.containerDefinitions.healthCheck", "key": "retries", "type": "int (1-10)", "default_value": "3", "description": "Consecutive failures before container marked UNHEALTHY.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.health-check.start-period", "scope": "task-definition.containerDefinitions.healthCheck", "key": "startPeriod", "type": "int (0-300)", "default_value": null, "description": "Grace period after container start during which failures don't count toward retries.", "source_ids": ["ecs-dg-task-defs-params"]},
