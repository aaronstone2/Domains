  {"id": "ecs.task-defs.cfg.container.docker-labels", "scope": "task-definition.containerDefinitions", "key": "dockerLabels", "type": "object (string→string)", "default_value": "{}", "description": "Docker labels on the container. Used by log-routing (e.g., FireLens), monitoring tag-extraction.", "source_ids": ["ecs-dg-task-defs-params"]},
