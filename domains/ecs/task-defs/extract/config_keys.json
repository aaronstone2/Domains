  {"id": "ecs.task-defs.cfg.task.memory", "scope": "task-definition", "key": "memory", "type": "string (MiB or 'N GB')", "default_value": null, "description": "Task-level memory. Required on Fargate; combo with cpu must match Fargate matrix.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.task.runtime-platform.os", "scope": "task-definition.runtimePlatform", "key": "operatingSystemFamily", "type": "enum", "default_value": "LINUX", "description": "LINUX | WINDOWS_SERVER_2019_FULL | WINDOWS_SERVER_2019_CORE | WINDOWS_SERVER_2022_FULL | WINDOWS_SERVER_2022_CORE | WINDOWS_SERVER_2025_FULL | WINDOWS_SERVER_2025_CORE.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.task.runtime-platform.cpu", "scope": "task-definition.runtimePlatform", "key": "cpuArchitecture", "type": "enum", "default_value": "X86_64", "description": "X86_64 | ARM64. Linux+ARM64 → Graviton tasks. Service.platformFamily must match.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.task.ephemeral-storage.size-in-gib", "scope": "task-definition.ephemeralStorage", "key": "sizeInGiB", "type": "int (21-200)", "default_value": "20", "description": "Fargate-only. Per-task scratch disk size.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.task.ipc-mode", "scope": "task-definition", "key": "ipcMode", "type": "enum", "default_value": null, "description": "host | task | none. host shares with all containers; task shares within the task; none isolates each container.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.task.pid-mode", "scope": "task-definition", "key": "pidMode", "type": "enum", "default_value": null, "description": "host | task. Containers see host PIDs (host) or sibling-container PIDs (task). Forbidden on Fargate.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.task.placement-constraints", "scope": "task-definition", "key": "placementConstraints", "type": "array of {type, expression}", "default_value": "[]", "description": "EC2 only. memberOf with cluster-query-language expression (e.g., attribute:ecs.instance-type =~ m5.*).", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.task.proxy-configuration", "scope": "task-definition", "key": "proxyConfiguration", "type": "object", "default_value": null, "description": "App Mesh sidecar proxy config: type=APPMESH, containerName, properties (IgnoredUID, ProxyIngressPort, ProxyEgressPort, AppPorts, EgressIgnoredIPs, EgressIgnoredPorts).", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.task.volumes", "scope": "task-definition", "key": "volumes", "type": "array", "default_value": "[]", "description": "Task-level volumes. Each entry: name + (host | dockerVolumeConfiguration | efsVolumeConfiguration | fsxWindowsFileServerVolumeConfiguration | configuredAtLaunch).", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.volume.efs.filesystem-id", "scope": "volume.efsVolumeConfiguration", "key": "fileSystemId", "type": "string", "default_value": null, "description": "EFS filesystem to mount. fs-XXXXXXXX format.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.volume.efs.transit-encryption", "scope": "volume.efsVolumeConfiguration", "key": "transitEncryption", "type": "enum (ENABLED|DISABLED)", "default_value": "DISABLED", "description": "TLS for EFS mount traffic. Recommend ENABLED.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.volume.efs.iam", "scope": "volume.efsVolumeConfiguration", "key": "authorizationConfig.iam", "type": "enum (ENABLED|DISABLED)", "default_value": "DISABLED", "description": "Use task-IAM-role for EFS access (vs filesystem-policy alone).", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.name", "scope": "task-definition.containerDefinitions", "key": "name", "type": "string", "default_value": null, "description": "Per-container identifier within the task. Used in dependsOn, links, mountPoints.sourceContainer references.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.image", "scope": "task-definition.containerDefinitions", "key": "image", "type": "string (Docker image ref)", "default_value": null, "description": "registry/repo:tag or registry/repo@digest. Pull failure = CannotPullContainerError.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.cpu", "scope": "task-definition.containerDefinitions", "key": "cpu", "type": "int (CPU units)", "default_value": "0", "description": "Per-container CPU shares. Sum across containers ≤ task-level cpu (Linux). 0 = unbounded share.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.memory", "scope": "task-definition.containerDefinitions", "key": "memory", "type": "int (MiB)", "default_value": null, "description": "Hard memory limit. Container OOM-killed if exceeded.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.memory-reservation", "scope": "task-definition.containerDefinitions", "key": "memoryReservation", "type": "int (MiB)", "default_value": null, "description": "Soft memory reservation (lower bound). Used by scheduler. memory and memoryReservation can both be set; reservation < memory.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.command", "scope": "task-definition.containerDefinitions", "key": "command", "type": "array of string", "default_value": null, "description": "Overrides Docker CMD. Each element is one argument (no shell).", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.entry-point", "scope": "task-definition.containerDefinitions", "key": "entryPoint", "type": "array of string", "default_value": null, "description": "Overrides Docker ENTRYPOINT. Combined with command for full argv.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.environment", "scope": "task-definition.containerDefinitions", "key": "environment", "type": "array of {name, value}", "default_value": "[]", "description": "Plain-text env vars. Don't put secrets here — use 'secrets' field with Secrets Manager / SSM ARN.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.environment-files", "scope": "task-definition.containerDefinitions", "key": "environmentFiles", "type": "array of {value (S3 ARN), type=s3}", "default_value": "[]", "description": "Env vars sourced from S3 .env file. Loaded at task start.", "source_ids": ["ecs-dg-task-defs-params"]},
  {"id": "ecs.task-defs.cfg.container.secrets", "scope": "task-definition.containerDefinitions", "key": "secrets", "type": "array of {name, valueFrom}", "default_value": "[]", "description": "Env vars sourced from Secrets Manager (full ARN or with json-key suffix) or SSM Parameter Store. Resolved by agent using executionRoleArn perms.", "source_ids": ["ecs-dg-task-defs-params"]},
