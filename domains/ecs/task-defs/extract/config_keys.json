[
  {"id": "ecs.task-defs.cfg.task.family", "scope": "task-definition", "key": "family", "type": "string", "default_value": null, "description": "Logical name of the task definition. Revision numbering is per-family. Required.", "source_ids": ["ecs-dg-task-defs-params"]},
