  {"id": "ecs.task-defs.cfg.task.network-mode", "scope": "task-definition", "key": "networkMode", "type": "enum", "default_value": "bridge (EC2)", "description": "awsvpc | bridge | host | none. Fargate REQUIRES awsvpc.", "source_ids": ["ecs-dg-task-defs-params"]},
