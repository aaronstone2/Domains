[
  {"id":"linux.debugging.cfg.bpf-helper.bpf-map-lookup-elem","scope":"bpf-helper","key":"bpf_map_lookup_elem","type":"BPF helper","default_value":null,"description":"Look up a key in a BPF map; return pointer to value (or NULL). The most-used helper across nearly every BPF program.","source_ids":["man7-bpf-helpers-7"]},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-map-update-elem","scope":"bpf-helper","key":"bpf_map_update_elem","type":"BPF helper","default_value":null,"description":"Insert or update a key/value pair in a BPF map. Flags: BPF_ANY, BPF_NOEXIST, BPF_EXIST."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-map-delete-elem","scope":"bpf-helper","key":"bpf_map_delete_elem","type":"BPF helper","default_value":null,"description":"Delete a key from a BPF map.","source_ids":["man7-bpf-helpers-7"]},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-probe-read","scope":"bpf-helper","key":"bpf_probe_read","type":"BPF helper","default_value":null,"description":"Safely read kernel memory (handles page faults). Used to deref kernel pointers in tracing programs. Modern split: bpf_probe_read_kernel() / bpf_probe_read_user().","source_ids":["man7-bpf-helpers-7"]},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-probe-read-str","scope":"bpf-helper","key":"bpf_probe_read_str","type":"BPF helper","default_value":null,"description":"Safely read a NUL-terminated string from kernel memory (caps at buf size). Used to read filenames in syscall args."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-ktime-get-ns","scope":"bpf-helper","key":"bpf_ktime_get_ns","type":"BPF helper","default_value":null,"description":"Current monotonic time in ns. The cheapest timestamp source in BPF."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-get-current-pid-tgid","scope":"bpf-helper","key":"bpf_get_current_pid_tgid","type":"BPF helper","default_value":null,"description":"Returns u64 = (tgid << 32) | pid. tgid is the user-visible PID; pid is the kernel TID."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-get-current-uid-gid","scope":"bpf-helper","key":"bpf_get_current_uid_gid","type":"BPF helper","default_value":null,"description":"Returns u64 = (gid << 32) | uid of current task."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-get-current-comm","scope":"bpf-helper","key":"bpf_get_current_comm","type":"BPF helper","default_value":null,"description":"Get the comm (16-char process name) of current task."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-get-current-task","scope":"bpf-helper","key":"bpf_get_current_task","type":"BPF helper","default_value":null,"description":"Pointer to current task_struct. Combined with bpf_probe_read for accessing task fields safely."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-get-stackid","scope":"bpf-helper","key":"bpf_get_stackid","type":"BPF helper","default_value":null,"description":"Sample current call stack into BPF_MAP_TYPE_STACK_TRACE; returns key. The stack-trace primitive for flame graphs."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-get-stack","scope":"bpf-helper","key":"bpf_get_stack","type":"BPF helper","default_value":null,"description":"Newer stack getter — returns into caller-supplied buffer (vs map). Allows variable-depth and userspace stacks."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-perf-event-output","scope":"bpf-helper","key":"bpf_perf_event_output","type":"BPF helper","default_value":null,"description":"Push a record to a BPF_MAP_TYPE_PERF_EVENT_ARRAY (per-CPU ring buffer, consumed by userspace via perf_event ring)."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-ringbuf-output","scope":"bpf-helper","key":"bpf_ringbuf_output","type":"BPF helper","default_value":null,"description":"5.8+ — push a record to BPF_MAP_TYPE_RINGBUF (single MPMC ring shared across CPUs)."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-ringbuf-reserve","scope":"bpf-helper","key":"bpf_ringbuf_reserve","type":"BPF helper","default_value":null,"description":"Reserve N bytes in ring buffer; returns pointer to write into."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-ringbuf-submit","scope":"bpf-helper","key":"bpf_ringbuf_submit","type":"BPF helper","default_value":null,"description":"Commit a previously-reserved ringbuf write."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-trace-printk","scope":"bpf-helper","key":"bpf_trace_printk","type":"BPF helper","default_value":null,"description":"Debug printf to /sys/kernel/debug/tracing/trace_pipe. Limited (1 string + 3 args). For real output, use perf_event_output or ringbuf."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-tail-call","scope":"bpf-helper","key":"bpf_tail_call","type":"BPF helper","default_value":null,"description":"Jump to another BPF program (in BPF_MAP_TYPE_PROG_ARRAY). Doesn't return — used to chain programs and bypass the 1M-instruction verifier limit."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-spin-lock","scope":"bpf-helper","key":"bpf_spin_lock","type":"BPF helper","default_value":null,"description":"Take a spinlock embedded in a map value. Pairs with bpf_spin_unlock. Race-free updates."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-skb-load-bytes","scope":"bpf-helper","key":"bpf_skb_load_bytes","type":"BPF helper","default_value":null,"description":"Read bytes from skb (network packet) into BPF stack. The packet-inspection primitive for tc/socket-filter programs."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-redirect","scope":"bpf-helper","key":"bpf_redirect","type":"BPF helper","default_value":null,"description":"Redirect skb to specified ifindex. Used by XDP for fast in-kernel packet steering."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-override-return","scope":"bpf-helper","key":"bpf_override_return","type":"BPF helper","default_value":null,"description":"Override return value of a kprobed function. Requires CONFIG_BPF_KPROBE_OVERRIDE + ALLOW_ERROR_INJECTION. Used for fault injection."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-send-signal","scope":"bpf-helper","key":"bpf_send_signal","type":"BPF helper","default_value":null,"description":"Send signal to current task from BPF. Useful for killing processes that hit a tracing condition."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-get-ns-current-pid-tgid","scope":"bpf-helper","key":"bpf_get_ns_current_pid_tgid","type":"BPF helper","default_value":null,"description":"PID/TGID in a specific PID namespace. Critical for container-aware tracing — the host PID and container PID differ."},
  {"id":"linux.debugging.cfg.bpf-helper.bpf-get-current-cgroup-id","scope":"bpf-helper","key":"bpf_get_current_cgroup_id","type":"BPF helper","default_value":null,"description":"Cgroup ID of current task. Useful for filtering tracing to specific containers."},
  {"id":"linux.debugging.cfg.bpf-cmd-type.prog-load","scope":"bpf-cmd-type","key":"BPF_PROG_LOAD","type":"bpf(2) cmd","default_value":null,"description":"Verify and load a BPF program into the kernel. Returns FD to the program."},
  {"id":"linux.debugging.cfg.bpf-cmd-type.map-create","scope":"bpf-cmd-type","key":"BPF_MAP_CREATE","type":"bpf(2) cmd","default_value":null,"description":"Create a BPF map. Returns FD."},
  {"id":"linux.debugging.cfg.bpf-cmd-type.prog-attach","scope":"bpf-cmd-type","key":"BPF_PROG_ATTACH","type":"bpf(2) cmd","default_value":null,"description":"Attach a loaded program to a hook (cgroup, sockmap, sk_skb, lirc, etc.). Modern alternative: BPF_LINK_CREATE."},
  {"id":"linux.debugging.cfg.bpf-cmd-type.prog-detach","scope":"bpf-cmd-type","key":"BPF_PROG_DETACH","type":"bpf(2) cmd","default_value":null,"description":"Detach previously-attached program."},
  {"id":"linux.debugging.cfg.bpf-cmd-type.prog-test-run","scope":"bpf-cmd-type","key":"BPF_PROG_TEST_RUN","type":"bpf(2) cmd","default_value":null,"description":"Run a program in user-supplied input context for testing. Returns output + retval + duration."},
  {"id":"linux.debugging.cfg.bpf-cmd-type.link-create","scope":"bpf-cmd-type","key":"BPF_LINK_CREATE","type":"bpf(2) cmd","default_value":null,"description":"5.7+ replacement for PROG_ATTACH. Returns a link FD; closing FD detaches. Cleaner lifetime semantics."},
  {"id":"linux.debugging.cfg.bpf-cmd-type.obj-pin","scope":"bpf-cmd-type","key":"BPF_OBJ_PIN","type":"bpf(2) cmd","default_value":null,"description":"Pin a BPF object (program/map/link) to a path on bpffs (/sys/fs/bpf/...). Survives the loading process exit."},
  {"id":"linux.debugging.cfg.bpf-cmd-type.btf-load","scope":"bpf-cmd-type","key":"BPF_BTF_LOAD","type":"bpf(2) cmd","default_value":null,"description":"Load BTF (BPF Type Format) — type info for CO-RE (Compile Once Run Everywhere) relocation."},
  {"id":"linux.debugging.cfg.ftrace-tracer.function","scope":"ftrace-tracer","key":"function","type":"ftrace plugin tracer","default_value":null,"description":"Trace every kernel function call. High overhead but complete. Filtered via set_ftrace_filter."},
  {"id":"linux.debugging.cfg.ftrace-tracer.function-graph","scope":"ftrace-tracer","key":"function_graph","type":"ftrace plugin tracer","default_value":null,"description":"Function entry+exit with timing per call. Renders as call tree. Slower than function but more useful for latency."},
  {"id":"linux.debugging.cfg.ftrace-tracer.nop","scope":"ftrace-tracer","key":"nop","type":"ftrace plugin tracer","default_value":null,"description":"Default: no tracing. Tracepoint events still active if enabled separately."},
  {"id":"linux.debugging.cfg.ftrace-tracer.irqsoff","scope":"ftrace-tracer","key":"irqsoff","type":"ftrace plugin tracer","default_value":null,"description":"Track longest IRQ-disabled duration. For latency-sensitive workloads."},
  {"id":"linux.debugging.cfg.ftrace-tracer.preemptoff","scope":"ftrace-tracer","key":"preemptoff","type":"ftrace plugin tracer","default_value":null,"description":"Track longest preemption-disabled duration."},
  {"id":"linux.debugging.cfg.ftrace-tracer.preemptirqsoff","scope":"ftrace-tracer","key":"preemptirqsoff","type":"ftrace plugin tracer","default_value":null,"description":"Combined: longest period where either preempt OR IRQs disabled."},
  {"id":"linux.debugging.cfg.ftrace-tracer.wakeup","scope":"ftrace-tracer","key":"wakeup","type":"ftrace plugin tracer","default_value":null,"description":"Track longest scheduling latency from wake to run."},
  {"id":"linux.debugging.cfg.ftrace-tracer.wakeup-rt","scope":"ftrace-tracer","key":"wakeup_rt","type":"ftrace plugin tracer","default_value":null,"description":"Wakeup tracer for RT-priority tasks only."},
  {"id":"linux.debugging.cfg.ftrace-tracer.blk","scope":"ftrace-tracer","key":"blk","type":"ftrace plugin tracer","default_value":null,"description":"Block-layer events (used by blktrace)."},
  {"id":"linux.debugging.cfg.ftrace-control-file.tracing-on","scope":"ftrace-control-file","key":"tracing_on","type":"0|1","default_value":"1","description":"Master enable. 1 = capture to ring buffer; 0 = pause."},
  {"id":"linux.debugging.cfg.ftrace-control-file.current-tracer","scope":"ftrace-control-file","key":"current_tracer","type":"string","default_value":"nop","description":"Active plugin tracer name."},
  {"id":"linux.debugging.cfg.ftrace-control-file.set-ftrace-filter","scope":"ftrace-control-file","key":"set_ftrace_filter","type":"function name(s)","default_value":null,"description":"Restrict function tracer to listed kernel functions. Glob supported."},
  {"id":"linux.debugging.cfg.ftrace-control-file.set-ftrace-notrace","scope":"ftrace-control-file","key":"set_ftrace_notrace","type":"function name(s)","default_value":null,"description":"Exclude listed functions."},
  {"id":"linux.debugging.cfg.ftrace-control-file.trace","scope":"ftrace-control-file","key":"trace","type":"text","default_value":null,"description":"Read = formatted trace output. Write empty = clear ring buffer."},
  {"id":"linux.debugging.cfg.ftrace-control-file.trace-pipe","scope":"ftrace-control-file","key":"trace_pipe","type":"text stream","default_value":null,"description":"Like trace but consumes events as they're read (vs trace which is non-destructive)."},
  {"id":"linux.debugging.cfg.ftrace-control-file.buffer-size-kb","scope":"ftrace-control-file","key":"buffer_size_kb","type":"int","default_value":"1408","description":"Per-CPU ring buffer size."},
  {"id":"linux.debugging.cfg.ftrace-control-file.set-event","scope":"ftrace-control-file","key":"set_event","type":"event name(s)","default_value":null,"description":"List of enabled tracepoint events."},
  {"id":"linux.debugging.cfg.ftrace-control-file.events-enable","scope":"ftrace-control-file","key":"events/<sys>/<event>/enable","type":"0|1","default_value":"0","description":"Per-event enable file. e.g. echo 1 > events/sched/sched_switch/enable."},
  {"id":"linux.debugging.cfg.ftrace-control-file.set-pid","scope":"ftrace-control-file","key":"set_event_pid","type":"pid list","default_value":null,"description":"Filter trace to specific PIDs."},
  {"id":"linux.debugging.cfg.ftrace-control-file.kprobe-events","scope":"ftrace-control-file","key":"kprobe_events","type":"text","default_value":null,"description":"Add kprobes via sysfs. e.g. `echo 'p:my_probe vfs_read file=+0(%si)' > kprobe_events`."},
  {"id":"linux.debugging.cfg.ftrace-control-file.uprobe-events","scope":"ftrace-control-file","key":"uprobe_events","type":"text","default_value":null,"description":"Add uprobes. e.g. `echo 'p:my_uprobe /usr/bin/myapp:0x1234' > uprobe_events`."},
  {"id":"linux.debugging.cfg.ftrace-control-file.tracing-thresh","scope":"ftrace-control-file","key":"tracing_thresh","type":"int microseconds","default_value":"0","description":"Latency-tracer threshold — only record events exceeding."},
  {"id":"linux.debugging.cfg.ftrace-control-file.snapshot","scope":"ftrace-control-file","key":"snapshot","type":"text","default_value":null,"description":"Read = current snapshot. Write '0' = clear; '1' = swap snapshot↔active buffer."},
  {"id":"linux.debugging.cfg.trace-event-class.sched","scope":"trace-event-class","key":"sched","type":"tracepoint family","default_value":null,"description":"Scheduler events: sched_switch, sched_wakeup, sched_wakeup_new, sched_migrate_task, sched_process_fork, sched_process_exec, sched_process_exit, sched_stat_runtime, sched_stat_iowait, sched_stat_sleep."},
  {"id":"linux.debugging.cfg.trace-event-class.syscalls","scope":"trace-event-class","key":"syscalls","type":"tracepoint family","default_value":null,"description":"sys_enter_<name> / sys_exit_<name> for every syscall. Generated by kernel build."},
  {"id":"linux.debugging.cfg.trace-event-class.irq","scope":"trace-event-class","key":"irq","type":"tracepoint family","default_value":null,"description":"IRQ entry/exit, softirq entry/exit, tasklet entry/exit."},
  {"id":"linux.debugging.cfg.trace-event-class.mm","scope":"trace-event-class","key":"mm","type":"tracepoint family","default_value":null,"description":"Memory: page_alloc, page_free, page_reclaim, kmem_cache_alloc, mm_filemap_*, oom_kill_process."},
  {"id":"linux.debugging.cfg.trace-event-class.block","scope":"trace-event-class","key":"block","type":"tracepoint family","default_value":null,"description":"Block layer: block_rq_issue, block_rq_complete, block_rq_insert, block_bio_queue."},
  {"id":"linux.debugging.cfg.trace-event-class.fs","scope":"trace-event-class","key":"fs","type":"tracepoint family","default_value":null,"description":"File system events: do_sys_open, vfs_*, ext4_*, xfs_*, btrfs_*."},
  {"id":"linux.debugging.cfg.trace-event-class.net","scope":"trace-event-class","key":"net","type":"tracepoint family","default_value":null,"description":"Network: net_dev_xmit, netif_receive_skb."},
  {"id":"linux.debugging.cfg.trace-event-class.tcp","scope":"trace-event-class","key":"tcp","type":"tracepoint family","default_value":null,"description":"TCP events: tcp_send_reset, tcp_retransmit_skb, tcp_destroy_sock, tcp_probe."},
  {"id":"linux.debugging.cfg.trace-event-class.workqueue","scope":"trace-event-class","key":"workqueue","type":"tracepoint family","default_value":null,"description":"workqueue_queue_work, workqueue_execute_start, workqueue_execute_end."},
  {"id":"linux.debugging.cfg.trace-event-class.signal","scope":"trace-event-class","key":"signal","type":"tracepoint family","default_value":null,"description":"signal_generate, signal_deliver."},
  {"id":"linux.debugging.cfg.trace-event-class.cgroup","scope":"trace-event-class","key":"cgroup","type":"tracepoint family","default_value":null,"description":"cgroup_attach_task, cgroup_release."},
  {"id":"linux.debugging.cfg.trace-event-class.exceptions","scope":"trace-event-class","key":"exceptions","type":"tracepoint family","default_value":null,"description":"page_fault_user, page_fault_kernel."},
  {"id":"linux.debugging.cfg.trace-event-class.kvm","scope":"trace-event-class","key":"kvm","type":"tracepoint family","default_value":null,"description":"VMexit reasons, instruction emulation, irq injection (KVM hypervisor events)."},
  {"id":"linux.debugging.cfg.kprobe-syntax.entry-probe","scope":"kprobe-syntax","key":"p:NAME FUNC","type":"kprobe entry probe","default_value":null,"description":"Kernel function entry probe. e.g. `p:open_probe vfs_open`."},
  {"id":"linux.debugging.cfg.kprobe-syntax.return-probe","scope":"kprobe-syntax","key":"r:NAME FUNC","type":"kprobe return probe (kretprobe)","default_value":null,"description":"Function return probe. Captures return value via $retval."},
  {"id":"linux.debugging.cfg.kprobe-syntax.offset","scope":"kprobe-syntax","key":"FUNC+OFFSET","type":"kprobe offset","default_value":null,"description":"Probe at OFFSET bytes into FUNC (avoid by default; relies on instruction boundary)."},
  {"id":"linux.debugging.cfg.kprobe-syntax.arg-fetch","scope":"kprobe-syntax","key":"%REG / +OFFSET($REG)","type":"kprobe arg fetch","default_value":null,"description":"Read register or memory: e.g. %ax (arg in rax), +0(%si) (deref rsi)."},
  {"id":"linux.debugging.cfg.kprobe-syntax.type-suffix","scope":"kprobe-syntax","key":":TYPE","type":"kprobe type cast","default_value":null,"description":"Type for fetched value: u8/u16/u32/u64/s8/s16/s32/s64/string/x8/x16/x32/x64."},
  {"id":"linux.debugging.cfg.uprobe-syntax.user-binary","scope":"uprobe-syntax","key":"BINARY:OFFSET or BINARY:SYMBOL","type":"uprobe location","default_value":null,"description":"User-space probe location. Symbol resolved via the binary's symtab."},
  {"id":"linux.debugging.cfg.uprobe-syntax.entry","scope":"uprobe-syntax","key":"p:NAME BINARY:SYMBOL","type":"uprobe entry","default_value":null,"description":"User function entry."},
  {"id":"linux.debugging.cfg.uprobe-syntax.return","scope":"uprobe-syntax","key":"r:NAME BINARY:SYMBOL","type":"uretprobe","default_value":null,"description":"User function return."},
  {"id":"linux.debugging.cfg.uprobe-syntax.usdt","scope":"uprobe-syntax","key":"BINARY:PROVIDER:PROBE","type":"USDT probe","default_value":null,"description":"User-statically-defined-tracing probe (DTrace-style). Embedded in many language runtimes."},
  {"id":"linux.debugging.cfg.kdump-config.kdump-bootdir","scope":"kdump-config","key":"KDUMP_BOOTDIR","type":"path","default_value":"/boot","description":"Where to find capture kernel + initramfs (kdump-tools config)."},
  {"id":"linux.debugging.cfg.kdump-config.kdump-kernelver","scope":"kdump-config","key":"KDUMP_KERNELVER","type":"string","default_value":"$(uname -r)","description":"Capture kernel version."},
  {"id":"linux.debugging.cfg.kdump-config.kdump-cmdline","scope":"kdump-config","key":"KDUMP_CMDLINE","type":"string","default_value":"<reuse current>","description":"Boot params for capture kernel."},
  {"id":"linux.debugging.cfg.kdump-config.kdump-cmdline-append","scope":"kdump-config","key":"KDUMP_CMDLINE_APPEND","type":"string","default_value":"irqpoll maxcpus=1 nr_cpus=1 reset_devices","description":"Additional capture-kernel boot params (the typical hardening for capture context)."},
  {"id":"linux.debugging.cfg.kdump-config.kdump-coredir","scope":"kdump-config","key":"KDUMP_COREDIR","type":"path","default_value":"/var/crash","description":"Where vmcore goes."},
  {"id":"linux.debugging.cfg.kdump-config.kdump-makedumpfile-args","scope":"kdump-config","key":"MAKEDUMPFILE_ARGS","type":"string","default_value":"-c -d 31","description":"makedumpfile invocation in capture kernel."},
  {"id":"linux.debugging.cfg.kdump-config.kdump-num-dumps","scope":"kdump-config","key":"KDUMP_NUM_DUMPS","type":"int","default_value":"0 (unlimited)","description":"Max number of saved vmcores before old ones are deleted."},
  {"id":"linux.debugging.cfg.kdump-config.crashkernel","scope":"kdump-config","key":"crashkernel=","type":"size[@offset]","default_value":null,"description":"Reserved memory for capture kernel — set on host kernel cmdline. Common: 256M-1G."},
  {"id":"linux.debugging.cfg.gdb-command.run","scope":"gdb-command","key":"run / r","type":"gdb command","default_value":null,"description":"Start the program. Arguments after `run` are passed to the program."},
  {"id":"linux.debugging.cfg.gdb-command.continue","scope":"gdb-command","key":"continue / c","type":"gdb command","default_value":null,"description":"Continue execution after a breakpoint."},
  {"id":"linux.debugging.cfg.gdb-command.break","scope":"gdb-command","key":"break / b","type":"gdb command","default_value":null,"description":"Set breakpoint at function name, file:line, or address. e.g. `b main`, `b file.c:42`, `b *0x400500`."},
  {"id":"linux.debugging.cfg.gdb-command.tbreak","scope":"gdb-command","key":"tbreak","type":"gdb command","default_value":null,"description":"Temporary breakpoint (auto-deleted after first hit)."},
  {"id":"linux.debugging.cfg.gdb-command.watch","scope":"gdb-command","key":"watch / rwatch / awatch","type":"gdb command","default_value":null,"description":"Watchpoint on memory: write / read / either. Hardware watchpoints if available."},
  {"id":"linux.debugging.cfg.gdb-command.print","scope":"gdb-command","key":"print / p","type":"gdb command","default_value":null,"description":"Evaluate expression. e.g. `p variable`, `p *ptr`, `p func(args)` (calls function)."},
  {"id":"linux.debugging.cfg.gdb-command.backtrace","scope":"gdb-command","key":"backtrace / bt","type":"gdb command","default_value":null,"description":"Stack trace. `bt full` includes locals; `bt N` limits depth."},
  {"id":"linux.debugging.cfg.gdb-command.frame","scope":"gdb-command","key":"frame / f","type":"gdb command","default_value":null,"description":"Switch to frame N (in stack)."},
  {"id":"linux.debugging.cfg.gdb-command.up-down","scope":"gdb-command","key":"up / down","type":"gdb command","default_value":null,"description":"Move up/down call stack one frame."},
  {"id":"linux.debugging.cfg.gdb-command.step","scope":"gdb-command","key":"step / s","type":"gdb command","default_value":null,"description":"Step into function. Stops at first source line of called function."},
  {"id":"linux.debugging.cfg.gdb-command.next","scope":"gdb-command","key":"next / n","type":"gdb command","default_value":null,"description":"Step over function (don't step in)."},
  {"id":"linux.debugging.cfg.gdb-command.finish","scope":"gdb-command","key":"finish","type":"gdb command","default_value":null,"description":"Run until current function returns, then stop."},
  {"id":"linux.debugging.cfg.gdb-command.list","scope":"gdb-command","key":"list / l","type":"gdb command","default_value":null,"description":"Show source around current line."},
  {"id":"linux.debugging.cfg.gdb-command.disassemble","scope":"gdb-command","key":"disassemble / disas","type":"gdb command","default_value":null,"description":"Show machine code. `disas /m` includes source."},
  {"id":"linux.debugging.cfg.gdb-command.info-threads","scope":"gdb-command","key":"info threads","type":"gdb command","default_value":null,"description":"List all threads."},
  {"id":"linux.debugging.cfg.gdb-command.thread","scope":"gdb-command","key":"thread N","type":"gdb command","default_value":null,"description":"Switch to thread N."},
  {"id":"linux.debugging.cfg.gdb-command.thread-apply","scope":"gdb-command","key":"thread apply all CMD","type":"gdb command","default_value":null,"description":"Run CMD on every thread. e.g. `thread apply all bt` for backtrace of every thread."},
  {"id":"linux.debugging.cfg.gdb-command.info-registers","scope":"gdb-command","key":"info registers","type":"gdb command","default_value":null,"description":"Print CPU register values."},
  {"id":"linux.debugging.cfg.gdb-command.x","scope":"gdb-command","key":"x/FMT ADDR","type":"gdb command","default_value":null,"description":"Examine memory. FMT = count + size + format. e.g. `x/16xw $rsp` = 16 hex words at rsp."},
  {"id":"linux.debugging.cfg.gdb-command.set-var","scope":"gdb-command","key":"set var = value","type":"gdb command","default_value":null,"description":"Modify variable. e.g. `set var i = 42`."},
  {"id":"linux.debugging.cfg.gdb-command.return","scope":"gdb-command","key":"return [VALUE]","type":"gdb command","default_value":null,"description":"Force current function to return immediately (with optional value). Skips remaining code."},
  {"id":"linux.debugging.cfg.gdb-command.attach","scope":"gdb-command","key":"attach PID","type":"gdb command","default_value":null,"description":"Attach to running PID."},
  {"id":"linux.debugging.cfg.gdb-command.detach","scope":"gdb-command","key":"detach","type":"gdb command","default_value":null,"description":"Detach from process. Tracee continues normally."},
  {"id":"linux.debugging.cfg.gdb-command.info-sharedlibrary","scope":"gdb-command","key":"info sharedlibrary / info shared","type":"gdb command","default_value":null,"description":"List loaded shared libraries with addresses."},
  {"id":"linux.debugging.cfg.gdb-command.symbol-file","scope":"gdb-command","key":"symbol-file FILE","type":"gdb command","default_value":null,"description":"Load symbols from FILE. Useful when separate-debug-info file isn't auto-found."},
  {"id":"linux.debugging.cfg.gdb-command.handle","scope":"gdb-command","key":"handle SIGNAL OPTIONS","type":"gdb command","default_value":null,"description":"How to handle a signal: nostop/stop, noprint/print, nopass/pass."},
  {"id":"linux.debugging.cfg.audit-rule-key.always-exit","scope":"audit-rule-key","key":"-a always,exit","type":"audit rule action","default_value":null,"description":"Generate record on every syscall exit matching filter."},
  {"id":"linux.debugging.cfg.audit-rule-key.never","scope":"audit-rule-key","key":"-a never,...","type":"audit rule action","default_value":null,"description":"Suppress audit for matching events."},
  {"id":"linux.debugging.cfg.audit-rule-key.field-arch","scope":"audit-rule-key","key":"-F arch=b64|b32","type":"audit field filter","default_value":null,"description":"Architecture (always specify on multilib hosts to catch both 32+64 syscalls)."},
  {"id":"linux.debugging.cfg.audit-rule-key.field-syscall","scope":"audit-rule-key","key":"-S SYSCALL[,SYSCALL...]","type":"audit field filter","default_value":null,"description":"Syscall name(s)."},
  {"id":"linux.debugging.cfg.audit-rule-key.field-uid","scope":"audit-rule-key","key":"-F uid=N","type":"audit field filter","default_value":null,"description":"Effective UID match."},
  {"id":"linux.debugging.cfg.audit-rule-key.field-auid","scope":"audit-rule-key","key":"-F auid=N","type":"audit field filter","default_value":null,"description":"Login UID (audit UID — invariant across su/sudo)."},
  {"id":"linux.debugging.cfg.audit-rule-key.field-success","scope":"audit-rule-key","key":"-F success=0|1","type":"audit field filter","default_value":null,"description":"Match only success or failure outcomes."},
  {"id":"linux.debugging.cfg.audit-rule-key.field-path","scope":"audit-rule-key","key":"-F path=PATH","type":"audit field filter","default_value":null,"description":"Specific path."},
  {"id":"linux.debugging.cfg.audit-rule-key.key","scope":"audit-rule-key","key":"-k KEY","type":"audit rule tag","default_value":null,"description":"Tag for ausearch -k. e.g. -k 'sensitive_files'."},
  {"id":"linux.debugging.cfg.audit-rule-key.watch","scope":"audit-rule-key","key":"-w PATH","type":"file watch","default_value":null,"description":"Watch a file/dir for access."},
  {"id":"linux.debugging.cfg.audit-rule-key.watch-perms","scope":"audit-rule-key","key":"-p r|w|x|a","type":"watch perm filter","default_value":null,"description":"Permissions to watch: read/write/execute/attribute."},
  {"id":"linux.debugging.cfg.perf-event.cycles","scope":"perf-event","key":"cycles","type":"hardware counter","default_value":null,"description":"CPU clock cycles. Default sampling event for perf record."},
  {"id":"linux.debugging.cfg.perf-event.instructions","scope":"perf-event","key":"instructions","type":"hardware counter","default_value":null,"description":"Retired instructions. cycles/instructions = CPI (cycles per instruction); >1 = stall-heavy."},
  {"id":"linux.debugging.cfg.perf-event.cache-references","scope":"perf-event","key":"cache-references","type":"hardware counter","default_value":null,"description":"Last-level cache accesses."},
  {"id":"linux.debugging.cfg.perf-event.cache-misses","scope":"perf-event","key":"cache-misses","type":"hardware counter","default_value":null,"description":"Last-level cache misses. cache-misses/references = miss rate."},
  {"id":"linux.debugging.cfg.perf-event.branch-instructions","scope":"perf-event","key":"branch-instructions","type":"hardware counter","default_value":null,"description":"Retired branches."},
  {"id":"linux.debugging.cfg.perf-event.branch-misses","scope":"perf-event","key":"branch-misses","type":"hardware counter","default_value":null,"description":"Mispredicted branches. >1% = predictor unhappy."},
  {"id":"linux.debugging.cfg.perf-event.bus-cycles","scope":"perf-event","key":"bus-cycles","type":"hardware counter","default_value":null,"description":"Bus cycles (memory subsystem)."},
  {"id":"linux.debugging.cfg.perf-event.stalled-cycles-frontend","scope":"perf-event","key":"stalled-cycles-frontend","type":"hardware counter","default_value":null,"description":"Cycles where frontend stalled (instruction fetch/decode)."},
  {"id":"linux.debugging.cfg.perf-event.stalled-cycles-backend","scope":"perf-event","key":"stalled-cycles-backend","type":"hardware counter","default_value":null,"description":"Cycles where backend stalled (execution, memory)."},
  {"id":"linux.debugging.cfg.perf-event.task-clock","scope":"perf-event","key":"task-clock","type":"software counter","default_value":null,"description":"Time on CPU. Useful baseline for any sampled run."},
  {"id":"linux.debugging.cfg.perf-event.cpu-clock","scope":"perf-event","key":"cpu-clock","type":"software counter","default_value":null,"description":"CPU clock (different from task-clock — counts even when not on CPU if sampled)."},
  {"id":"linux.debugging.cfg.perf-event.context-switches","scope":"perf-event","key":"context-switches","type":"software counter","default_value":null,"description":"cs counter."},
  {"id":"linux.debugging.cfg.perf-event.cpu-migrations","scope":"perf-event","key":"cpu-migrations","type":"software counter","default_value":null,"description":"Times task moved between CPUs (signal of poor affinity / NUMA crossings)."},
  {"id":"linux.debugging.cfg.perf-event.page-faults","scope":"perf-event","key":"page-faults","type":"software counter","default_value":null,"description":"Page faults total. -e page-faults:u (user) / :k (kernel)."},
  {"id":"linux.debugging.cfg.perf-event.minor-faults","scope":"perf-event","key":"minor-faults","type":"software counter","default_value":null,"description":"Page faults satisfiable without disk IO."},
  {"id":"linux.debugging.cfg.perf-event.major-faults","scope":"perf-event","key":"major-faults","type":"software counter","default_value":null,"description":"Page faults requiring disk IO. High = thrashing or swap activity."},
  {"id":"linux.debugging.cfg.perf-event.alignment-faults","scope":"perf-event","key":"alignment-faults","type":"software counter","default_value":null,"description":"Misaligned memory access (kernel may emulate)."},
  {"id":"linux.debugging.cfg.perf-event.emulation-faults","scope":"perf-event","key":"emulation-faults","type":"software counter","default_value":null,"description":"Floating-point or instruction emulation."},
  {"id":"linux.debugging.cfg.perf-event.dTLB-load-misses","scope":"perf-event","key":"dTLB-load-misses","type":"hardware counter","default_value":null,"description":"Data TLB load misses. Indicator of working-set spilling TLB capacity."},
  {"id":"linux.debugging.cfg.perf-event.iTLB-load-misses","scope":"perf-event","key":"iTLB-load-misses","type":"hardware counter","default_value":null,"description":"Instruction TLB load misses."},
  {"id":"linux.debugging.cfg.perf-event.cgroup-event","scope":"perf-event","key":"cgroup-switches","type":"software counter","default_value":null,"description":"Per-cgroup context switch counter."}
]
