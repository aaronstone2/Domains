[
  {"id":"linux.fm.numa-imbalance","symptom":"Multi-socket box: one NUMA node CPUs at 90%, other idle; throughput limited","error_patterns":["NUMA","numa_miss","numastat","imbalance"],"root_cause_class":"numa","affected_concepts":["linux.debugging.numastat-tool","linux.primitives.sched-setaffinity"],"diagnostic_steps":[{"step":1,"action":"Per-node CPU + memory","command":"numastat -m; numactl --hardware","expected":"node-skewed memory/CPU","source_id":"man7-numastat-8"},{"step":2,"action":"Show per-pid NUMA stats","command":"sudo numastat -p <pid>","expected":"high numa_miss","source_id":"man7-numastat-8"}],"fix_steps":[{"step":1,"action":"Pin app to one node","command":"numactl --cpunodebind=0 --membind=0 ./myapp","validation":"local-only memory","rollback":"omit numactl","source_id":"man7-numastat-8"},{"step":2,"action":"Or enable autonuma if disabled","command":"sudo sysctl kernel.numa_balancing=1","validation":"=1","rollback":"=0","source_id":"kernel-docs-kernel-parameters"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["man7-numastat-8","kernel-docs-kernel-parameters"]},
  {"id":"linux.fm.irq-storm-single-cpu","symptom":"One CPU pinned at 100% softirq/hardirq; rest idle; high si/hi in vmstat","error_patterns":["IRQ storm","ksoftirqd","100% si","RPS","RFS"],"root_cause_class":"irq-steering","affected_concepts":["linux.debugging.vmstat-tool","linux.primitives.sched-setaffinity"],"diagnostic_steps":[{"step":1,"action":"Show per-CPU IRQ counts","command":"cat /proc/interrupts | head -20","expected":"one CPU getting all irqs for an IRQ line","source_id":"kernel-docs-proc-fs"},{"step":2,"action":"Identify NIC IRQ","command":"# grep <iface> /proc/interrupts","expected":"single CPU column non-zero","source_id":"kernel-docs-proc-fs"}],"fix_steps":[{"step":1,"action":"Spread IRQs via irqbalance or manually","command":"sudo systemctl enable --now irqbalance","validation":"per-CPU spread","rollback":"sudo systemctl disable irqbalance","source_id":"kernel-docs-proc-fs"},{"step":2,"action":"Manually pin","command":"echo ff > /proc/irq/<n>/smp_affinity","validation":"IRQ steered","rollback":"prior bitmap","source_id":"kernel-docs-proc-fs"},{"step":3,"action":"Enable RPS/RFS for receive-side scaling","command":"echo ffff | sudo tee /sys/class/net/<iface>/queues/rx-0/rps_cpus","validation":"softirq spreads","rollback":"echo 0 ...","source_id":"kernel-docs-net-sysctl"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["kernel-docs-proc-fs","kernel-docs-net-sysctl"]},
  {"id":"linux.fm.ksoftirqd-pegged","symptom":"`top` shows ksoftirqd/<N> consuming 100% of one CPU","error_patterns":["ksoftirqd","100%","softirq"],"root_cause_class":"irq-storm","affected_concepts":["linux.debugging.htop-tool","linux.debugging.vmstat-tool"],"diagnostic_steps":[{"step":1,"action":"Show softirq breakdown","command":"watch -n1 cat /proc/softirqs","expected":"NET_RX or NET_TX growing fast","source_id":"kernel-docs-proc-fs"}],"fix_steps":[{"step":1,"action":"Cross-link to irq-storm fix (RPS/RFS)","command":"# see linux.fm.irq-storm-single-cpu","validation":"softirq spreads","rollback":null,"source_id":"kernel-docs-net-sysctl"},{"step":2,"action":"For NET_RX storm: enable busy polling","command":"sudo sysctl -w net.core.busy_poll=50; net.core.busy_read=50","validation":"latency drops","rollback":"=0","source_id":"kernel-docs-net-sysctl"}],"confidence":0.8,"last_verified":"2026-05-03","source_ids":["kernel-docs-proc-fs","kernel-docs-net-sysctl"]},
  {"id":"linux.fm.rcu-stall","symptom":"dmesg: 'INFO: rcu_sched detected stalls on CPUs/tasks'","error_patterns":["rcu_sched","stalls","RCU stall"],"root_cause_class":"kernel","affected_concepts":["linux.debugging.kernel-panic","linux.debugging.kernel-oops"],"diagnostic_steps":[{"step":1,"action":"Show stall traces","command":"dmesg -T | grep -i 'rcu' | tail","expected":"PID + stack","source_id":"man7-dmesg-1"}],"fix_steps":[{"step":1,"action":"Identify the offending kernel module/driver","command":"# stack trace identifies subsystem; file kernel bug if upstream","validation":"vendor patch","rollback":"revert kernel","source_id":"kernel-docs-kernel-parameters"},{"step":2,"action":"For known long lock holders: tune rcu_cpu_stall_timeout","command":"sudo sysctl kernel.rcu_cpu_stall_timeout=120","validation":"warnings later (workaround only)","rollback":"=21","source_id":"kernel-docs-kernel-parameters"}],"confidence":0.7,"last_verified":"2026-05-03","source_ids":["man7-dmesg-1","kernel-docs-kernel-parameters"]},
  {"id":"linux.fm.soft-lockup","symptom":"dmesg: 'BUG: soft lockup - CPU#X stuck for Ys! [comm:pid]'","error_patterns":["soft lockup","CPU stuck","BUG:"],"root_cause_class":"kernel","affected_concepts":["linux.debugging.kernel-panic","linux.debugging.kernel-oops"],"diagnostic_steps":[{"step":1,"action":"Get the trace","command":"dmesg -T | grep -A20 'soft lockup' | tail -50","expected":"stack pointing to driver/subsystem","source_id":"man7-dmesg-1"}],"fix_steps":[{"step":1,"action":"For driver bug: update driver / vendor patch","command":"# vendor-specific","validation":"warning gone","rollback":"revert","source_id":"kernel-docs-kernel-parameters"},{"step":2,"action":"Workaround: raise watchdog timeout","command":"sudo sysctl kernel.watchdog_thresh=30","validation":"warnings later","rollback":"=10","source_id":"kernel-docs-kernel-parameters"}],"confidence":0.7,"last_verified":"2026-05-03","source_ids":["man7-dmesg-1","kernel-docs-kernel-parameters"]},
  {"id":"linux.fm.hard-lockup","symptom":"NMI watchdog: 'BUG: hard lockup' or system unresponsive even to magic-sysrq","error_patterns":["hard lockup","NMI watchdog","sysrq unresponsive"],"root_cause_class":"kernel","affected_concepts":["linux.debugging.kernel-panic","linux.debugging.kernel-oops","linux.debugging.kdump"],"diagnostic_steps":[{"step":1,"action":"Get NMI trace post-reboot","command":"dmesg -T | grep -i 'hard lockup\\|NMI' | tail","expected":"stack","source_id":"man7-dmesg-1"},{"step":2,"action":"If kdump enabled: open vmcore","command":"sudo crash /usr/lib/debug/lib/modules/$(uname -r)/vmlinux /var/crash/<ts>/vmcore","expected":"interactive analysis","source_id":"man7-crash-8"}],"fix_steps":[{"step":1,"action":"Update problematic driver / firmware","command":"# vendor-specific","validation":"no recurrence","rollback":"revert","source_id":"kernel-docs-kdump"},{"step":2,"action":"Ensure kdump is enabled before next event","command":"# see linux.fm.kdump-no-crashkernel","validation":"vmcore captured","rollback":null,"source_id":"kernel-docs-kdump"}],"confidence":0.7,"last_verified":"2026-05-03","source_ids":["man7-dmesg-1","kernel-docs-kdump","man7-crash-8"]},
  {"id":"linux.fm.kernel-panic-decoding","symptom":"Boot fails with kernel panic; need to read the stack to find driver","error_patterns":["kernel panic","not syncing","Call Trace","Oops"],"root_cause_class":"kernel","affected_concepts":["linux.debugging.kernel-panic","linux.debugging.kernel-oops","linux.debugging.kdump"],"diagnostic_steps":[{"step":1,"action":"Photograph or capture serial console","command":"# enable serial console for next boot: console=ttyS0,115200","expected":"call trace + EIP/RIP","source_id":"kernel-docs-kernel-parameters"},{"step":2,"action":"Decode addresses with debug symbols","command":"sudo addr2line -e /usr/lib/debug/lib/modules/$(uname -r)/vmlinux <addr>","expected":"source line","source_id":"linux.debugging.gdb-backtrace"}],"fix_steps":[{"step":1,"action":"Boot prior known-good kernel from grub","command":"# select older kernel at grub","validation":"system boots","rollback":null,"source_id":"kernel-docs-kernel-parameters"},{"step":2,"action":"For boot-arg-related: add nofb, nomodeset, single","command":"# edit grub line, add 'nomodeset single'","validation":"single-user boots","rollback":"remove","source_id":"kernel-docs-kernel-parameters"}],"confidence":0.75,"last_verified":"2026-05-03","source_ids":["kernel-docs-kernel-parameters"]},
  {"id":"linux.fm.realtime-prio-inversion","symptom":"SCHED_FIFO/RR thread blocked on lock held by lower-prio thread; realtime task starves","error_patterns":["priority inversion","SCHED_FIFO","blocked","lock"],"root_cause_class":"scheduler","affected_concepts":["linux.primitives.sched-setaffinity"],"diagnostic_steps":[{"step":1,"action":"Show RT runtime allowance","command":"sysctl kernel.sched_rt_runtime_us kernel.sched_rt_period_us","expected":"950000/1000000 = 95% RT max","source_id":"kernel-docs-kernel-parameters"}],"fix_steps":[{"step":1,"action":"Use PI mutex (pthread mutex with PROTOCOL=PRIO_INHERIT)","command":"# pthread_mutexattr_setprotocol(&attr, PTHREAD_PRIO_INHERIT)","validation":"holder gets boosted prio","rollback":"PRIO_NONE","source_id":"man7-pthreads-7"},{"step":2,"action":"Avoid SCHED_FIFO 99 unless needed","command":"# use 80-90 instead so kernel threads can run","validation":"system stays responsive","rollback":null,"source_id":"man7-pthreads-7"}],"confidence":0.75,"last_verified":"2026-05-03","source_ids":["kernel-docs-kernel-parameters","man7-pthreads-7"]},
  {"id":"linux.fm.cpuset-placement-wrong","symptom":"App pinned to cpuset but `taskset` shows it on other CPUs; cpu.max not honored","error_patterns":["cpuset","taskset","not honored","placement"],"root_cause_class":"cgroup-cpu","affected_concepts":["linux.primitives.cgroup-v2","linux.primitives.cgroup-controller"],"diagnostic_steps":[{"step":1,"action":"Check cpuset.cpus.effective","command":"cat /sys/fs/cgroup/<cg>/cpuset.cpus.effective","expected":"matches intended cpus","source_id":"kernel-docs-cgroup-v2"},{"step":2,"action":"Check parent restricts the set","command":"# parent's cpuset.cpus must include child's","expected":"yes","source_id":"kernel-docs-cgroup-v2"}],"fix_steps":[{"step":1,"action":"Enable cpuset controller in subtree_control","command":"echo '+cpuset' | sudo tee /sys/fs/cgroup/cgroup.subtree_control","validation":"cpuset.cpus appears in children","rollback":"echo '-cpuset'","source_id":"kernel-docs-cgroup-v2"},{"step":2,"action":"Set explicit cpus in child","command":"echo 0-3 | sudo tee /sys/fs/cgroup/<cg>/cpuset.cpus","validation":"cpuset.cpus.effective shows it","rollback":"empty","source_id":"kernel-docs-cgroup-v2"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["kernel-docs-cgroup-v2"]},
  {"id":"linux.fm.slab-leak","symptom":"`slabtop` shows specific slab cache growing without bound; memory not reclaimable","error_patterns":["slabtop","slab","kmalloc","leak","kernel memory"],"root_cause_class":"kernel-memory","affected_concepts":["linux.primitives.memory-overcommit","linux.primitives.virtual-memory-areas"],"diagnostic_steps":[{"step":1,"action":"Show top slab caches","command":"sudo slabtop -o -s c | head -20","expected":"named cache (e.g. kmalloc-256, dentry, inode_cache) bloated","source_id":"kernel-docs-mm-concepts"},{"step":2,"action":"Cross-check with /proc/meminfo","command":"grep -E 'Slab|SReclaim|SUnreclaim' /proc/meminfo","expected":"SUnreclaim large","source_id":"kernel-docs-mm-concepts"}],"fix_steps":[{"step":1,"action":"Drop caches as test (does NOT fix leak)","command":"echo 3 | sudo tee /proc/sys/vm/drop_caches","validation":"reclaimable shrinks; SUnreclaim doesn't","rollback":null,"source_id":"kernel-docs-mm-concepts"},{"step":2,"action":"Identify culprit driver/module","command":"sudo cat /proc/slabinfo | sort -k3 -n | tail; # match cache name to module","validation":"upgrade/unload module","rollback":null,"source_id":"kernel-docs-proc-fs"}],"confidence":0.75,"last_verified":"2026-05-03","source_ids":["kernel-docs-mm-concepts","kernel-docs-proc-fs"]}
]
