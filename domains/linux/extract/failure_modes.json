  {"id":"linux.fm.process-stuck-d-state","symptom":"Process in D state (uninterruptible sleep), unkillable even by SIGKILL","error_patterns":["D state","uninterruptible sleep","D in ps"],"root_cause_class":"kernel-io","affected_concepts":["linux.primitives.process-state-disk-sleep"],"diagnostic_steps":[{"step":1,"action":"Confirm D state","command":"ps -o pid,stat,wchan,cmd -p <pid>","expected":"STAT=D, wchan = kernel function blocking","source_id":"man7-strace-1"},{"step":2,"action":"Read kernel stack","command":"sudo cat /proc/<pid>/stack","expected":"call stack of where it's stuck","source_id":"man7-proc-5"},{"step":3,"action":"Read wchan","command":"sudo cat /proc/<pid>/wchan","expected":"function name (e.g. nfs_wait_on_request, io_schedule)","source_id":"man7-proc-5"},{"step":4,"action":"Check disk + mounts","command":"dmesg -T | tail -100; mount | grep -E 'nfs|cifs'","expected":"hints about hung NFS or disk errors","source_id":"man7-dmesg-1"}],"fix_steps":[{"step":1,"action":"For NFS hang: umount -fl","command":"sudo umount -fl <mountpoint>","validation":"process unblocks on next IO","rollback":"re-mount","source_id":"man7-umount-8"},{"step":2,"action":"For dying disk: replace + reboot","command":"# physical replacement","validation":"disk replaced","rollback":null,"source_id":null},{"step":3,"action":"Last resort","command":"sudo reboot","validation":"system back up","rollback":null,"source_id":null}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["man7-proc-5","man7-strace-1"]},
  {"id":"linux.fm.cgroup-memory-oom-kill","symptom":"Process killed by OOM but free memory available system-wide","error_patterns":["Killed","oom-kill","memory.oom.group"],"root_cause_class":"cgroup-limit","affected_concepts":["linux.primitives.cfg.cgroup-v2-control-file.memory-max","linux.primitives.oom-killer"],"diagnostic_steps":[{"step":1,"action":"Read memory.events","command":"cat /sys/fs/cgroup/<cg>/memory.events","expected":"oom or oom_kill > 0","source_id":"kernel-docs-cgroup-v2"},{"step":2,"action":"Compare current vs max","command":"cat /sys/fs/cgroup/<cg>/memory.{current,max}","expected":"current near max","source_id":"kernel-docs-cgroup-v2"},{"step":3,"action":"Check kernel log","command":"dmesg -T | grep -i 'oom-kill'","expected":"victim PID + cgroup","source_id":"man7-dmesg-1"}],"fix_steps":[{"step":1,"action":"Raise memory.max","command":"echo 4G | sudo tee /sys/fs/cgroup/<cg>/memory.max  # or systemctl set-property name.service MemoryMax=4G","validation":"workload survives","rollback":"revert to old","source_id":"systemd-systemd-resource-control-5"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["kernel-docs-cgroup-v2","systemd-systemd-resource-control-5"]},
  {"id":"linux.fm.cpu-throttled","symptom":"CPU usage low but app slow; cpu.stat shows nr_throttled > 0","error_patterns":["throttled_usec","cpu throttling","nr_throttled"],"root_cause_class":"cgroup-limit","affected_concepts":["linux.primitives.cfg.cgroup-v2-control-file.cpu-max"],"diagnostic_steps":[{"step":1,"action":"Read cpu.stat","command":"cat /sys/fs/cgroup/<cg>/cpu.stat","expected":"nr_throttled and throttled_usec increasing","source_id":"kernel-docs-cgroup-v2"},{"step":2,"action":"Compare cpu.max quota vs need","command":"cat /sys/fs/cgroup/<cg>/cpu.max","expected":"e.g. 50000 100000 = half a core","source_id":"kernel-docs-cgroup-v2"}],"fix_steps":[{"step":1,"action":"Raise quota or remove","command":"echo 'max 100000' | sudo tee /sys/fs/cgroup/<cg>/cpu.max","validation":"throttling stops","rollback":"restore quota","source_id":"kernel-docs-cgroup-v2"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["kernel-docs-cgroup-v2"]},
  {"id":"linux.fm.fd-leak","symptom":"App fails 'Too many open files' (EMFILE)","error_patterns":["Too many open files","EMFILE","accept: too many"],"root_cause_class":"fd-leak","affected_concepts":["linux.primitives.cfg.proc-sys-file.fs-file-max"],"diagnostic_steps":[{"step":1,"action":"Per-process FD count","command":"ls /proc/<pid>/fd | wc -l","expected":"approaching RLIMIT_NOFILE","source_id":"man7-lsof-8"},{"step":2,"action":"Read soft+hard limits","command":"cat /proc/<pid>/limits | grep 'open files'","expected":"e.g. 1024 4096","source_id":"man7-proc-5"},{"step":3,"action":"Identify leaked FDs","command":"sudo lsof -p <pid> | head -50","expected":"many similar entries (sockets to one host, files in one dir)","source_id":"man7-lsof-8"}],"fix_steps":[{"step":1,"action":"Raise per-process limit","command":"# in systemd unit: LimitNOFILE=65536","validation":"new limit visible in /proc/<pid>/limits after restart","rollback":"revert directive","source_id":"systemd-systemd-exec-5"},{"step":2,"action":"Fix the leak","command":"# code review: ensure close() / try-with-resources","validation":"FD count stable over time","rollback":null,"source_id":null}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["man7-lsof-8","systemd-systemd-exec-5"]},
  {"id":"linux.fm.disk-full-but-df-shows-free-space","symptom":"`df` shows free space but writes fail ENOSPC","error_patterns":["No space left on device","ENOSPC","disk full"],"root_cause_class":"storage","affected_concepts":["linux.filesystem.cfg.proc-control.diskstats","linux.filesystem.inode"],"diagnostic_steps":[{"step":1,"action":"Check inodes","command":"df -i","expected":"IFree near 0 = inode exhaustion","source_id":"man7-statfs-2"},{"step":2,"action":"Check deleted-but-open files","command":"sudo lsof +L1","expected":"files with link count 0","source_id":"man7-lsof-8"},{"step":3,"action":"Check ext4 reserved blocks","command":"sudo tune2fs -l <device> | grep -i 'reserved block'","expected":"5% reserved for root","source_id":"man7-tune2fs-8"}],"fix_steps":[{"step":1,"action":"For inode exhaustion: clean small files","command":"# find / -size 0 -delete","validation":"df -i shows free","rollback":null,"source_id":"man7-tune2fs-8"},{"step":2,"action":"For deleted-but-held: restart holder","command":"systemctl restart <service>","validation":"file gone, space freed","rollback":null,"source_id":"systemd-systemctl-1"},{"step":3,"action":"For reserved blocks: lower","command":"sudo tune2fs -m 1 /dev/sda1","validation":"more space available to non-root","rollback":"sudo tune2fs -m 5 /dev/sda1","source_id":"man7-tune2fs-8"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["man7-statfs-2","man7-lsof-8","man7-tune2fs-8"]},
  {"id":"linux.fm.cannot-create-userns","symptom":"`unshare --user` fails EPERM","error_patterns":["Operation not permitted","EPERM","user_namespace creation failed"],"root_cause_class":"sysctl","affected_concepts":["linux.primitives.cfg.proc-sys-file.user-max-user-namespaces"],"diagnostic_steps":[{"step":1,"action":"Check sysctl","command":"sysctl user.max_user_namespaces kernel.unprivileged_userns_clone","expected":"max > 0; clone = 1 (Debian)","source_id":"man7-user-namespaces-7"}],"fix_steps":[{"step":1,"action":"Enable unprivileged userns","command":"sudo sysctl -w kernel.unprivileged_userns_clone=1; sudo sysctl -w user.max_user_namespaces=15000","validation":"unshare --user succeeds","rollback":"sysctl -w ...=0","source_id":"man7-user-namespaces-7"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["man7-user-namespaces-7"]},
  {"id":"linux.fm.systemd-service-flapping","symptom":"systemd unit goes 'failed' after StartLimitBurst restarts","error_patterns":["Start request repeated too quickly","start-limit-hit","entered failed state"],"root_cause_class":"service-config","affected_concepts":["linux.systemd.cfg.unit.StartLimitIntervalSec","linux.systemd.restart-rate-limit"],"diagnostic_steps":[{"step":1,"action":"Read state","command":"systemctl status <unit>","expected":"start-limit-hit reason","source_id":"systemd-systemctl-1"},{"step":2,"action":"Check StartLimit settings","command":"systemctl show <unit> -p StartLimitIntervalSec,StartLimitBurst","expected":"defaults 10s/5","source_id":"systemd-systemd-unit-5"}],"fix_steps":[{"step":1,"action":"Reset failed state","command":"systemctl reset-failed <unit>","validation":"can be started again","rollback":null,"source_id":"systemd-systemctl-1"},{"step":2,"action":"Loosen rate limit","command":"# in unit [Unit]: StartLimitBurst=10 StartLimitIntervalSec=60s","validation":"can restart more often","rollback":"revert directive","source_id":"systemd-systemd-unit-5"},{"step":3,"action":"Investigate root cause","command":"journalctl -u <unit> -n 100","validation":"see actual exit code/error","rollback":null,"source_id":"systemd-journalctl-1"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["systemd-systemd-unit-5","systemd-journalctl-1"]},
  {"id":"linux.fm.mount-not-visible-on-host","symptom":"Mount inside container/namespace not visible on host","error_patterns":["mount not propagating","MS_PRIVATE","mount invisible"],"root_cause_class":"mount-propagation","affected_concepts":["linux.primitives.mount-namespace-propagation"],"diagnostic_steps":[{"step":1,"action":"Check propagation","command":"findmnt -o TARGET,PROPAGATION /","expected":"shared|private|slave|unbindable","source_id":"man7-mount-namespaces-7"}],"fix_steps":[{"step":1,"action":"Make parent shared","command":"sudo mount --make-shared /","validation":"new mounts propagate","rollback":"mount --make-private /","source_id":"man7-mount-8"},{"step":2,"action":"For container: rbind shared","command":"# docker -v /host:/container:rshared","validation":"propagation in both directions","rollback":"omit :rshared","source_id":"man7-mount-8"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["man7-mount-namespaces-7","man7-mount-8"]},
  {"id":"linux.fm.tcp-time-wait-exhaustion","symptom":"Many short outbound TCP connections; client gets EADDRNOTAVAIL","error_patterns":["EADDRNOTAVAIL","Cannot assign requested address","port range exhausted"],"root_cause_class":"networking","affected_concepts":["linux.networking.tcp-state-time-wait","linux.networking.cfg.sysctl-net-ipv4.ip-local-port-range"],"diagnostic_steps":[{"step":1,"action":"Count TIME_WAIT","command":"ss -ant state time-wait | wc -l","expected":"thousands","source_id":"man7-ss-8"},{"step":2,"action":"Check ephemeral port range","command":"sysctl net.ipv4.ip_local_port_range","expected":"e.g. 32768 60999","source_id":"kernel-docs-net-sysctl"},{"step":3,"action":"Inspect tw_reuse","command":"sysctl net.ipv4.tcp_tw_reuse","expected":"2 (default loopback only)","source_id":"kernel-docs-net-sysctl"}],"fix_steps":[{"step":1,"action":"Widen ephemeral range","command":"sudo sysctl -w net.ipv4.ip_local_port_range='1024 65535'","validation":"more outbound ports","rollback":"restore default","source_id":"kernel-docs-net-sysctl"},{"step":2,"action":"Enable tw_reuse","command":"sudo sysctl -w net.ipv4.tcp_tw_reuse=1","validation":"TIME_WAIT reused for outbound","rollback":"=2","source_id":"kernel-docs-net-sysctl"},{"step":3,"action":"App-side: connection pooling","command":"# implement in app","validation":"fewer total conns","rollback":null,"source_id":null}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["kernel-docs-net-sysctl","man7-ss-8"]},
  {"id":"linux.fm.conntrack-table-full","symptom":"`nf_conntrack: table full, dropping packet` in dmesg; new connections silently fail","error_patterns":["nf_conntrack: table full","conntrack table full"],"root_cause_class":"networking","affected_concepts":["linux.networking.conntrack-table","linux.networking.cfg.sysctl-net-netfilter.nf-conntrack-max"],"diagnostic_steps":[{"step":1,"action":"Confirm in dmesg","command":"dmesg -T | grep -i 'nf_conntrack: table full'","expected":"matching log lines","source_id":"man7-dmesg-1"},{"step":2,"action":"Check current vs max","command":"sysctl net.netfilter.nf_conntrack_count net.netfilter.nf_conntrack_max","expected":"count near max","source_id":"kernel-docs-conntrack-sysctl"}],"fix_steps":[{"step":1,"action":"Bump max","command":"sudo sysctl -w net.netfilter.nf_conntrack_max=524288","validation":"count < max","rollback":"restore old","source_id":"kernel-docs-conntrack-sysctl"},{"step":2,"action":"Bump bucket count","command":"sudo sysctl -w net.netfilter.nf_conntrack_buckets=131072","validation":"hash uniformly distributed","rollback":"restore","source_id":"kernel-docs-conntrack-sysctl"},{"step":3,"action":"Persist","command":"# /etc/sysctl.d/99-conntrack.conf","validation":"survives reboot","rollback":"remove file","source_id":"kernel-docs-conntrack-sysctl"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["kernel-docs-conntrack-sysctl","debian-conntrack-8"]},
  {"id":"linux.fm.dns-slow-ndots","symptom":"DNS queries slow inside container; first lookup multi-second","error_patterns":["search list expansion","NXDOMAIN multiple","DNS timeout"],"root_cause_class":"dns","affected_concepts":["linux.networking.ndots","linux.networking.cfg.resolv-conf-directive.options-ndots"],"diagnostic_steps":[{"step":1,"action":"Inspect resolv.conf","command":"cat /etc/resolv.conf","expected":"options ndots:5 + long search list","source_id":"man7-resolv-conf-5"},{"step":2,"action":"Trace DNS queries","command":"sudo tcpdump -i any -nn port 53","expected":"multiple lookups per name","source_id":"tcpdump-manpage"}],"fix_steps":[{"step":1,"action":"Lower ndots","command":"# add 'options ndots:1' to /etc/resolv.conf","validation":"single DNS query per name","rollback":"restore ndots:5","source_id":"man7-resolv-conf-5"},{"step":2,"action":"Use FQDN with trailing dot","command":"# 'github.com.' (with trailing dot) bypasses search","validation":"single direct query","rollback":null,"source_id":"man7-resolv-conf-5"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["man7-resolv-conf-5"]},
  {"id":"linux.fm.cap-dropped-but-binary-still-works","symptom":"Drop CAP_X but binary still does X","error_patterns":["unexpected capability","setuid binary","file capabilities"],"root_cause_class":"capabilities","affected_concepts":["linux.primitives.cap-effective-set"],"diagnostic_steps":[{"step":1,"action":"Check file caps","command":"sudo getcap -r /usr/bin","expected":"binaries with file caps shown","source_id":"man7-capabilities-7"},{"step":2,"action":"Check process caps","command":"cat /proc/<pid>/status | grep ^Cap","expected":"CapEff bitmap","source_id":"man7-proc-5"}],"fix_steps":[{"step":1,"action":"Remove file caps","command":"sudo setcap -r <bin>","validation":"getcap <bin> empty","rollback":"sudo setcap <caps> <bin>","source_id":"man7-capabilities-7"},{"step":2,"action":"For systemd: explicit bounding set","command":"# CapabilityBoundingSet=~CAP_X","validation":"capsh --print shows CAP_X dropped","rollback":"remove directive","source_id":"systemd-systemd-exec-5"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["man7-capabilities-7","systemd-systemd-exec-5"]},
  {"id":"linux.fm.systemd-coredump-not-saved","symptom":"App SIGSEGV but no core dump in /var/lib/systemd/coredump","error_patterns":["SIGSEGV","no core dump","RLIMIT_CORE=0"],"root_cause_class":"coredump","affected_concepts":["linux.systemd.coredump-handling","linux.primitives.cfg.proc-sys-file.kernel-core-pattern"],"diagnostic_steps":[{"step":1,"action":"Check core_pattern","command":"sysctl kernel.core_pattern","expected":"|/usr/lib/systemd/systemd-coredump ...","source_id":"man7-proc-5"},{"step":2,"action":"Check RLIMIT_CORE","command":"systemctl show <unit> -p LimitCORE","expected":"infinity (or large)","source_id":"systemd-systemd-exec-5"},{"step":3,"action":"Check coredumpctl","command":"coredumpctl list","expected":"recent entries","source_id":"systemd-coredumpctl-1"},{"step":4,"action":"Check disk space","command":"df -h /var","expected":"space free","source_id":"man7-statfs-2"}],"fix_steps":[{"step":1,"action":"Set LimitCORE=infinity in unit","command":"# [Service] LimitCORE=infinity","validation":"systemctl show shows new value; coredumpctl list captures","rollback":"remove directive","source_id":"systemd-systemd-exec-5"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["systemd-coredumpctl-1","systemd-systemd-exec-5"]},
  {"id":"linux.fm.permission-denied-not-mode-bits","symptom":"chmod 777 doesn't fix permission denied; SELinux/AppArmor denying","error_patterns":["Permission denied","AVC denial","apparmor=DENIED"],"root_cause_class":"lsm","affected_concepts":["linux.primitives.linux-security-module"],"diagnostic_steps":[{"step":1,"action":"Check AVC log","command":"sudo ausearch -m AVC -ts recent","expected":"AVC denials","source_id":"man7-ausearch-8"},{"step":2,"action":"Check AppArmor","command":"sudo dmesg -T | grep apparmor","expected":"DENIED entries","source_id":"man7-dmesg-1"},{"step":3,"action":"Identify SELinux state","command":"getenforce","expected":"Enforcing|Permissive|Disabled","source_id":"kernel-docs-lsm-selinux"}],"fix_steps":[{"step":1,"action":"For dev only: temporarily permissive","command":"sudo setenforce 0","validation":"setenforce returns 0","rollback":"sudo setenforce 1","source_id":"kernel-docs-lsm-selinux"},{"step":2,"action":"Diagnose policy fix","command":"sudo audit2allow -a -M mypol; sudo semodule -i mypol.pp","validation":"AVC denial gone","rollback":"sudo semodule -r mypol","source_id":"kernel-docs-lsm-selinux"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["kernel-docs-lsm-selinux","man7-ausearch-8"]},
  {"id":"linux.fm.high-context-switch","symptom":"High context-switch rate; vmstat cs column >>1k/sec","error_patterns":["context switch storm","high cs"],"root_cause_class":"contention","affected_concepts":["linux.debugging.context-switch"],"diagnostic_steps":[{"step":1,"action":"Confirm via vmstat","command":"vmstat 1 5","expected":"cs column persistently high","source_id":"debian-vmstat-8"},{"step":2,"action":"Per-thread breakdown","command":"pidstat -wt 1 5","expected":"voluntary vs nonvoluntary cs","source_id":"man7-pidstat-1"},{"step":3,"action":"Profile lock contention","command":"sudo perf record -e sched:sched_switch -ag sleep 10 && perf report","expected":"see what's switching","source_id":"man7-perf-record-1"}],"fix_steps":[{"step":1,"action":"For app-level lock contention: optimize","command":"# code-level: reduce lock scope, lockfree algorithms","validation":"cs reduced","rollback":null,"source_id":null},{"step":2,"action":"For oversubscription: scale down","command":"# reduce thread count or pin to fewer CPUs","validation":"cs lower","rollback":null,"source_id":null}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["debian-vmstat-8","man7-perf-record-1"]},
  {"id":"linux.fm.iowait-high","symptom":"vmstat wa column high; CPUs waiting on IO","error_patterns":["high iowait","%wa","D state pile-up"],"root_cause_class":"io","affected_concepts":["linux.debugging.iostat-tool","linux.filesystem.cfg.proc-control.diskstats"],"diagnostic_steps":[{"step":1,"action":"Confirm iowait","command":"vmstat 1 5","expected":"wa column high","source_id":"debian-vmstat-8"},{"step":2,"action":"Per-device IO stats","command":"iostat -xmz 1 5","expected":"%util near 100 + high await","source_id":"man7-iostat-1"},{"step":3,"action":"Per-process IO","command":"sudo iotop -oPa","expected":"top consumers","source_id":"debian-iotop-8"},{"step":4,"action":"Block-layer trace","command":"sudo blktrace -d /dev/sda -o - -w 10 | blkparse -i -","expected":"per-IO timing","source_id":"man7-blktrace-8"}],"fix_steps":[{"step":1,"action":"App-level: reduce IO","command":"# tune cache, batch writes","validation":"wa drops","rollback":null,"source_id":null},{"step":2,"action":"For dying disk: replace","command":"# physical","validation":"wa drops post-replacement","rollback":null,"source_id":null}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["man7-iostat-1","debian-iotop-8"]},
  {"id":"linux.fm.swap-storm","symptom":"vmstat shows si/so > 0 continuously; system unresponsive","error_patterns":["swap thrashing","si so","heavy swap"],"root_cause_class":"memory","affected_concepts":["linux.primitives.cfg.proc-sys-file.vm-swappiness"],"diagnostic_steps":[{"step":1,"action":"Confirm swap activity","command":"vmstat 1","expected":"si/so columns nonzero","source_id":"debian-vmstat-8"},{"step":2,"action":"Find consumer","command":"smem -tk -s rss","expected":"top RSS consumers","source_id":"debian-vmstat-8"}],"fix_steps":[{"step":1,"action":"Reduce app memory","command":"# tune JVM heap, reduce caches, etc.","validation":"swap idle","rollback":null,"source_id":null},{"step":2,"action":"Lower swappiness","command":"sudo sysctl -w vm.swappiness=10","validation":"less aggressive swap","rollback":"=60","source_id":"man7-proc-5"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["man7-proc-5","debian-vmstat-8"]},
  {"id":"linux.fm.fork-eagain","symptom":"fork()/clone() returns EAGAIN","error_patterns":["EAGAIN","Resource temporarily unavailable","fork failed"],"root_cause_class":"resource-limit","affected_concepts":["linux.primitives.cfg.proc-sys-file.kernel-pid-max","linux.primitives.cfg.cgroup-v2-control-file.pids-max"],"diagnostic_steps":[{"step":1,"action":"Check global pid count","command":"ps -eL | wc -l","expected":"large value (compare vs kernel.pid_max)","source_id":"man7-proc-5"},{"step":2,"action":"Check per-cgroup pids.max","command":"cat /sys/fs/cgroup/<cg>/pids.{current,max}","expected":"current near max","source_id":"kernel-docs-cgroup-v2"},{"step":3,"action":"Check RLIMIT_NPROC","command":"cat /proc/<pid>/limits | grep processes","expected":"soft limit","source_id":"man7-proc-5"}],"fix_steps":[{"step":1,"action":"Raise pids cgroup max","command":"systemctl set-property <unit> TasksMax=infinity  # OR per-shell ulimit -u","validation":"new processes can fork","rollback":"restore old","source_id":"systemd-systemd-resource-control-5"},{"step":2,"action":"For host-wide: kernel.pid_max","command":"sudo sysctl -w kernel.pid_max=4194304","validation":"more PIDs","rollback":"=32768","source_id":"man7-proc-5"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["man7-proc-5","kernel-docs-cgroup-v2","systemd-systemd-resource-control-5"]},
  {"id":"linux.fm.systemd-mount-failed","symptom":"systemd `<path>.mount` unit failed; mountpoint unavailable","error_patterns":["mount failed","systemd-fsck failed","unit foo.mount failed"],"root_cause_class":"mount","affected_concepts":["linux.systemd.mount-unit","linux.filesystem.cmd.mount"],"diagnostic_steps":[{"step":1,"action":"Status of mount unit","command":"systemctl status <encoded-path>.mount","expected":"failure reason","source_id":"systemd-systemctl-1"},{"step":2,"action":"Inspect fstab","command":"grep <path> /etc/fstab","expected":"correct device + options","source_id":"man7-fstab-5"},{"step":3,"action":"Manual mount attempt","command":"sudo mount <device> <path>","expected":"specific error","source_id":"man7-mount-8"}],"fix_steps":[{"step":1,"action":"Fix fstab entry","command":"# correct UUID/options","validation":"systemctl daemon-reload + systemctl start <mount>","rollback":"git checkout","source_id":"man7-fstab-5"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["systemd-systemd-mount-5","man7-mount-8"]},
