  {
    "id": "devin.api.cfg.auth.authorization-header",
    "scope": "auth",
    "key": "Authorization",
    "type": "http-header",
    "default_value": "Bearer <cog_...>",
    "description": "Required HTTP header on every Devin API request. Format: `Authorization: Bearer <token>`. Token starts with `cog_` (current API) or `apk_user_`/`apk_` (legacy). Same shape for both Service User API Keys and PATs.",
