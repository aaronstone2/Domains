{
  "name": "differentiation_matrix",
  "caption": "MetroGraph HCI-cost edge vs competitor average, pain-weighted.",
  "sql": "WITH us AS (SELECT feature_id, qg(hci_cost) uc FROM market.product_features WHERE product_id='market.product.us'), them AS (SELECT pf.feature_id, AVG(qg(pf.hci_cost)) tc FROM market.product_features pf JOIN market.products p ON pf.product_id=p.id WHERE p.is_self=false GROUP BY 1) SELECT f.name, us.uc us_hci, ROUND(them.tc,2) their_avg_hci, ROUND((us.uc-them.tc)*f.pain_score,2) weighted_edge FROM us JOIN them USING(feature_id) JOIN market.features f ON f.id=us.feature_id ORDER BY weighted_edge DESC LIMIT 25",
