{
  "name": "whitespace",
  "caption": "High-pain features no competitor executes above grade C (the gap MetroGraph can own).",
  "sql": "SELECT f.name, f.pain_score, COALESCE(MAX(qg(pf.quality_grade)),0) best_competitor_q FROM market.features f LEFT JOIN market.product_features pf ON pf.feature_id=f.id LEFT JOIN market.products p ON pf.product_id=p.id AND p.is_self=false WHERE f.pain_score>=0.7 GROUP BY 1,2 HAVING COALESCE(MAX(qg(pf.quality_grade)),0)<=3 ORDER BY f.pain_score DESC",
