[
  {"id":"k8s.fm.pod-pending-failedscheduling","symptom":"Pod stuck Pending; events show FailedScheduling","error_patterns":["FailedScheduling","didn't have free ports","insufficient cpu","insufficient memory","didn't match Pod's node affinity"],"root_cause_class":"scheduling","affected_concepts":["k8s.core.event-reason-failed-scheduling"],"diagnostic_steps":[{"step":1,"action":"Read pod events","command":"kubectl describe pod <name>","expected":"FailedScheduling event with reason","source_id":"k8s-determine-reason-pod-failure"},{"step":2,"action":"Check node capacity","command":"kubectl describe nodes | grep -E 'Capacity|Allocatable|Allocated resources' -A 5","expected":"see what's free vs requested","source_id":"k8s-debug-cluster"},{"step":3,"action":"Check taints/tolerations","command":"kubectl describe nodes | grep Taints","expected":"node taints","source_id":"k8s-taints-tolerations"}],"fix_steps":[{"step":1,"action":"Lower requests","command":"# spec.containers[].resources.requests.{cpu,memory} smaller","validation":"pod schedules","rollback":"revert","source_id":"k8s-resource-management"},{"step":2,"action":"Add toleration","command":"# spec.tolerations: [{key, operator, value, effect}]","validation":"pod tolerates target node","rollback":"remove","source_id":"k8s-taints-tolerations"},{"step":3,"action":"Add nodes / scale up","command":"# cluster autoscaler config","validation":"new node available","rollback":null,"source_id":null}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-determine-reason-pod-failure","k8s-scheduling-eviction"]},
  {"id":"k8s.fm.crashloopbackoff","symptom":"Pod CrashLoopBackOff: container repeatedly crashing","error_patterns":["CrashLoopBackOff","Back-off restarting"],"root_cause_class":"app-crash","affected_concepts":["k8s.core.crash-loop-backoff"],"diagnostic_steps":[{"step":1,"action":"Read previous container's logs","command":"kubectl logs <pod> -c <container> --previous --tail=200","expected":"app's last words before crash","source_id":"k8s-debug-running-pod"},{"step":2,"action":"Check exit code","command":"kubectl get pod <pod> -o jsonpath='{.status.containerStatuses[*].lastState.terminated.exitCode}'","expected":"0/1/137/143/etc.","source_id":"k8s-pod-lifecycle"},{"step":3,"action":"Check OOMKilled","command":"kubectl get pod <pod> -o jsonpath='{.status.containerStatuses[*].lastState.terminated.reason}'","expected":"OOMKilled if 137","source_id":"k8s-pod-lifecycle"},{"step":4,"action":"Inspect args/env/configmap","command":"kubectl get pod <pod> -o yaml","expected":"spec correct","source_id":"k8s-debug-running-pod"}],"fix_steps":[{"step":1,"action":"Fix per logs (most cases app config)","command":"# specific to app","validation":"pod Ready","rollback":null,"source_id":null},{"step":2,"action":"For OOM: raise memory limits","command":"# spec.containers[].resources.limits.memory","validation":"no OOM","rollback":"revert","source_id":"k8s-resource-management"},{"step":3,"action":"For misconfig: fix configmap/secret","command":"kubectl edit cm/X then kubectl rollout restart deploy/Y","validation":"new pod boots clean","rollback":"revert cm","source_id":"k8s-configmap"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-debug-running-pod","k8s-pod-lifecycle"]},
  {"id":"k8s.fm.imagepullbackoff","symptom":"Pod ImagePullBackOff or ErrImagePull","error_patterns":["ImagePullBackOff","ErrImagePull","manifest unknown","pull access denied","unauthorized"],"root_cause_class":"registry","affected_concepts":["k8s.core.image-pull-back-off"],"diagnostic_steps":[{"step":1,"action":"Read events","command":"kubectl describe pod <pod>","expected":"specific registry response","source_id":"k8s-debug-running-pod"},{"step":2,"action":"Check imagePullSecrets","command":"kubectl get pod <pod> -o jsonpath='{.spec.imagePullSecrets}'","expected":"non-empty for private registry","source_id":"k8s-secret"},{"step":3,"action":"Check secret","command":"kubectl get secret <pull-secret> -o yaml","expected":"type: kubernetes.io/dockerconfigjson","source_id":"k8s-secret"}],"fix_steps":[{"step":1,"action":"Create pull secret","command":"kubectl create secret docker-registry myreg --docker-server=... --docker-username=... --docker-password=... --docker-email=...","validation":"secret created","rollback":"kubectl delete secret myreg","source_id":"k8s-secret"},{"step":2,"action":"Reference in pod","command":"# spec.imagePullSecrets: [{name: myreg}]","validation":"pull succeeds","rollback":"remove","source_id":"k8s-pods"},{"step":3,"action":"Or attach to ServiceAccount","command":"kubectl patch serviceaccount default -p '{\"imagePullSecrets\":[{\"name\":\"myreg\"}]}'","validation":"all pods using default SA inherit","rollback":"patch back","source_id":"k8s-rbac"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-debug-running-pod","k8s-secret"]},
  {"id":"k8s.fm.oomkilled","symptom":"Container OOMKilled (exit 137)","error_patterns":["OOMKilled","exit code 137"],"root_cause_class":"resource-limit","affected_concepts":["k8s.core.oom-kill"],"diagnostic_steps":[{"step":1,"action":"Confirm OOM","command":"kubectl describe pod <pod>","expected":"Last State Reason: OOMKilled","source_id":"k8s-pod-lifecycle"},{"step":2,"action":"Check actual memory usage","command":"kubectl top pod <pod>","expected":"near limit","source_id":"k8s-resource-metrics-pipeline"},{"step":3,"action":"Read kernel log on node","command":"# SSH to node OR kubectl debug node","expected":"oom-killer messages","source_id":"k8s-cgroups"}],"fix_steps":[{"step":1,"action":"Raise memory limits","command":"kubectl set resources deploy/X --limits=memory=4Gi","validation":"no OOM","rollback":"set previous limit","source_id":"k8s-resource-management"},{"step":2,"action":"Tune app heap","command":"# JVM: -Xmx; Go: GOMEMLIMIT","validation":"app respects container limit","rollback":null,"source_id":null}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-resource-management","k8s-pod-lifecycle"]},
  {"id":"k8s.fm.terminating-stuck","symptom":"Pod stuck in Terminating state","error_patterns":["stuck terminating","Terminating for too long"],"root_cause_class":"finalizer","affected_concepts":["k8s.core.finalizer"],"diagnostic_steps":[{"step":1,"action":"Inspect finalizers","command":"kubectl get pod <pod> -o yaml | grep -A 5 finalizers","expected":"controller-owned finalizers","source_id":"k8s-debug-cluster"},{"step":2,"action":"Check volume detach","command":"kubectl describe pod <pod> | grep -i 'unable to mount\\|FailedAttach'","expected":"errors if volume issue","source_id":"k8s-debug-application-cluster"}],"fix_steps":[{"step":1,"action":"Wait grace period","command":"# default 30s","validation":"pod gone","rollback":null,"source_id":"k8s-pods"},{"step":2,"action":"Force delete (last resort)","command":"kubectl delete pod <pod> --grace-period=0 --force","validation":"pod gone from API","rollback":null,"source_id":"k8s-debug-cluster"},{"step":3,"action":"For stuck finalizer","command":"kubectl patch pod <pod> -p '{\"metadata\":{\"finalizers\":null}}' --type=merge","validation":"pod gone","rollback":null,"source_id":"k8s-debug-cluster"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-debug-cluster"]},
  {"id":"k8s.fm.service-no-endpoints","symptom":"Service exists but no endpoints; clients can't reach","error_patterns":["no endpoints","endpoints empty"],"root_cause_class":"selector","affected_concepts":["k8s.core.service","k8s.networking.endpoints"],"diagnostic_steps":[{"step":1,"action":"Check service selector","command":"kubectl get svc <name> -o jsonpath='{.spec.selector}'","expected":"label map","source_id":"k8s-services"},{"step":2,"action":"Find pods matching selector","command":"kubectl get pods -l <key>=<val>","expected":"some","source_id":"k8s-services"},{"step":3,"action":"Check endpoints","command":"kubectl get endpoints <svc>","expected":"non-empty subsets","source_id":"k8s-debug-services"},{"step":4,"action":"Check pod readiness","command":"kubectl get pods -l <selector> -o json | jq '.items[].status.conditions'","expected":"Ready=True","source_id":"k8s-probes"}],"fix_steps":[{"step":1,"action":"Fix selector mismatch","command":"# match service.spec.selector to pod labels","validation":"endpoints populated","rollback":"revert","source_id":"k8s-services"},{"step":2,"action":"Fix readiness probe","command":"# adjust path/timing","validation":"pods Ready","rollback":"revert","source_id":"k8s-probes"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-debug-services"]},
  {"id":"k8s.fm.dns-resolution-fail","symptom":"Pod can't resolve DNS","error_patterns":["could not resolve","NXDOMAIN","Temporary failure"],"root_cause_class":"dns","affected_concepts":["k8s.networking.coredns","k8s.networking.cluster-dns"],"diagnostic_steps":[{"step":1,"action":"Test from debug pod","command":"kubectl run -it --rm dns --image=busybox -- nslookup kubernetes.default","expected":"resolves to kubernetes service IP","source_id":"k8s-dns"},{"step":2,"action":"Check CoreDNS pods","command":"kubectl get pods -n kube-system -l k8s-app=kube-dns","expected":"all Running","source_id":"k8s-dns"},{"step":3,"action":"Check kube-dns service","command":"kubectl get endpoints -n kube-system kube-dns","expected":"non-empty","source_id":"k8s-debug-services"},{"step":4,"action":"Check CoreDNS logs","command":"kubectl logs -n kube-system -l k8s-app=kube-dns","expected":"no SERVFAIL panics","source_id":"k8s-dns"}],"fix_steps":[{"step":1,"action":"Restart CoreDNS","command":"kubectl rollout restart deploy/coredns -n kube-system","validation":"DNS works","rollback":"none","source_id":"k8s-dns"},{"step":2,"action":"Fix Corefile","command":"kubectl edit cm/coredns -n kube-system","validation":"saved + new pods pick up","rollback":"git revert","source_id":"k8s-dns"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-dns","k8s-debug-services"]},
  {"id":"k8s.fm.ingress-404","symptom":"Ingress returns 404 for valid path","error_patterns":["404 Not Found","default backend"],"root_cause_class":"routing","affected_concepts":["k8s.networking.ingress"],"diagnostic_steps":[{"step":1,"action":"Verify Host header matches","command":"curl -H 'Host: example.com' http://<ingress-ip>/path","expected":"non-404","source_id":"k8s-ingress"},{"step":2,"action":"Check Ingress spec","command":"kubectl get ingress <name> -o yaml","expected":"correct host + path","source_id":"k8s-ingress"},{"step":3,"action":"Check ingress controller logs","command":"kubectl logs -n ingress-nginx -l app.kubernetes.io/name=ingress-nginx","expected":"sees request","source_id":"k8s-ingress"},{"step":4,"action":"Check pathType","command":"# Prefix vs Exact matters","expected":null,"source_id":"k8s-ingress"}],"fix_steps":[{"step":1,"action":"Fix host/path","command":"kubectl edit ingress <name>","validation":"requests routed","rollback":"git revert","source_id":"k8s-ingress"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-ingress","k8s-debug-services"]},
  {"id":"k8s.fm.networkpolicy-blocking","symptom":"Pod-to-pod traffic suddenly blocked after applying NetworkPolicy","error_patterns":["connection refused","timeout from pod-X to pod-Y"],"root_cause_class":"networking","affected_concepts":["k8s.networking.network-policy","k8s.networking.network-policy-default-deny"],"diagnostic_steps":[{"step":1,"action":"List policies in namespace","command":"kubectl get netpol -n <ns>","expected":"see policies","source_id":"k8s-network-policies"},{"step":2,"action":"Inspect each policy","command":"kubectl describe netpol <name>","expected":"podSelector + ingress/egress rules","source_id":"k8s-network-policies"},{"step":3,"action":"Test connectivity","command":"kubectl exec -it pod-X -- curl pod-Y:8080","expected":"matches expected vs blocked","source_id":"k8s-debug-services"}],"fix_steps":[{"step":1,"action":"Add allow rule","command":"# add ingress.from.podSelector for source pods","validation":"connection succeeds","rollback":"remove rule","source_id":"k8s-network-policies"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-network-policies"]},
  {"id":"k8s.fm.pvc-pending","symptom":"PVC stuck in Pending state","error_patterns":["PersistentVolumeClaim is not bound","provisioning failed","no storage class"],"root_cause_class":"storage","affected_concepts":["k8s.core.persistent-volume-claim"],"diagnostic_steps":[{"step":1,"action":"Describe PVC","command":"kubectl describe pvc <name>","expected":"events + storageClassName","source_id":"k8s-pv-pvc"},{"step":2,"action":"Check StorageClass","command":"kubectl get sc","expected":"default class exists","source_id":"k8s-storage-classes"},{"step":3,"action":"Check provisioner pod","command":"kubectl get pods -A -l app=ebs-csi-controller (or your provisioner)","expected":"Running","source_id":"k8s-storage-classes"}],"fix_steps":[{"step":1,"action":"Create default SC","command":"kubectl apply -f sc.yaml; kubectl annotate sc/X storageclass.kubernetes.io/is-default-class=true","validation":"PVCs bind","rollback":"remove annotation","source_id":"k8s-storage-classes"},{"step":2,"action":"Restart provisioner","command":"kubectl rollout restart deploy/<csi-controller> -n kube-system","validation":"PVCs bind","rollback":null,"source_id":null}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-pv-pvc","k8s-storage-classes"]},
  {"id":"k8s.fm.cpu-throttled","symptom":"App slow but `kubectl top` shows low CPU","error_patterns":["throttled","cpu.stat throttled","high latency low utilization"],"root_cause_class":"resource-limit","affected_concepts":["k8s.core.cpu-throttling"],"diagnostic_steps":[{"step":1,"action":"Check container limits","command":"kubectl describe pod <pod> | grep -A 3 Limits","expected":"cpu: <quota>","source_id":"k8s-resource-management"},{"step":2,"action":"Read container's cpu.stat","command":"kubectl debug node/<node> -it --image=busybox; cat /sys/fs/cgroup/kubepods.slice/.../cpu.stat","expected":"nr_throttled / throttled_usec","source_id":"k8s-cgroups"}],"fix_steps":[{"step":1,"action":"Raise CPU limit","command":"kubectl set resources deploy/X --limits=cpu=2","validation":"throttling stops","rollback":"revert","source_id":"k8s-resource-management"},{"step":2,"action":"Or REMOVE limit","command":"# delete limits.cpu — let burstable pod use idle CPU","validation":"no throttling, possible noisy neighbor","rollback":"add back","source_id":"k8s-resource-management"}],"confidence":0.92,"last_verified":"2026-05-03","source_ids":["k8s-cgroups","k8s-resource-management"]},
  {"id":"k8s.fm.evicted-by-node-pressure","symptom":"Pods evicted with reason 'Evicted'; status.message about node-pressure","error_patterns":["Evicted","DiskPressure","MemoryPressure","node has condition"],"root_cause_class":"node-pressure","affected_concepts":["k8s.core.node-pressure-eviction","k8s.core.eviction"],"diagnostic_steps":[{"step":1,"action":"Find evicted pods","command":"kubectl get pods -A --field-selector=status.phase=Failed -o jsonpath='{range .items[?(@.status.reason==\"Evicted\")]}{.metadata.namespace}/{.metadata.name}{\"\\n\"}{end}'","expected":"list","source_id":"k8s-node-pressure-eviction"},{"step":2,"action":"Read node conditions","command":"kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{\": \"}{.status.conditions[?(@.type==\"DiskPressure\")].status}{\"\\n\"}{end}'","expected":"True if pressured","source_id":"k8s-node-pressure-eviction"},{"step":3,"action":"Check kubelet eviction config","command":"# on node: cat /var/lib/kubelet/config.yaml | grep -A 5 eviction","expected":"thresholds","source_id":"k8s-kubelet"}],"fix_steps":[{"step":1,"action":"Free up resources on node","command":"# scale down other pods, restart leaked-disk-using pods","validation":"node condition clears","rollback":null,"source_id":null},{"step":2,"action":"Tune eviction thresholds","command":"# kubelet config evictionHard: { nodefs.available: 5% }","validation":"less aggressive eviction","rollback":"restore","source_id":"k8s-node-pressure-eviction"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-node-pressure-eviction"]},
  {"id":"k8s.fm.rolling-update-stalled","symptom":"`kubectl rollout status` reports 'progressing' indefinitely","error_patterns":["progressing","ProgressDeadlineExceeded","not enough Ready"],"root_cause_class":"rollout","affected_concepts":["k8s.core.deployment-rollout"],"diagnostic_steps":[{"step":1,"action":"Check rollout status","command":"kubectl rollout status deploy/X --watch","expected":"hangs","source_id":"k8s-deployment"},{"step":2,"action":"Check new pods","command":"kubectl get pods -l app=X --sort-by=.metadata.creationTimestamp","expected":"new generation pods + state","source_id":"k8s-debug-application-cluster"},{"step":3,"action":"Check progressDeadlineSeconds","command":"kubectl get deploy X -o jsonpath='{.spec.progressDeadlineSeconds}'","expected":"600 default","source_id":"k8s-deployment"}],"fix_steps":[{"step":1,"action":"Roll back","command":"kubectl rollout undo deploy/X","validation":"old generation back","rollback":"rollout undo --to-revision=N","source_id":"k8s-deployment"},{"step":2,"action":"Fix new image","command":"# fix code/image; new push","validation":"new pods Ready","rollback":null,"source_id":null}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-deployment"]},
  {"id":"k8s.fm.statefulset-pod-stuck","symptom":"StatefulSet pod stuck Pending; subsequent ordinals can't proceed","error_patterns":["stuck on pod-N","ordinal blocked"],"root_cause_class":"orchestration","affected_concepts":["k8s.core.statefulset","k8s.core.statefulset-ordinal"],"diagnostic_steps":[{"step":1,"action":"Check problematic pod","command":"kubectl describe pod <sts>-N","expected":"FailedScheduling or volume issue","source_id":"k8s-statefulset"},{"step":2,"action":"Check podManagementPolicy","command":"kubectl get sts <name> -o jsonpath='{.spec.podManagementPolicy}'","expected":"OrderedReady (default) blocks rest","source_id":"k8s-statefulset"}],"fix_steps":[{"step":1,"action":"Fix the blocking pod","command":"# diagnose+fix per its events","validation":"pod-N becomes Ready, rest follows","rollback":null,"source_id":null},{"step":2,"action":"Or switch to Parallel","command":"# spec.podManagementPolicy: Parallel","validation":"all start at once","rollback":"revert","source_id":"k8s-statefulset"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-statefulset"]},
  {"id":"k8s.fm.kubeconfig-bad","symptom":"`kubectl: error: You must be logged in to the server`","error_patterns":["Unauthorized","invalid bearer token","x509: certificate has expired"],"root_cause_class":"auth","affected_concepts":["k8s.core.kubeconfig"],"diagnostic_steps":[{"step":1,"action":"Check current context","command":"kubectl config current-context","expected":"context name","source_id":"k8s-kubectl-overview"},{"step":2,"action":"Inspect cert expiry","command":"kubectl config view --raw -o jsonpath='{.users[?(@.name==\"USER\")].user.client-certificate-data}' | base64 -d | openssl x509 -noout -dates","expected":"notAfter date","source_id":"k8s-kubectl-overview"}],"fix_steps":[{"step":1,"action":"For exec credential plugin (cloud)","command":"# refresh: aws eks update-kubeconfig OR gcloud container clusters get-credentials","validation":"kubectl works","rollback":null,"source_id":null},{"step":2,"action":"For TLS bootstrap kubelet","command":"# kubeadm certs renew all (on master)","validation":"new cert valid","rollback":null,"source_id":null}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-kubectl-overview"]},
  {"id":"k8s.fm.rbac-permission-denied","symptom":"`Forbidden: User cannot list resource X in namespace Y`","error_patterns":["Forbidden","cannot list","cannot create","cannot get"],"root_cause_class":"rbac","affected_concepts":["k8s.core.rbac"],"diagnostic_steps":[{"step":1,"action":"Check who you are","command":"kubectl auth whoami","expected":"correct user","source_id":"k8s-rbac"},{"step":2,"action":"Check what you can do","command":"kubectl auth can-i --list -n <ns>","expected":"verbs you have","source_id":"k8s-rbac"},{"step":3,"action":"Find binding","command":"kubectl get rolebindings,clusterrolebindings -A -o json | jq '.items[] | select(.subjects[]?.name == \"<user>\")'","expected":"matching bindings","source_id":"k8s-rbac"}],"fix_steps":[{"step":1,"action":"Create role+binding","command":"kubectl create role read-pods --verb=get,list,watch --resource=pods; kubectl create rolebinding jane --role=read-pods --user=jane","validation":"can-i list pods returns yes","rollback":"kubectl delete role/binding","source_id":"k8s-rbac"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-rbac"]},
  {"id":"k8s.fm.configmap-not-updating","symptom":"ConfigMap edited but pod doesn't see new value","error_patterns":["stale config","old configmap","not picking up changes"],"root_cause_class":"configmap-mount","affected_concepts":["k8s.core.configmap"],"diagnostic_steps":[{"step":1,"action":"Check how cm is mounted","command":"kubectl get pod <pod> -o yaml | grep -A 10 envFrom","expected":"envFrom = env vars (won't update); volumeMounts = files (will update)","source_id":"k8s-configmap"},{"step":2,"action":"Verify cm has new value","command":"kubectl get cm <name> -o yaml","expected":"new value visible","source_id":"k8s-configmap"}],"fix_steps":[{"step":1,"action":"For env vars: restart pods","command":"kubectl rollout restart deploy/X","validation":"new env in new pods","rollback":null,"source_id":"k8s-deployment"},{"step":2,"action":"For mounted files: wait kubelet sync (~1min)","command":"# kubectl exec <pod> -- cat /path/to/mounted/file","validation":"new value","rollback":null,"source_id":"k8s-configmap"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-configmap"]},
  {"id":"k8s.fm.api-throttle","symptom":"`The server is currently unable to handle the request` or HTTP 429","error_patterns":["server is currently unable","429","Too Many Requests","priority and fairness"],"root_cause_class":"api-throttle","affected_concepts":["k8s.debugging.api-throttle"],"diagnostic_steps":[{"step":1,"action":"Check apiserver","command":"kubectl logs -n kube-system kube-apiserver-NODE | grep -i throttl","expected":"PriorityFairness rejections","source_id":"k8s-architecture"},{"step":2,"action":"Inspect FlowSchemas","command":"kubectl get flowschema -o yaml","expected":"matches per-user/group","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Reduce client request rate","command":"# add delays/backoff in client","validation":"no more 429","rollback":null,"source_id":null},{"step":2,"action":"Bump priority for client","command":"# create FlowSchema mapping client → high-priority PriorityLevelConfiguration","validation":"more concurrent capacity","rollback":"delete FS","source_id":"k8s-architecture"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-architecture"]},
