[
  {"id":"k8s.fm.validating-webhook-policy-rejects","symptom":"`kubectl apply` fails with 'admission webhook denied the request: <reason>'","error_patterns":["admission webhook denied","ValidatingAdmissionWebhook","policy"],"root_cause_class":"admission","affected_concepts":["k8s.core.admission-controller","k8s.core.api-server"],"diagnostic_steps":[{"step":1,"action":"Identify the webhook","command":"kubectl get validatingwebhookconfiguration -o jsonpath='{range .items[*]}{.metadata.name}{\"\\n\"}{end}'","expected":"webhook list","source_id":"k8s-architecture"},{"step":2,"action":"Inspect the policy that rejected","command":"# tools: kyverno: kubectl get clusterpolicy; gatekeeper: kubectl get constraints","expected":"matching rule","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Fix the manifest to satisfy the policy","command":"# add required label/annotation/securityContext per policy","validation":"apply succeeds","rollback":"revert manifest","source_id":"k8s-architecture"},{"step":2,"action":"Or, exempt the namespace if intentionally out-of-policy","command":"# kyverno: spec.exclude.namespaces; gatekeeper: match.excludedNamespaces","validation":"apply succeeds","rollback":"remove exemption","source_id":"k8s-architecture"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-architecture"]},
  {"id":"k8s.fm.mutating-webhook-conflict","symptom":"Multiple mutating webhooks fight over the same field; final state oscillates or last-one-wins","error_patterns":["mutating","webhook","conflict","oscillating"],"root_cause_class":"admission","affected_concepts":["k8s.core.admission-controller","k8s.core.api-server"],"diagnostic_steps":[{"step":1,"action":"List mutating webhooks + reinvocationPolicy","command":"kubectl get mutatingwebhookconfiguration -o yaml | grep -A2 reinvocationPolicy","expected":"IfNeeded triggers re-call after another mutator","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Set reinvocationPolicy: IfNeeded on each","command":"# webhooks: - reinvocationPolicy: IfNeeded","validation":"convergence","rollback":"Never","source_id":"k8s-architecture"},{"step":2,"action":"Long-term: only one mutating webhook per concern","command":"# audit and consolidate","validation":"no overlap","rollback":null,"source_id":"k8s-architecture"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-architecture"]},
  {"id":"k8s.fm.crd-conversion-webhook-fail","symptom":"`kubectl get <crd>` fails 'conversion webhook for <group>/<version>, Kind=<X> failed'","error_patterns":["conversion webhook","Failed","CustomResourceDefinition"],"root_cause_class":"crd","affected_concepts":["k8s.core.api-server","k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Inspect CRD versions + conversion strategy","command":"kubectl get crd <name> -o yaml | grep -A20 versions","expected":"webhook strategy with reachable service","source_id":"k8s-architecture"},{"step":2,"action":"Check the conversion service is up","command":"kubectl get svc -n <ns> <conversion-service>","expected":"endpoints present","source_id":"k8s-debug-services"}],"fix_steps":[{"step":1,"action":"Restart the conversion deployment","command":"kubectl rollout restart deploy/<webhook> -n <ns>","validation":"endpoints back","rollback":null,"source_id":"k8s-debug-services"},{"step":2,"action":"Or pin to single served+storage version (drop conversion webhook)","command":"# CRD: served: true on only the storage version","validation":"no conversion needed","rollback":"re-add versions","source_id":"k8s-architecture"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-architecture","k8s-debug-services"]},
  {"id":"k8s.fm.crd-openapi-validation-mismatch","symptom":"`kubectl apply` fails 'unknown field' or 'invalid' for a CRD field that should exist","error_patterns":["unknown field","Invalid value","openAPI","schema"],"root_cause_class":"crd","affected_concepts":["k8s.core.api-server"],"diagnostic_steps":[{"step":1,"action":"Inspect CRD's served version's schema","command":"kubectl get crd <name> -o yaml | grep -A100 openAPIV3Schema","expected":"the field is/isn't allowed in the served version","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Use the version your CRD allows","command":"# apiVersion: <group>/<version> matching CRD served version","validation":"apply succeeds","rollback":"prior version","source_id":"k8s-architecture"},{"step":2,"action":"Upgrade operator (CRD ships new version with the field)","command":"# helm upgrade <op> ...","validation":"new field present in CRD schema","rollback":"helm rollback","source_id":"k8s-architecture"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-architecture"]},
  {"id":"k8s.fm.controller-stuck-on-crd-finalizer","symptom":"Custom resource stuck Terminating; controller's finalizer never removed","error_patterns":["finalizer","Terminating","CRD","custom resource"],"root_cause_class":"finalizer","affected_concepts":["k8s.core.finalizer","k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Inspect","command":"kubectl get <crd> <name> -n <ns> -o yaml | grep -A2 finalizers","expected":"finalizer string identifies controller","source_id":"k8s-namespace"},{"step":2,"action":"Check controller pod is running","command":"kubectl get pods -n <ctrl-ns>","expected":"running; check logs for cleanup errors","source_id":"k8s-controller-pattern"}],"fix_steps":[{"step":1,"action":"Fix or restart controller","command":"kubectl rollout restart deploy/<controller> -n <ns>","validation":"finalizer removed normally","rollback":null,"source_id":"k8s-controller-pattern"},{"step":2,"action":"Last resort: patch out finalizer","command":"kubectl patch <crd> <name> -n <ns> -p '{\"metadata\":{\"finalizers\":null}}' --type=merge","validation":"object deletes","rollback":"can't","source_id":"k8s-namespace"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-namespace","k8s-controller-pattern"]},
  {"id":"k8s.fm.pdb-blocks-drain","symptom":"`kubectl drain` hangs or fails 'Cannot evict pod ... PodDisruptionBudget'","error_patterns":["PodDisruptionBudget","Cannot evict","drain","disruption"],"root_cause_class":"disruption","affected_concepts":["k8s.core.pod","k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Show PDB","command":"kubectl get pdb -A","expected":"min-available high enough to block drain","source_id":"k8s-scheduling-eviction"},{"step":2,"action":"Show pod count vs PDB","command":"kubectl get pdb <name> -o yaml","expected":"AllowedDisruptions=0","source_id":"k8s-scheduling-eviction"}],"fix_steps":[{"step":1,"action":"Scale up replicas before drain (so PDB allows N-1 evictions)","command":"kubectl scale deploy <name> --replicas=<higher>","validation":"AllowedDisruptions > 0","rollback":"scale back","source_id":"k8s-scheduling-eviction"},{"step":2,"action":"Or temporarily relax PDB","command":"kubectl patch pdb <name> -p '{\"spec\":{\"minAvailable\":1}}'","validation":"drain proceeds","rollback":"original min-available","source_id":"k8s-scheduling-eviction"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-scheduling-eviction"]},
  {"id":"k8s.fm.cluster-autoscaler-no-fit-pending","symptom":"Cluster Autoscaler scales up nodes but new node doesn't accept the Pending pod","error_patterns":["does not fit","unschedulable","scaleUp","still Pending"],"root_cause_class":"autoscale","affected_concepts":["k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Inspect CA logs for 'pod didn't fit' on the new node","command":"kubectl logs -n kube-system deploy/cluster-autoscaler --tail=300","expected":"NotEnough... reason","source_id":"k8s-architecture"},{"step":2,"action":"Compare pod requests + tolerations to node provisioning template","command":"# new node group has GPU? right CPU arch? right zone?","expected":"mismatch","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Adjust pod's nodeSelector/tolerations to match scaling group","command":"# spec.nodeSelector: kubernetes.io/arch: amd64","validation":"pod fits new node","rollback":"prior selector","source_id":"k8s-affinity"},{"step":2,"action":"Or add a new node group that fits the pod","command":"# Karpenter NodePool / EKS managed node group","validation":"matching node provisions","rollback":"remove group","source_id":"k8s-architecture"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-architecture","k8s-affinity"]}
