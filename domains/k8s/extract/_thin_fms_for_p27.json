[
	{"id":"k8s.fm.api-throttle","symptom":"`The server is currently unable to handle the request` or HTTP 429","root_cause_class":"api-throttle","error_patterns":["server is currently unable","429","Too Many Requests","priority and fairness"],"affected_concepts":["k8s.debugging.api-throttle"],"diagnostic_steps":[{"step":1,"action":"Check apiserver","command":"kubectl logs -n kube-system kube-apiserver-NODE | grep -i throttl","expected":"PriorityFairness rejections","source_id":"k8s-architecture"},{"step":2,"action":"Inspect FlowSchemas","command":"kubectl get flowschema -o yaml","expected":"matches per-user/group","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Reduce client request rate","command":"# add delays/backoff in client","validation":"no more 429","rollback":null,"source_id":null},{"step":2,"action":"Bump priority for client","command":"# create FlowSchema mapping client → high-priority PriorityLevelConfiguration","validation":"more concurrent capacity","rollback":"delete FS","source_id":"k8s-architecture"}],"confidence":0.85,"source_ids":["k8s-architecture"]},
	{"id":"k8s.fm.cluster-autoscaler-cooldown","symptom":"Cluster Autoscaler not scaling up despite Pending pods; 'recently failed' nodes excluded","root_cause_class":"autoscale","error_patterns":["scaleUpAttempted","unschedulable","cooldown"],"affected_concepts":["k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Inspect CA logs","command":"kubectl logs -n kube-system deploy/cluster-autoscaler","expected":"reasons for not scaling","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Tune --scale-down-delay-after-failure or --max-node-provision-time","command":"# CA flags: --scale-down-delay-after-failure=15m --max-node-provision-time=15m","validation":"CA recovers","rollback":"prior values","source_id":"k8s-architecture"}],"confidence":0.8,"source_ids":["k8s-architecture"]},
	{"id":"k8s.fm.cluster-autoscaler-no-fit-pending","symptom":"Cluster Autoscaler scales up nodes but new node doesn't accept the Pending pod","root_cause_class":"autoscale","error_patterns":["does not fit","unschedulable","scaleUp","still Pending"],"affected_concepts":["k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Inspect CA logs for 'pod didn't fit' on the new node","command":"kubectl logs -n kube-system deploy/cluster-autoscaler --tail=300","expected":"NotEnough... reason","source_id":"k8s-architecture"},{"step":2,"action":"Compare pod requests + tolerations to node provisioning template","command":"# new node group has GPU? right CPU arch? right zone?","expected":"mismatch","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Adjust pod's nodeSelector/tolerations to match scaling group","command":"# spec.nodeSelector: kubernetes.io/arch: amd64","validation":"pod fits new node","rollback":"prior selector","source_id":"k8s-affinity"},{"step":2,"action":"Or add a new node group that fits the pod","command":"# Karpenter NodePool / EKS managed node group","validation":"matching node provisions","rollback":"remove group","source_id":"k8s-architecture"}],"confidence":0.85,"source_ids":["k8s-architecture","k8s-affinity"]},
	{"id":"k8s.fm.cpu-throttled","symptom":"App slow but `kubectl top` shows low CPU","root_cause_class":"resource-limit","error_patterns":["throttled","cpu.stat throttled","high latency low utilization"],"affected_concepts":["k8s.core.cpu-throttling"],"diagnostic_steps":[{"step":1,"action":"Check container limits","command":"kubectl describe pod <pod> | grep -A 3 Limits","expected":"cpu: <quota>","source_id":"k8s-resource-management"},{"step":2,"action":"Read container's cpu.stat","command":"kubectl debug node/<node> -it --image=busybox; cat /sys/fs/cgroup/kubepods.slice/.../cpu.stat","expected":"nr_throttled / throttled_usec","source_id":"k8s-cgroups"}],"fix_steps":[{"step":1,"action":"Raise CPU limit","command":"kubectl set resources deploy/X --limits=cpu=2","validation":"throttling stops","rollback":"revert","source_id":"k8s-resource-management"},{"step":2,"action":"Or REMOVE limit","command":"# delete limits.cpu — let burstable pod use idle CPU","validation":"no throttling, possible noisy neighbor","rollback":"add back","source_id":"k8s-resource-management"}],"confidence":0.92,"source_ids":["k8s-cgroups","k8s-resource-management"]},
	{"id":"k8s.fm.crd-conversion-webhook-fail","symptom":"`kubectl get <crd>` fails 'conversion webhook for <group>/<version>, Kind=<X> failed'","root_cause_class":"crd","error_patterns":["conversion webhook","Failed","CustomResourceDefinition"],"affected_concepts":["k8s.core.api-server","k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Inspect CRD versions + conversion strategy","command":"kubectl get crd <name> -o yaml | grep -A20 versions","expected":"webhook strategy with reachable service","source_id":"k8s-architecture"},{"step":2,"action":"Check the conversion service is up","command":"kubectl get svc -n <ns> <conversion-service>","expected":"endpoints present","source_id":"k8s-debug-services"}],"fix_steps":[{"step":1,"action":"Restart the conversion deployment","command":"kubectl rollout restart deploy/<webhook> -n <ns>","validation":"endpoints back","rollback":null,"source_id":"k8s-debug-services"},{"step":2,"action":"Or pin to single served+storage version (drop conversion webhook)","command":"# CRD: served: true on only the storage version","validation":"no conversion needed","rollback":"re-add versions","source_id":"k8s-architecture"}],"confidence":0.85,"source_ids":["k8s-architecture","k8s-debug-services"]},
	{"id":"k8s.fm.crd-openapi-validation-mismatch","symptom":"`kubectl apply` fails 'unknown field' or 'invalid' for a CRD field that should exist","root_cause_class":"crd","error_patterns":["unknown field","Invalid value","openAPI","schema"],"affected_concepts":["k8s.core.api-server"],"diagnostic_steps":[{"step":1,"action":"Inspect CRD's served version's schema","command":"kubectl get crd <name> -o yaml | grep -A100 openAPIV3Schema","expected":"the field is/isn't allowed in the served version","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Use the version your CRD allows","command":"# apiVersion: <group>/<version> matching CRD served version","validation":"apply succeeds","rollback":"prior version","source_id":"k8s-architecture"},{"step":2,"action":"Upgrade operator (CRD ships new version with the field)","command":"# helm upgrade <op> ...","validation":"new field present in CRD schema","rollback":"helm rollback","source_id":"k8s-architecture"}],"confidence":0.9,"source_ids":["k8s-architecture"]},
	{"id":"k8s.fm.crictl-ps-empty","symptom":"`crictl ps` returns empty even though kubelet runs pods","root_cause_class":"runtime-debug","error_patterns":["crictl","ps","empty","not connected"],"affected_concepts":["k8s.debugging.crictl","k8s.runtime.cri"],"diagnostic_steps":[{"step":1,"action":"Show endpoint","command":"sudo crictl info | head","expected":"runtime endpoint listed","source_id":"k8s-crictl"}],"fix_steps":[{"step":1,"action":"Set the right runtime endpoint","command":"# /etc/crictl.yaml: runtime-endpoint: unix:///run/containerd/containerd.sock","validation":"crictl ps lists pods","rollback":"prior endpoint","source_id":"k8s-crictl"}],"confidence":0.95,"source_ids":["k8s-crictl"]},
	{"id":"k8s.fm.cronjob-startingdeadline-skipped","symptom":"CronJob doesn't run despite schedule firing; startingDeadlineSeconds expired","root_cause_class":"cron","error_patterns":["StartingDeadline","missed","skipped CronJob"],"affected_concepts":["k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Check","command":"kubectl describe cronjob <name>","expected":"events: 'Cannot determine if job needs to be started'","source_id":"k8s-cronjob"}],"fix_steps":[{"step":1,"action":"Bump startingDeadlineSeconds","command":"# spec.startingDeadlineSeconds: 600","validation":"missed runs trigger when controller wakes","rollback":"=200","source_id":"k8s-cronjob"},{"step":2,"action":"Check controller-manager health","command":"kubectl logs -n kube-system kube-controller-manager-...","validation":null,"rollback":null,"source_id":"k8s-architecture"}],"confidence":0.85,"source_ids":["k8s-cronjob","k8s-architecture"]},
	{"id":"k8s.fm.cronjob-ttl-cleaning-too-aggressive","symptom":"CronJob's pods/jobs immediately deleted; can't inspect failed runs","root_cause_class":"cron","error_patterns":["TTL","not found","CronJob","disappeared"],"affected_concepts":["k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Inspect","command":"kubectl get cronjob <name> -o yaml | grep -E 'ttl|successfulJobsHistoryLimit|failedJobsHistoryLimit'","expected":"limits too low","source_id":"k8s-cronjob"}],"fix_steps":[{"step":1,"action":"Raise history limits","command":"# spec: successfulJobsHistoryLimit: 5, failedJobsHistoryLimit: 5","validation":"old jobs retained","rollback":"=1","source_id":"k8s-cronjob"},{"step":2,"action":"Or set TTLSecondsAfterFinished higher","command":"# spec.jobTemplate.spec.ttlSecondsAfterFinished: 86400","validation":"jobs available 1 day","rollback":"shorter","source_id":"k8s-job"}],"confidence":0.9,"source_ids":["k8s-cronjob","k8s-job"]},
	{"id":"k8s.fm.daemonset-rolling-update-stuck","symptom":"DaemonSet OnDelete or RollingUpdate not progressing on some nodes","root_cause_class":"orchestration","error_patterns":["OnDelete","DaemonSet","not updated","status.numberMisscheduled"],"affected_concepts":["k8s.core.controller","k8s.runtime.kubelet"],"diagnostic_steps":[{"step":1,"action":"Inspect DS rollout","command":"kubectl rollout status ds/<name> -n <ns>","expected":"shows blocked nodes","source_id":"k8s-daemonset"},{"step":2,"action":"Check per-node status","command":"kubectl get pods -l name=<ds> -o wide","expected":"some nodes missing pod","source_id":"k8s-daemonset"}],"fix_steps":[{"step":1,"action":"Bump DS update strategy maxUnavailable","command":"# spec.updateStrategy.rollingUpdate.maxUnavailable: 30%","validation":"more concurrent rollout","rollback":"=1","source_id":"k8s-daemonset"},{"step":2,"action":"Force-delete stuck pod","command":"kubectl delete pod <name> -n <ns> --force --grace-period=0","validation":"DS recreates","rollback":null,"source_id":"k8s-daemonset"}],"confidence":0.85,"source_ids":["k8s-daemonset"]},
	{"id":"k8s.fm.deployment-stuck-ConditionPaused","symptom":"`kubectl rollout status` reports 'paused'; pods don't update","root_cause_class":"rollout","error_patterns":["paused","rollout","Deployment","spec.paused"],"affected_concepts":["k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Show pause state","command":"kubectl get deploy <name> -o jsonpath='{.spec.paused}'","expected":"true","source_id":"k8s-deployment"}],"fix_steps":[{"step":1,"action":"Resume","command":"kubectl rollout resume deploy/<name>","validation":"new pods roll out","rollback":"kubectl rollout pause deploy/<name>","source_id":"k8s-deployment"}],"confidence":0.95,"source_ids":["k8s-deployment"]},
	{"id":"k8s.fm.endpoints-not-updating","symptom":"Service endpoints don't reflect ready pods; clients hit dead pods","root_cause_class":"endpoint","error_patterns":["endpoints","not ready","stale","NotReadyAddresses"],"affected_concepts":["k8s.networking.endpoint-slice-controller","k8s.networking.endpoints"],"diagnostic_steps":[{"step":1,"action":"Inspect endpoints","command":"kubectl get endpointslices -l kubernetes.io/service-name=<svc>","expected":"addresses reflect ready pods","source_id":"k8s-endpoints-endpointslice"},{"step":2,"action":"Check pod readiness","command":"kubectl get pod -l app=<svc> -o wide","expected":"READY=true","source_id":"k8s-probes"}],"fix_steps":[{"step":1,"action":"Fix readiness probe (often the root cause)","command":"# spec.containers[].readinessProbe.httpGet.path","validation":"pod READY=true; endpoints update","rollback":"prior probe","source_id":"k8s-probes"},{"step":2,"action":"Restart kube-proxy if endpoint controller falls behind","command":"kubectl rollout restart -n kube-system ds/kube-proxy","validation":"endpoints sync","rollback":null,"source_id":"k8s-kube-proxy"}],"confidence":0.85,"source_ids":["k8s-endpoints-endpointslice","k8s-probes","k8s-kube-proxy"]},
	{"id":"k8s.fm.ephemeral-container-debug-not-supported","symptom":"`kubectl debug` fails 'ephemeral containers feature is not enabled'","root_cause_class":"debug","error_patterns":["ephemeral container","not enabled","feature gate"],"affected_concepts":["k8s.debugging.kubectl-debug-feature","k8s.core.kubelet"],"diagnostic_steps":[{"step":1,"action":"Check feature gate (GA in 1.25)","command":"kubectl get --raw /api/v1/nodes/<n>/proxy/configz | jq '.kubeletconfig.featureGates'","expected":"EphemeralContainers true (default >=1.25)","source_id":"k8s-ephemeral-containers"}],"fix_steps":[{"step":1,"action":"Upgrade cluster to >=1.25","command":"# upgrade per cluster ops","validation":"feature on by default","rollback":"downgrade","source_id":"k8s-ephemeral-containers"},{"step":2,"action":"Workaround: kubectl exec with sidecar","command":"# patch pod to inject debug image as initContainer","validation":"manual debug","rollback":null,"source_id":"k8s-debug-running-pod"}],"confidence":0.9,"source_ids":["k8s-ephemeral-containers","k8s-debug-running-pod"]},
	{"id":"k8s.fm.eviction-soft-vs-hard","symptom":"Memory eviction triggers wrong pods; system pods evicted","root_cause_class":"eviction","error_patterns":["soft eviction","hard eviction","grace period","priority"],"affected_concepts":["k8s.runtime.kubelet-config","k8s.core.kubelet"],"diagnostic_steps":[{"step":1,"action":"Show eviction thresholds","command":"kubectl get --raw /api/v1/nodes/<n>/proxy/configz | jq '.kubeletconfig | {evictionHard,evictionSoft,evictionSoftGracePeriod}'","expected":"thresholds","source_id":"k8s-node-pressure-eviction"}],"fix_steps":[{"step":1,"action":"Use soft thresholds with grace + priority classes for protection","command":"# kubeletConfig: evictionSoft: {memory.available: 500Mi}, evictionSoftGracePeriod: {memory.available: 1m30s}","validation":"warning before hard eviction","rollback":"only hard","source_id":"k8s-node-pressure-eviction"}],"confidence":0.85,"source_ids":["k8s-node-pressure-eviction"]},
	{"id":"k8s.fm.finalizer-stuck-namespace","symptom":"Namespace stuck Terminating for hours; resources have finalizers","root_cause_class":"finalizer","error_patterns":["Terminating","finalizer","cannot delete","Conflict"],"affected_concepts":["k8s.core.finalizer","k8s.core.namespace"],"diagnostic_steps":[{"step":1,"action":"List remaining objects","command":"kubectl api-resources --verbs=list --namespaced -o name | xargs -n1 kubectl get -n <ns>","expected":"objects with finalizers","source_id":"k8s-namespace"},{"step":2,"action":"Inspect","command":"kubectl get <type> <name> -n <ns> -o yaml | grep -A2 finalizers","expected":"finalizer string","source_id":"k8s-namespace"}],"fix_steps":[{"step":1,"action":"Resolve the finalizer's owner first (operator/controller for that resource)","command":"# uninstall the operator if removed; or fix RBAC so it can clean up","validation":"finalizer removed naturally","rollback":null,"source_id":"k8s-namespace"},{"step":2,"action":"Last resort: patch out finalizer (data risk)","command":"kubectl patch <type> <name> -n <ns> -p '{\"metadata\":{\"finalizers\":null}}' --type=merge","validation":"object deletes","rollback":"can't","source_id":"k8s-namespace"}],"confidence":0.9,"source_ids":["k8s-namespace"]},
	{"id":"k8s.fm.gateway-route-not-attached","symptom":"Gateway API HTTPRoute exists but traffic doesn't route; status shows 'NotAttached'","root_cause_class":"gateway","error_patterns":["NotAttached","Gateway","HTTPRoute","ParentRef"],"affected_concepts":["k8s.networking.ingress-controller","k8s.networking.gateway-api"],"diagnostic_steps":[{"step":1,"action":"Inspect","command":"kubectl describe httproute <name>","expected":"status.parents shows acceptance status","source_id":"k8s-gateway-api"}],"fix_steps":[{"step":1,"action":"Make HTTPRoute's namespace allowed by Gateway listener","command":"# Gateway.spec.listeners[].allowedRoutes.namespaces.from: All  # OR Selector","validation":"route attaches","rollback":"From: Same","source_id":"k8s-gateway-api"}],"confidence":0.85,"source_ids":["k8s-gateway-api"]},
	{"id":"k8s.fm.ingress-404","symptom":"Ingress returns 404 for valid path","root_cause_class":"routing","error_patterns":["404 Not Found","default backend"],"affected_concepts":["k8s.networking.ingress"],"diagnostic_steps":[{"step":1,"action":"Verify Host header matches","command":"curl -H 'Host: example.com' http://<ingress-ip>/path","expected":"non-404","source_id":"k8s-ingress"},{"step":2,"action":"Check Ingress spec","command":"kubectl get ingress <name> -o yaml","expected":"correct host + path","source_id":"k8s-ingress"},{"step":3,"action":"Check ingress controller logs","command":"kubectl logs -n ingress-nginx -l app.kubernetes.io/name=ingress-nginx","expected":"sees request","source_id":"k8s-ingress"},{"step":4,"action":"Check pathType","command":"# Prefix vs Exact matters","expected":null,"source_id":"k8s-ingress"}],"fix_steps":[{"step":1,"action":"Fix host/path","command":"kubectl edit ingress <name>","validation":"requests routed","rollback":"git revert","source_id":"k8s-ingress"}],"confidence":0.85,"source_ids":["k8s-ingress","k8s-debug-services"]},
	{"id":"k8s.fm.ingress-tls-secret-missing","symptom":"Ingress shows 'failed to get certificate'; TLS endpoint not reachable","root_cause_class":"ingress","error_patterns":["TLS","certificate","secret","Ingress"],"affected_concepts":["k8s.networking.ingress-controller","k8s.core.secret"],"diagnostic_steps":[{"step":1,"action":"Inspect","command":"kubectl describe ingress <name>","expected":"events: TLS secret 'foo' not found in namespace","source_id":"k8s-ingress"}],"fix_steps":[{"step":1,"action":"Create secret in same namespace as ingress","command":"kubectl create secret tls foo --cert=tls.crt --key=tls.key -n <ns>","validation":"ingress endpoint serves","rollback":"kubectl delete secret foo","source_id":"k8s-ingress"}],"confidence":0.95,"source_ids":["k8s-ingress"]},
	{"id":"k8s.fm.init-container-stuck","symptom":"Pod stuck PodInitializing; init container exit code or running indefinitely","root_cause_class":"init-container","error_patterns":["PodInitializing","init","CrashLoopBackOff init"],"affected_concepts":["k8s.core.init-container","k8s.debugging.troubleshoot-init-pattern"],"diagnostic_steps":[{"step":1,"action":"Inspect","command":"kubectl logs <pod> -c <init>; kubectl describe pod <pod>","expected":"init logs + restart count","source_id":"k8s-init-containers"}],"fix_steps":[{"step":1,"action":"Fix init script (often blocked on external dep)","command":"# add curl --max-time, retries, real probes","validation":"init exits 0","rollback":null,"source_id":"k8s-init-containers"}],"confidence":0.9,"source_ids":["k8s-init-containers","k8s-troubleshoot-init-containers"]},
	{"id":"k8s.fm.kube-proxy-ipvs-out-of-sync","symptom":"`kubectl get svc` shows ClusterIP yet ipvsadm doesn't list real servers","root_cause_class":"networking","error_patterns":["ipvsadm","not synced","kube-proxy ipvs","Realserver"],"affected_concepts":["k8s.networking.kube-proxy-ipvs","k8s.runtime.kube-proxy"],"diagnostic_steps":[{"step":1,"action":"Inspect kube-proxy logs","command":"kubectl logs -n kube-system -l k8s-app=kube-proxy --tail=200","expected":"errors syncing IPVS","source_id":"k8s-kube-proxy"}],"fix_steps":[{"step":1,"action":"Restart kube-proxy ds","command":"kubectl rollout restart -n kube-system ds/kube-proxy","validation":"ipvsadm shows endpoints","rollback":null,"source_id":"k8s-kube-proxy"},{"step":2,"action":"Verify ipvs kernel modules loaded","command":"lsmod | grep ip_vs","validation":null,"rollback":null,"source_id":"k8s-kube-proxy"}],"confidence":0.85,"source_ids":["k8s-kube-proxy"]},
	{"id":"k8s.fm.kube-reserved-too-low","symptom":"Node thrashes / OOMs system processes when pods near capacity","root_cause_class":"node-config","error_patterns":["kube-reserved","system.slice OOM","node pressure","kubelet"],"affected_concepts":["k8s.runtime.kubelet-config","k8s.core.kubelet"],"diagnostic_steps":[{"step":1,"action":"Check current reserved","command":"kubectl get --raw /api/v1/nodes/<n>/proxy/configz | jq .kubeletconfig.kubeReserved","expected":"e.g. {cpu:100m, memory:256Mi}","source_id":"k8s-resource-management"},{"step":2,"action":"Inspect node allocatable","command":"kubectl describe node <n>","expected":"Allocatable < Capacity","source_id":"k8s-node-pressure-eviction"}],"fix_steps":[{"step":1,"action":"Raise kube-reserved + system-reserved in kubelet config","command":"# kubeletConfig: kubeReserved: {cpu: 500m, memory: 1Gi}, systemReserved: {cpu: 500m, memory: 1Gi}","validation":"node has clear headroom","rollback":"prior values","source_id":"k8s-node-pressure-eviction"}],"confidence":0.9,"source_ids":["k8s-node-pressure-eviction","k8s-resource-management"]},
	{"id":"k8s.fm.kubeconfig-bad","symptom":"`kubectl: error: You must be logged in to the server`","root_cause_class":"auth","error_patterns":["Unauthorized","invalid bearer token","x509: certificate has expired"],"affected_concepts":["k8s.core.kubeconfig"],"diagnostic_steps":[{"step":1,"action":"Check current context","command":"kubectl config current-context","expected":"context name","source_id":"k8s-kubectl-overview"},{"step":2,"action":"Inspect cert expiry","command":"kubectl config view --raw -o jsonpath='{.users[?(@.name==\"USER\")].user.client-certificate-data}' | base64 -d | openssl x509 -noout -dates","expected":"notAfter date","source_id":"k8s-kubectl-overview"}],"fix_steps":[{"step":1,"action":"For exec credential plugin (cloud)","command":"# refresh: aws eks update-kubeconfig OR gcloud container clusters get-credentials","validation":"kubectl works","rollback":null,"source_id":null},{"step":2,"action":"For TLS bootstrap kubelet","command":"# kubeadm certs renew all (on master)","validation":"new cert valid","rollback":null,"source_id":null}],"confidence":0.85,"source_ids":["k8s-kubectl-overview"]},
	{"id":"k8s.fm.kubelet-image-gc-thrash","symptom":"Kubelet aggressively garbage-collects images; subsequent pulls slow","root_cause_class":"kubelet","error_patterns":["ImageGC","high disk","thrashing"],"affected_concepts":["k8s.runtime.kubelet-config","k8s.runtime.kubelet"],"diagnostic_steps":[{"step":1,"action":"Show GC thresholds","command":"kubectl get --raw /api/v1/nodes/<n>/proxy/configz | jq '.kubeletconfig | {imageMinimumGCAge,imageGCHighThresholdPercent,imageGCLowThresholdPercent}'","expected":"high=85, low=80 default","source_id":"k8s-kubelet"}],"fix_steps":[{"step":1,"action":"Raise high/low thresholds + age","command":"# kubeletConfig: imageGCHighThresholdPercent: 90, imageGCLowThresholdPercent: 85, imageMinimumGCAge: 2m0s","validation":"GC less aggressive","rollback":"prior","source_id":"k8s-kubelet"},{"step":2,"action":"Add disk to node","command":"# expand /var/lib/containerd","validation":"more headroom","rollback":null,"source_id":"k8s-kubelet"}],"confidence":0.85,"source_ids":["k8s-kubelet"]},
	{"id":"k8s.fm.kubelet-tls-bootstrap-fail","symptom":"New nodes fail to join: kubelet logs 'Unable to register node ... certificate'","root_cause_class":"node-join","error_patterns":["unable to register","certificate","TLS bootstrap"],"affected_concepts":["k8s.runtime.kubelet-tls","k8s.runtime.kubelet-config"],"diagnostic_steps":[{"step":1,"action":"Inspect","command":"sudo journalctl -u kubelet | grep -i bootstrap","expected":"reason: bootstrap-token expired or rejected","source_id":"k8s-kubelet"}],"fix_steps":[{"step":1,"action":"Generate new bootstrap token","command":"sudo kubeadm token create --print-join-command","validation":"join works","rollback":"kubeadm token delete","source_id":"k8s-kubelet"},{"step":2,"action":"Approve pending CSRs","command":"kubectl get csr; kubectl certificate approve <name>","validation":"node Ready","rollback":"kubectl certificate deny","source_id":"k8s-kubelet"}],"confidence":0.9,"source_ids":["k8s-kubelet"]},
	{"id":"k8s.fm.mutating-webhook-conflict","symptom":"Multiple mutating webhooks fight over the same field; final state oscillates or last-one-wins","root_cause_class":"admission","error_patterns":["mutating","webhook","conflict","oscillating"],"affected_concepts":["k8s.core.admission-controller","k8s.core.api-server"],"diagnostic_steps":[{"step":1,"action":"List mutating webhooks + reinvocationPolicy","command":"kubectl get mutatingwebhookconfiguration -o yaml | grep -A2 reinvocationPolicy","expected":"IfNeeded triggers re-call after another mutator","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Set reinvocationPolicy: IfNeeded on each","command":"# webhooks: - reinvocationPolicy: IfNeeded","validation":"convergence","rollback":"Never","source_id":"k8s-architecture"},{"step":2,"action":"Long-term: only one mutating webhook per concern","command":"# audit and consolidate","validation":"no overlap","rollback":null,"source_id":"k8s-architecture"}],"confidence":0.85,"source_ids":["k8s-architecture"]},
	{"id":"k8s.fm.node-not-ready-cni-not-ready","symptom":"Node NotReady; kubelet says 'cni plugin not initialized' or 'network plugin returns error'","root_cause_class":"cni","error_patterns":["cni plugin","not initialized","network plugin"],"affected_concepts":["k8s.networking.cni","k8s.runtime.kubelet-cni-call"],"diagnostic_steps":[{"step":1,"action":"List CNI binaries","command":"sudo ls /opt/cni/bin/","expected":"calico/cilium/flannel binary present","source_id":"k8s-cni"},{"step":2,"action":"Check /etc/cni/net.d","command":"sudo ls /etc/cni/net.d/","expected":"config files present","source_id":"k8s-cni"}],"fix_steps":[{"step":1,"action":"Install/restart CNI ds","command":"kubectl rollout restart -n kube-system ds/calico-node","validation":"node Ready","rollback":null,"source_id":"k8s-cni"}],"confidence":0.9,"source_ids":["k8s-cni"]},
	{"id":"k8s.fm.pod-overhead-not-accounted","symptom":"With RuntimeClass that has pod-overhead, scheduler skips overhead in resource calc","root_cause_class":"runtime-class","error_patterns":["pod overhead","RuntimeClass","not accounted"],"affected_concepts":["k8s.runtime.runtime-class","k8s.core.kubelet"],"diagnostic_steps":[{"step":1,"action":"Inspect RuntimeClass","command":"kubectl get runtimeclass <name> -o yaml","expected":"overhead.podFixed.cpu/memory","source_id":"k8s-runtime-class"}],"fix_steps":[{"step":1,"action":"Make sure feature gate PodOverhead is enabled (GA in 1.24+, on by default)","command":"# kubelet --feature-gates=PodOverhead=true (legacy)","validation":"node allocatable accounts for overhead","rollback":"disable","source_id":"k8s-runtime-class"}],"confidence":0.85,"source_ids":["k8s-runtime-class","k8s-pod-overhead"]},
	{"id":"k8s.fm.qos-class-burstable-eviction","symptom":"Burstable QoS pods evicted before guaranteed pods under memory pressure","root_cause_class":"eviction","error_patterns":["Evicted","Burstable","memory pressure"],"affected_concepts":["k8s.runtime.qos-cgroup","k8s.core.limits"],"diagnostic_steps":[{"step":1,"action":"Inspect pod QoS","command":"kubectl get pod <p> -o jsonpath='{.status.qosClass}'","expected":"Burstable/Guaranteed/BestEffort","source_id":"k8s-quality-of-service"}],"fix_steps":[{"step":1,"action":"For survivability: set requests=limits (Guaranteed)","command":"# spec.containers[].resources: requests==limits","validation":"qosClass=Guaranteed","rollback":"requests<limits","source_id":"k8s-quality-of-service"}],"confidence":0.95,"source_ids":["k8s-quality-of-service","k8s-node-pressure-eviction"]},
	{"id":"k8s.fm.rbac-permission-denied","symptom":"`Forbidden: User cannot list resource X in namespace Y`","root_cause_class":"rbac","error_patterns":["Forbidden","cannot list","cannot create","cannot get"],"affected_concepts":["k8s.core.rbac"],"diagnostic_steps":[{"step":1,"action":"Check who you are","command":"kubectl auth whoami","expected":"correct user","source_id":"k8s-rbac"},{"step":2,"action":"Check what you can do","command":"kubectl auth can-i --list -n <ns>","expected":"verbs you have","source_id":"k8s-rbac"},{"step":3,"action":"Find binding","command":"kubectl get rolebindings,clusterrolebindings -A -o json | jq '.items[] | select(.subjects[]?.name == \"<user>\")'","expected":"matching bindings","source_id":"k8s-rbac"}],"fix_steps":[{"step":1,"action":"Create role+binding","command":"kubectl create role read-pods --verb=get,list,watch --resource=pods; kubectl create rolebinding jane --role=read-pods --user=jane","validation":"can-i list pods returns yes","rollback":"kubectl delete role/binding","source_id":"k8s-rbac"}],"confidence":0.95,"source_ids":["k8s-rbac"]},
	{"id":"k8s.fm.replicaset-conflict-multi-owners","symptom":"Pod has multiple owner references; controllers fight to delete it","root_cause_class":"controller","error_patterns":["owner","conflict","ReplicaSet","two controllers"],"affected_concepts":["k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Inspect pod ownerReferences","command":"kubectl get pod <p> -o yaml | grep -A3 ownerReferences","expected":"single owner","source_id":"k8s-controller-pattern"}],"fix_steps":[{"step":1,"action":"Adopt one controller as the owner; delete duplicate ReplicaSet","command":"kubectl delete rs <duplicate>","validation":"single owner","rollback":null,"source_id":"k8s-replicaset"}],"confidence":0.8,"source_ids":["k8s-replicaset","k8s-controller-pattern"]},
	{"id":"k8s.fm.scheduler-preempt-thrash","symptom":"PriorityClass preemption keeps churning pods; SLA pods evicted/restored repeatedly","root_cause_class":"scheduling","error_patterns":["preemption","preempted","PriorityClass","churn"],"affected_concepts":["k8s.core.controller","k8s.core.taint"],"diagnostic_steps":[{"step":1,"action":"Inspect priorities","command":"kubectl get priorityclass","expected":"diverse priorities competing","source_id":"k8s-scheduling-eviction"}],"fix_steps":[{"step":1,"action":"Add anti-preempt to system pods (PreemptionPolicy=Never)","command":"# PriorityClass.preemptionPolicy: Never","validation":"those pods never trigger preempt","rollback":"PreemptLowerPriority","source_id":"k8s-scheduling-eviction"},{"step":2,"action":"Right-size capacity / autoscale","command":"# add nodes via cluster autoscaler","validation":"contention reduced","rollback":null,"source_id":"k8s-resource-management"}],"confidence":0.8,"source_ids":["k8s-scheduling-eviction","k8s-resource-management"]},
	{"id":"k8s.fm.serviceaccount-token-not-mounted","symptom":"Pod can't reach apiserver; /var/run/secrets/kubernetes.io/serviceaccount missing","root_cause_class":"rbac-projection","error_patterns":["serviceAccountToken","not mounted","403"],"affected_concepts":["k8s.core.serviceaccount","k8s.core.security-context"],"diagnostic_steps":[{"step":1,"action":"Inspect pod spec","command":"kubectl get pod <p> -o yaml | grep -A3 automountServiceAccountToken","expected":"=false","source_id":"k8s-rbac"}],"fix_steps":[{"step":1,"action":"Set automountServiceAccountToken: true on the pod or SA","command":"# spec.automountServiceAccountToken: true","validation":"directory present","rollback":"=false","source_id":"k8s-rbac"},{"step":2,"action":"Use projected token (audience-bound, rotated)","command":"# spec.containers[].volumeMounts: projected serviceAccountToken volume","validation":"token rotated","rollback":null,"source_id":"k8s-rbac"}],"confidence":0.9,"source_ids":["k8s-rbac"]},
	{"id":"k8s.fm.statefulset-pod-stuck","symptom":"StatefulSet pod stuck Pending; subsequent ordinals can't proceed","root_cause_class":"orchestration","error_patterns":["stuck on pod-N","ordinal blocked"],"affected_concepts":["k8s.core.statefulset","k8s.core.statefulset-ordinal"],"diagnostic_steps":[{"step":1,"action":"Check problematic pod","command":"kubectl describe pod <sts>-N","expected":"FailedScheduling or volume issue","source_id":"k8s-statefulset"},{"step":2,"action":"Check podManagementPolicy","command":"kubectl get sts <name> -o jsonpath='{.spec.podManagementPolicy}'","expected":"OrderedReady (default) blocks rest","source_id":"k8s-statefulset"}],"fix_steps":[{"step":1,"action":"Fix the blocking pod","command":"# diagnose+fix per its events","validation":"pod-N becomes Ready, rest follows","rollback":null,"source_id":null},{"step":2,"action":"Or switch to Parallel","command":"# spec.podManagementPolicy: Parallel","validation":"all start at once","rollback":"revert","source_id":"k8s-statefulset"}],"confidence":0.85,"source_ids":["k8s-statefulset"]},
	{"id":"k8s.fm.svc-traffic-policy-local-no-endpoints","symptom":"Service with externalTrafficPolicy=Local drops all traffic when no local pod","root_cause_class":"networking","error_patterns":["external traffic","Local","no endpoints","drop"],"affected_concepts":["k8s.networking.external-traffic-policy-local","k8s.networking.kube-proxy-iptables"],"diagnostic_steps":[{"step":1,"action":"Show svc config + pod placement","command":"kubectl get svc <s> -o yaml | grep externalTrafficPolicy; kubectl get pods -l app=<s> -o wide","expected":"Local with pods only on some nodes","source_id":"k8s-service-traffic-policy"}],"fix_steps":[{"step":1,"action":"Use externalTrafficPolicy=Cluster (drops src IP, but always works)","command":"kubectl patch svc <s> -p '{\"spec\":{\"externalTrafficPolicy\":\"Cluster\"}}'","validation":"traffic flows","rollback":"=Local","source_id":"k8s-service-traffic-policy"},{"step":2,"action":"Or, ensure pods exist on every node (DaemonSet)","command":"# convert backend to DS","validation":"local pod everywhere","rollback":null,"source_id":"k8s-daemonset"}],"confidence":0.9,"source_ids":["k8s-service-traffic-policy"]}
