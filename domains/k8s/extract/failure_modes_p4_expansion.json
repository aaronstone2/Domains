[{"id":"k8s.fm.hpa-not-scaling","symptom":"HorizontalPodAutoscaler metric reads 'unknown' or pods don't scale despite load","error_patterns":["unknown metric","unable to fetch metrics","FailedGetResourceMetric"],"root_cause_class":"autoscale","affected_concepts":["k8s.core.controller","k8s.core.api-server"],"diagnostic_steps":[{"step":1,"action":"Inspect HPA","command":"kubectl describe hpa <name>","expected":"events show why it can't read metrics","source_id":"k8s-resource-metrics-pipeline"},{"step":2,"action":"Verify metrics-server running","command":"kubectl get apiservice v1beta1.metrics.k8s.io -o yaml","expected":"Available: True","source_id":"k8s-resource-metrics-pipeline"}],"fix_steps":[{"step":1,"action":"Install/repair metrics-server","command":"kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml","validation":"kubectl top pods works","rollback":"kubectl delete -f ...","source_id":"k8s-resource-metrics-pipeline"},{"step":2,"action":"Pod must declare resources.requests","command":"# spec.containers[].resources.requests.cpu","validation":"HPA can compute %","rollback":null,"source_id":"k8s-resource-management"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-resource-metrics-pipeline","k8s-resource-management"]},{"id":"k8s.fm.admission-webhook-timeout","symptom":"Pod creation hangs and times out: 'webhook denied: context deadline exceeded'","error_patterns":["webhook","context deadline exceeded","admission","timeout"],"root_cause_class":"admission","affected_concepts":["k8s.core.admission-controller","k8s.core.api-server"],"diagnostic_steps":[{"step":1,"action":"List admission webhooks","command":"kubectl get validatingwebhookconfiguration,mutatingwebhookconfiguration","expected":"webhooks installed","source_id":"k8s-architecture"},{"step":2,"action":"Inspect webhook target","command":"kubectl describe validatingwebhookconfiguration <name>","expected":"timeoutSeconds, failurePolicy, namespaceSelector","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Increase timeout (max 30s) or set failurePolicy=Ignore for non-critical","command":"# webhooks: - timeoutSeconds: 30, failurePolicy: Ignore","validation":"pod admission proceeds","rollback":"failurePolicy: Fail","source_id":"k8s-architecture"},{"step":2,"action":"Exclude kube-system to avoid cluster-startup deadlock","command":"# namespaceSelector: matchExpressions: [{key: kubernetes.io/metadata.name, operator: NotIn, values: [kube-system]}]","validation":"system pods unblocked","rollback":"remove selector","source_id":"k8s-architecture"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-architecture"]},{"id":"k8s.fm.etcd-defrag-needed","symptom":"etcd disk usage growing despite low key count; alarm 'NOSPACE'","error_patterns":["NOSPACE","etcd","fragmentation","slow watch"],"root_cause_class":"etcd","affected_concepts":["k8s.core.etcd","k8s.debugging.etcd-logs","k8s.debugging.etcd-slow-watch"],"diagnostic_steps":[{"step":1,"action":"Check space alarm","command":"sudo etcdctl --endpoints=... alarm list","expected":"alarm:NOSPACE","source_id":"k8s-architecture"},{"step":2,"action":"Show DB size","command":"sudo etcdctl endpoint status -w table","expected":"DB SIZE near quota (default 2GB)","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Compact + defragment per-member","command":"sudo etcdctl compact $(etcdctl endpoint status -w json | jq -r '.[].Status.header.revision'); sudo etcdctl defrag --cluster","validation":"DB SIZE drops","rollback":null,"source_id":"k8s-architecture"},{"step":2,"action":"Disarm alarm","command":"sudo etcdctl alarm disarm","validation":"alarm list empty","rollback":null,"source_id":"k8s-architecture"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-architecture"]},{"id":"k8s.fm.kubelet-pleg-unhealthy","symptom":"Node reports NotReady; kubelet logs 'PLEG is not healthy'","error_patterns":["PLEG is not healthy","pleg","unhealthy"],"root_cause_class":"kubelet","affected_concepts":["k8s.runtime.kubelet-pleg","k8s.runtime.kubelet","k8s.core.cri"],"diagnostic_steps":[{"step":1,"action":"Inspect","command":"sudo journalctl -u kubelet | grep -i pleg | tail","expected":"'PLEG: pod ... duration ... > 3m'","source_id":"k8s-kubelet"},{"step":2,"action":"Check container runtime","command":"sudo crictl ps --no-trunc","expected":"long list = backlog","source_id":"k8s-crictl"}],"fix_steps":[{"step":1,"action":"Restart container runtime","command":"sudo systemctl restart containerd","validation":"PLEG healthy in next minute","rollback":null,"source_id":"k8s-container-runtimes"},{"step":2,"action":"Reduce container churn (lower probe frequency, fix CrashLoopBackOff sources)","command":"# tune liveness probe periodSeconds","validation":"PLEG stays healthy","rollback":null,"source_id":"k8s-probes"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-kubelet","k8s-crictl","k8s-probes"]},{"id":"k8s.fm.cni-mtu-mismatch","symptom":"Pod-to-pod across nodes hangs on large payloads; small packets work","error_patterns":["mtu","fragmentation","tcp retransmit","cross-node"],"root_cause_class":"networking","affected_concepts":["k8s.networking.cni","k8s.networking.cni-plugin","k8s.networking.cluster-network-plugin"],"diagnostic_steps":[{"step":1,"action":"Pod ping with DF","command":"kubectl exec p1 -- ping -M do -s 1450 <pod2-ip>","expected":"identifies max working size","source_id":"k8s-cluster-networking"},{"step":2,"action":"Check CNI MTU","command":"kubectl get cm -n kube-system <cni-config> -o yaml | grep -i mtu","expected":"vs underlay MTU","source_id":"k8s-cni"}],"fix_steps":[{"step":1,"action":"Set CNI MTU = underlay-overhead (vxlan: 50, IPSec: 132)","command":"# Calico cm: veth_mtu: 1450; restart calico-node ds","validation":"large packets succeed","rollback":"prior value","source_id":"k8s-cni"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-cni","k8s-cluster-networking"]},{"id":"k8s.fm.finalizer-stuck-namespace","symptom":"Namespace stuck Terminating for hours; resources have finalizers","error_patterns":["Terminating","finalizer","cannot delete","Conflict"],"root_cause_class":"finalizer","affected_concepts":["k8s.core.finalizer","k8s.core.namespace"],"diagnostic_steps":[{"step":1,"action":"List remaining objects","command":"kubectl api-resources --verbs=list --namespaced -o name | xargs -n1 kubectl get -n <ns>","expected":"objects with finalizers","source_id":"k8s-namespace"},{"step":2,"action":"Inspect","command":"kubectl get <type> <name> -n <ns> -o yaml | grep -A2 finalizers","expected":"finalizer string","source_id":"k8s-namespace"}],"fix_steps":[{"step":1,"action":"Resolve the finalizer's owner first (operator/controller for that resource)","command":"# uninstall the operator if removed; or fix RBAC so it can clean up","validation":"finalizer removed naturally","rollback":null,"source_id":"k8s-namespace"},{"step":2,"action":"Last resort: patch out finalizer (data risk)","command":"kubectl patch <type> <name> -n <ns> -p '{\"metadata\":{\"finalizers\":null}}' --type=merge","validation":"object deletes","rollback":"can't","source_id":"k8s-namespace"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-namespace"]},{"id":"k8s.fm.pvc-resize-stuck","symptom":"Resized PVC stays at old size; pod sees old size","error_patterns":["resize","volume expansion","Pending","FileSystemResizePending"],"root_cause_class":"storage","affected_concepts":["k8s.core.storage-class","k8s.runtime.csi","k8s.debugging.csi-debug"],"diagnostic_steps":[{"step":1,"action":"Inspect PVC","command":"kubectl describe pvc <name>","expected":"FileSystemResizePending = waiting on next pod restart","source_id":"k8s-pv-pvc"},{"step":2,"action":"Check storage class supports expansion","command":"kubectl get storageclass <name> -o yaml | grep allowVolumeExpansion","expected":"=true","source_id":"k8s-storage-classes"}],"fix_steps":[{"step":1,"action":"Restart consuming pod (CSI completes resize on remount)","command":"kubectl rollout restart deploy/<app>","validation":"pod sees new size","rollback":null,"source_id":"k8s-pv-pvc"},{"step":2,"action":"For online expansion: ensure CSI driver supports it","command":"# check csi driver capabilities","validation":"yes","rollback":null,"source_id":"k8s-storage-classes"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-pv-pvc","k8s-storage-classes","k8s-debug-cluster"]},{"id":"k8s.fm.taint-toleration-mismatch","symptom":"Pods stuck Pending with FailedScheduling due to taint X but pod has toleration","error_patterns":["had taints","not tolerate","FailedScheduling","NoSchedule"],"root_cause_class":"scheduling","affected_concepts":["k8s.core.taint","k8s.core.toleration"],"diagnostic_steps":[{"step":1,"action":"Show taints","command":"kubectl get nodes -o custom-columns=NAME:.metadata.name,TAINTS:.spec.taints","expected":"node taints","source_id":"k8s-taints-tolerations"},{"step":2,"action":"Show pod tolerations","command":"kubectl get pod <p> -o yaml | grep -A20 tolerations","expected":"toleration must match key+value+effect","source_id":"k8s-taints-tolerations"}],"fix_steps":[{"step":1,"action":"Add matching toleration","command":"# spec.tolerations: - key: dedicated, value: gpu, effect: NoSchedule","validation":"pod schedules","rollback":"remove toleration","source_id":"k8s-taints-tolerations"},{"step":2,"action":"Or remove the taint","command":"kubectl taint nodes <node> <key>=<val>:NoSchedule-","validation":"pod schedules anywhere","rollback":"add taint back","source_id":"k8s-taints-tolerations"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-taints-tolerations"]},{"id":"k8s.fm.daemonset-rolling-update-stuck","symptom":"DaemonSet OnDelete or RollingUpdate not progressing on some nodes","error_patterns":["OnDelete","DaemonSet","not updated","status.numberMisscheduled"],"root_cause_class":"orchestration","affected_concepts":["k8s.core.controller","k8s.runtime.kubelet"],"diagnostic_steps":[{"step":1,"action":"Inspect DS rollout","command":"kubectl rollout status ds/<name> -n <ns>","expected":"shows blocked nodes","source_id":"k8s-daemonset"},{"step":2,"action":"Check per-node status","command":"kubectl get pods -l name=<ds> -o wide","expected":"some nodes missing pod","source_id":"k8s-daemonset"}],"fix_steps":[{"step":1,"action":"Bump DS update strategy maxUnavailable","command":"# spec.updateStrategy.rollingUpdate.maxUnavailable: 30%","validation":"more concurrent rollout","rollback":"=1","source_id":"k8s-daemonset"},{"step":2,"action":"Force-delete stuck pod","command":"kubectl delete pod <name> -n <ns> --force --grace-period=0","validation":"DS recreates","rollback":null,"source_id":"k8s-daemonset"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-daemonset"]},{"id":"k8s.fm.kube-reserved-too-low","symptom":"Node thrashes / OOMs system processes when pods near capacity","error_patterns":["kube-reserved","system.slice OOM","node pressure","kubelet"],"root_cause_class":"node-config","affected_concepts":["k8s.runtime.kubelet-config","k8s.core.kubelet"],"diagnostic_steps":[{"step":1,"action":"Check current reserved","command":"kubectl get --raw /api/v1/nodes/<n>/proxy/configz | jq .kubeletconfig.kubeReserved","expected":"e.g. {cpu:100m, memory:256Mi}","source_id":"k8s-resource-management"},{"step":2,"action":"Inspect node allocatable","command":"kubectl describe node <n>","expected":"Allocatable < Capacity","source_id":"k8s-node-pressure-eviction"}],"fix_steps":[{"step":1,"action":"Raise kube-reserved + system-reserved in kubelet config","command":"# kubeletConfig: kubeReserved: {cpu: 500m, memory: 1Gi}, systemReserved: {cpu: 500m, memory: 1Gi}","validation":"node has clear headroom","rollback":"prior values","source_id":"k8s-node-pressure-eviction"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-node-pressure-eviction","k8s-resource-management"]},{"id":"k8s.fm.scheduler-preempt-thrash","symptom":"PriorityClass preemption keeps churning pods; SLA pods evicted/restored repeatedly","error_patterns":["preemption","preempted","PriorityClass","churn"],"root_cause_class":"scheduling","affected_concepts":["k8s.core.controller","k8s.core.taint"],"diagnostic_steps":[{"step":1,"action":"Inspect priorities","command":"kubectl get priorityclass","expected":"diverse priorities competing","source_id":"k8s-scheduling-eviction"}],"fix_steps":[{"step":1,"action":"Add anti-preempt to system pods (PreemptionPolicy=Never)","command":"# PriorityClass.preemptionPolicy: Never","validation":"those pods never trigger preempt","rollback":"PreemptLowerPriority","source_id":"k8s-scheduling-eviction"},{"step":2,"action":"Right-size capacity / autoscale","command":"# add nodes via cluster autoscaler","validation":"contention reduced","rollback":null,"source_id":"k8s-resource-management"}],"confidence":0.8,"last_verified":"2026-05-03","source_ids":["k8s-scheduling-eviction","k8s-resource-management"]},{"id":"k8s.fm.coredns-loop-detection","symptom":"CoreDNS pods CrashLoopBackOff with 'Loop (127.0.0.1:53 -> :53)'","error_patterns":["Loop","loopback","plugin/loop","CoreDNS"],"root_cause_class":"dns","affected_concepts":["k8s.networking.coredns","k8s.networking.coredns-corefile"],"diagnostic_steps":[{"step":1,"action":"View Corefile","command":"kubectl get cm coredns -n kube-system -o yaml","expected":"forward . /etc/resolv.conf with host using 127.0.0.x","source_id":"k8s-dns"}],"fix_steps":[{"step":1,"action":"Use a real upstream","command":"# Corefile: forward . 1.1.1.1 9.9.9.9","validation":"loop detection clears","rollback":"forward . /etc/resolv.conf","source_id":"k8s-dns"},{"step":2,"action":"Or fix host resolv.conf to point upstream not localhost","command":"# replace 127.0.0.53 with real DNS in /run/systemd/resolve/resolv.conf","validation":"forward . /etc/resolv.conf safe","rollback":null,"source_id":"k8s-dns"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-dns"]},{"id":"k8s.fm.networkpolicy-default-deny-too-broad","symptom":"After applying NetworkPolicy, kube-system pods can't reach apiserver/coredns","error_patterns":["NetworkPolicy","blocked","kube-system","timeout"],"root_cause_class":"networking","affected_concepts":["k8s.networking.network-policy","k8s.networking.cluster-dns"],"diagnostic_steps":[{"step":1,"action":"Show effective policies","command":"kubectl get netpol -A","expected":"default-deny in many namespaces","source_id":"k8s-network-policies"}],"fix_steps":[{"step":1,"action":"Always allow egress to coredns","command":"# spec.egress: - to: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: kube-system}}, podSelector: {matchLabels: {k8s-app: kube-dns}}}], ports: [{port: 53, protocol: UDP}]","validation":"DNS works","rollback":null,"source_id":"k8s-network-policies"},{"step":2,"action":"Allow egress to apiserver","command":"# spec.egress: - to: [{ipBlock: {cidr: <apiserver-ip>/32}}], ports: [{port: 6443}]","validation":"sa client works","rollback":null,"source_id":"k8s-network-policies"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-network-policies"]},{"id":"k8s.fm.ingress-tls-secret-missing","symptom":"Ingress shows 'failed to get certificate'; TLS endpoint not reachable","error_patterns":["TLS","certificate","secret","Ingress"],"root_cause_class":"ingress","affected_concepts":["k8s.networking.ingress-controller","k8s.core.secret"],"diagnostic_steps":[{"step":1,"action":"Inspect","command":"kubectl describe ingress <name>","expected":"events: TLS secret 'foo' not found in namespace","source_id":"k8s-ingress"}],"fix_steps":[{"step":1,"action":"Create secret in same namespace as ingress","command":"kubectl create secret tls foo --cert=tls.crt --key=tls.key -n <ns>","validation":"ingress endpoint serves","rollback":"kubectl delete secret foo","source_id":"k8s-ingress"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-ingress"]},{"id":"k8s.fm.kubeconfig-context-wrong","symptom":"`kubectl` lands in wrong cluster (prod vs staging); accidental damage risk","error_patterns":["wrong cluster","kubeconfig","context"],"root_cause_class":"client-config","affected_concepts":["k8s.debugging.kubectl-debug-feature"],"diagnostic_steps":[{"step":1,"action":"Show context","command":"kubectl config current-context","expected":"verify against intent","source_id":"k8s-kubectl-overview"}],"fix_steps":[{"step":1,"action":"Switch","command":"kubectl config use-context staging","validation":"current-context updated","rollback":"use-context prod","source_id":"k8s-kubectl-overview"},{"step":2,"action":"Use kubectx + a shell prompt indicator","command":"# install kubectx; modify PS1 to show $(kubectl config current-context)","validation":"impossible to forget","rollback":null,"source_id":"k8s-kubectl-overview"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-kubectl-overview"]},{"id":"k8s.fm.crictl-ps-empty","symptom":"`crictl ps` returns empty even though kubelet runs pods","error_patterns":["crictl","ps","empty","not connected"],"root_cause_class":"runtime-debug","affected_concepts":["k8s.debugging.crictl","k8s.runtime.cri"],"diagnostic_steps":[{"step":1,"action":"Show endpoint","command":"sudo crictl info | head","expected":"runtime endpoint listed","source_id":"k8s-crictl"}],"fix_steps":[{"step":1,"action":"Set the right runtime endpoint","command":"# /etc/crictl.yaml: runtime-endpoint: unix:///run/containerd/containerd.sock","validation":"crictl ps lists pods","rollback":"prior endpoint","source_id":"k8s-crictl"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-crictl"]},{"id":"k8s.fm.pod-overhead-not-accounted","symptom":"With RuntimeClass that has pod-overhead, scheduler skips overhead in resource calc","error_patterns":["pod overhead","RuntimeClass","not accounted"],"root_cause_class":"runtime-class","affected_concepts":["k8s.runtime.runtime-class","k8s.core.kubelet"],"diagnostic_steps":[{"step":1,"action":"Inspect RuntimeClass","command":"kubectl get runtimeclass <name> -o yaml","expected":"overhead.podFixed.cpu/memory","source_id":"k8s-runtime-class"}],"fix_steps":[{"step":1,"action":"Make sure feature gate PodOverhead is enabled (GA in 1.24+, on by default)","command":"# kubelet --feature-gates=PodOverhead=true (legacy)","validation":"node allocatable accounts for overhead","rollback":"disable","source_id":"k8s-runtime-class"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["k8s-runtime-class","k8s-pod-overhead"]},{"id":"k8s.fm.serviceaccount-token-not-mounted","symptom":"Pod can't reach apiserver; /var/run/secrets/kubernetes.io/serviceaccount missing","error_patterns":["serviceAccountToken","not mounted","403"],"root_cause_class":"rbac-projection","affected_concepts":["k8s.core.serviceaccount","k8s.core.security-context"],"diagnostic_steps":[{"step":1,"action":"Inspect pod spec","command":"kubectl get pod <p> -o yaml | grep -A3 automountServiceAccountToken","expected":"=false","source_id":"k8s-rbac"}],"fix_steps":[{"step":1,"action":"Set automountServiceAccountToken: true on the pod or SA","command":"# spec.automountServiceAccountToken: true","validation":"directory present","rollback":"=false","source_id":"k8s-rbac"},{"step":2,"action":"Use projected token (audience-bound, rotated)","command":"# spec.containers[].volumeMounts: projected serviceAccountToken volume","validation":"token rotated","rollback":null,"source_id":"k8s-rbac"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["k8s-rbac"]},{"id":"k8s.fm.cluster-autoscaler-cooldown","symptom":"Cluster Autoscaler not scaling up despite Pending pods; 'recently failed' nodes excluded","error_patterns":["scaleUpAttempted","unschedulable","cooldown"],"root_cause_class":"autoscale","affected_concepts":["k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Inspect CA logs","command":"kubectl logs -n kube-system deploy/cluster-autoscaler","expected":"reasons for not scaling","source_id":"k8s-architecture"}],"fix_steps":[{"step":1,"action":"Tune --scale-down-delay-after-failure or --max-node-provision-time","command":"# CA flags: --scale-down-delay-after-failure=15m --max-node-provision-time=15m","validation":"CA recovers","rollback":"prior values","source_id":"k8s-architecture"}],"confidence":0.8,"last_verified":"2026-05-03","source_ids":["k8s-architecture"]},{"id":"k8s.fm.deployment-stuck-ConditionPaused","symptom":"`kubectl rollout status` reports 'paused'; pods don't update","error_patterns":["paused","rollout","Deployment","spec.paused"],"root_cause_class":"rollout","affected_concepts":["k8s.core.controller"],"diagnostic_steps":[{"step":1,"action":"Show pause state","command":"kubectl get deploy <name> -o jsonpath='{.spec.paused}'","expected":"true","source_id":"k8s-deployment"}],"fix_steps":[{"step":1,"action":"Resume","command":"kubectl rollout resume deploy/<name>","validation":"new pods roll out","rollback":"kubectl rollout pause deploy/<name>","source_id":"k8s-deployment"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["k8s-deployment"]},{"id":"k8s.fm.statefulset-volume-binding-stuck","symptom":"StatefulSet pod 0 stuck Pending with PVC unbound; subsequent ordinals can't proceed","error_patterns":["volume binding","PVC","Pending","statefulset"],"root_cause_class":"storage","affected_concepts":["k8s.core.storage-class","k8s.runtime.csi"],"diagnostic_steps":[{"step":1,"action":"Inspect PVC + StorageClass","command":"kubectl describe pvc <name>; kubectl get storageclass","expected":"events show binding failure","source_id":"k8s-storage-classes"},{"step":2,"action":"Check volumeBindingMode","command":"# Immediate vs WaitForFirstConsumer","expected":"WaitForFirstConsumer requires pod to be schedulable first","source_id":"k8s-storage-classes"}],"fix_steps":[{"step":1,"action":"Provision capacity / fix CSI driver","command":"# inspect CSI driver pods (csi-provisioner)","validation