  {
    "id": "firecracker.api.cmd.load-snapshot",
    "command": "PUT /snapshot/load",
    "purpose": "Restore VM state into a fresh Firecracker process. Must be the first API call after process start (no prior PUT /machine-config etc.).",
    "flags": [
      {"name": "snapshot_path", "value": "string", "doc": "Path to VM-state metadata file."},
