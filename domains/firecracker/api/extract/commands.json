    "examples": [{"invocation": "PUT /snapshot/create {\"snapshot_type\":\"Full\",\"snapshot_path\":\"/var/snap.bin\",\"mem_file_path\":\"/var/snap.mem\"}", "expected_output": "204; 400 if VM not Paused", "scenario": "Save microVM state"}],
    "source_ids": ["fc-swagger-spec", "fc-docs-snapshot-support"]
