    "examples": [{"invocation": "PUT /snapshot/load {\"snapshot_path\":\"/var/snap.bin\",\"mem_backend\":{\"backend_type\":\"File\",\"backend_path\":\"/var/snap.mem\"},\"resume_vm\":true}", "expected_output": "204; 400 if API was already touched", "scenario": "Restore microVM"}],
    "source_ids": ["fc-swagger-spec", "fc-docs-snapshot-support"]
