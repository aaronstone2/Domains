[
  {
    "id": "firecracker.api.cmd.describe-instance",
    "command": "GET /",
    "purpose": "Returns instance information: id, state (Not started|Running|Paused), vmm_version, app_name. The minimum-impact health check.",
    "flags": [],
    "examples": [{"invocation": "curl --unix-socket /tmp/firecracker.socket http://localhost/", "expected_output": "200 with InstanceInfo JSON", "scenario": "Health probe"}],
    "source_ids": ["fc-swagger-spec"]
  },
  {
    "id": "firecracker.api.cmd.create-sync-action",
    "command": "PUT /actions",
    "purpose": "Trigger a synchronous action: InstanceStart (boot the configured machine), SendCtrlAltDel (graceful guest shutdown via keyboard reset).",
    "flags": [{"name": "action_type", "value": "InstanceStart|SendCtrlAltDel|FlushMetrics", "doc": "Required. The action to perform."}],
    "examples": [{"invocation": "curl -X PUT --unix-socket /tmp/fc.sock http://localhost/actions -d '{\"action_type\":\"InstanceStart\"}'", "expected_output": "204 on success; 400 if pre-conditions unmet (e.g. no boot-source set)", "scenario": "Boot the configured microVM"}],
    "source_ids": ["fc-swagger-spec"]
  },
  {
    "id": "firecracker.api.cmd.put-guest-boot-source",
    "command": "PUT /boot-source",
    "purpose": "Set kernel image, boot args, and (optional) initrd path. Pre-boot only.",
    "flags": [
      {"name": "kernel_image_path", "value": "string (host path)", "doc": "Uncompressed Linux ELF/PE kernel."},
      {"name": "boot_args", "value": "string", "doc": "Kernel command line. Default: 'reboot=k panic=1 pci=off nomodule'."},
      {"name": "initrd_path", "value": "string|null", "doc": "Optional initrd."}
    ],
    "examples": [{"invocation": "PUT /boot-source {\"kernel_image_path\":\"/var/vmlinux\", \"boot_args\":\"console=ttyS0 reboot=k panic=1 pci=off\"}", "expected_output": "204", "scenario": "Configure kernel pre-boot"}],
    "source_ids": ["fc-swagger-spec", "fc-docs-rootfs-kernel"]
  },
  {
    "id": "firecracker.api.cmd.put-machine-config",
    "command": "PUT /machine-config",
    "purpose": "Set vCPU count, memory size, hyperthreading, dirty-page tracking. Pre-boot only.",
    "flags": [
      {"name": "vcpu_count", "value": "u8 (1..32)", "doc": "Number of vCPU threads."},
      {"name": "mem_size_mib", "value": "u64", "doc": "Guest RAM in MiB."},
      {"name": "smt", "value": "bool", "doc": "Intel hyperthreading exposure (x86 only)."},
      {"name": "track_dirty_pages", "value": "bool", "doc": "Enable KVM_MEM_LOG_DIRTY_PAGES on the guest RAM region; required for diff snapshots."},
      {"name": "huge_pages", "value": "None|2M", "doc": "Back guest RAM with hugepages."}
    ],
    "examples": [{"invocation": "PUT /machine-config {\"vcpu_count\":2, \"mem_size_mib\":1024, \"smt\":false, \"track_dirty_pages\":true}", "expected_output": "204", "scenario": "Pre-boot machine sizing"}],
    "source_ids": ["fc-swagger-spec"]
  },
  {
    "id": "firecracker.api.cmd.patch-machine-config",
    "command": "PATCH /machine-config",
    "purpose": "Update a subset of machine-config fields. Pre-boot only.",
    "flags": [{"name": "any field of /machine-config", "value": "subset", "doc": "Only included fields are updated."}],
    "examples": [{"invocation": "PATCH /machine-config {\"mem_size_mib\":2048}", "expected_output": "204", "scenario": "Resize RAM before boot"}],
    "source_ids": ["fc-swagger-spec"]
  },
  {
    "id": "firecracker.api.cmd.get-machine-config",
    "command": "GET /machine-config",
    "purpose": "Return the current machine configuration.",
    "flags": [],
    "examples": [{"invocation": "GET /machine-config", "expected_output": "200 with MachineConfiguration JSON", "scenario": "Pre-boot config check"}],
    "source_ids": ["fc-swagger-spec"]
  },
  {
    "id": "firecracker.api.cmd.put-cpu-configuration",
    "command": "PUT /cpu-config",
    "purpose": "Apply a custom CPU template — explicit CPUID/MSR/Aarch64-register modifiers. Replaces the legacy machine_config.cpu_template enum. Pre-boot only.",
    "flags": [
      {"name": "cpuid_modifiers", "value": "array of leaves", "doc": "x86: each entry has leaf, subleaf, register modifiers."},
      {"name": "msr_modifiers", "value": "array", "doc": "x86: MSR addr + bitmap modifiers."},
      {"name": "reg_modifiers", "value": "array", "doc": "Aarch64: register modifiers."}
    ],
    "examples": [{"invocation": "PUT /cpu-config @t2-template.json", "expected_output": "204; 400 if template is incompatible with host", "scenario": "Apply T2 CPU template for snapshot portability"}],
    "source_ids": ["fc-swagger-spec", "fc-docs-cpu-templates"]
  },
  {
    "id": "firecracker.api.cmd.put-guest-drive-by-id",
    "command": "PUT /drives/{drive_id}",
    "purpose": "Attach or replace a block device. Pre-boot for full PUT; runtime PATCH only updates a subset.",
    "flags": [
      {"name": "drive_id", "value": "string", "doc": "Path parameter."},
      {"name": "path_on_host", "value": "string", "doc": "Backing file."},
      {"name": "is_root_device", "value": "bool", "doc": "Mark as the boot disk."},
      {"name": "is_read_only", "value": "bool", "doc": "Block writes from the guest."},
      {"name": "cache_type", "value": "Unsafe|Writeback", "doc": "Unsafe = no flush; Writeback = honor flush. Writeback recommended for data integrity."},
      {"name": "io_engine", "value": "Sync|Async", "doc": "Async uses io_uring (kernel 5.10+)."},
      {"name": "rate_limiter", "value": "RateLimiter object", "doc": "Token-bucket bandwidth + ops limits."},
      {"name": "socket", "value": "string|null", "doc": "vhost-user socket path; conflicts with path_on_host."}
    ],
    "examples": [{"invocation": "PUT /drives/rootfs {\"drive_id\":\"rootfs\",\"path_on_host\":\"/var/rootfs.ext4\",\"is_root_device\":true,\"is_read_only\":false,\"cache_type\":\"Writeback\"}", "expected_output": "204; 400 if file missing", "scenario": "Attach root filesystem"}],
    "source_ids": ["fc-swagger-spec"]
  },
  {
    "id": "firecracker.api.cmd.patch-guest-drive-by-id",
    "command": "PATCH /drives/{drive_id}",
    "purpose": "Update a drive at runtime — swap backing file (path_on_host) or change rate limiters. Other fields are immutable post-boot.",
    "flags": [
      {"name": "path_on_host", "value": "string", "doc": "Hot-swap the backing file. Guest sees this on next I/O."},
      {"name": "rate_limiter", "value": "RateLimiter|null", "doc": "Replace or remove rate limit. null clears."}
    ],
    "examples": [{"invocation": "PATCH /drives/rootfs {\"drive_id\":\"rootfs\",\"rate_limiter\":{\"bandwidth\":{\"size\":10485760,\"refill_time\":1000}}}", "expected_output": "204", "scenario": "Throttle a runaway guest at runtime"}],
    "source_ids": ["fc-swagger-spec"]
  },
  {
    "id": "firecracker.api.cmd.put-guest-network-interface-by-id",
    "command": "PUT /network-interfaces/{iface_id}",
    "purpose": "Attach a VirtIO/net device backed by a host TAP. Pre-boot only.",
    "flags": [
      {"name": "iface_id", "value": "string", "doc": "Path parameter."},
      {"name": "host_dev_name", "value": "string", "doc": "Host TAP interface name (must exist)."},
      {"name": "guest_mac", "value": "string|null", "doc": "Guest MAC; if null, generated."},
      {"name": "rx_rate_limiter", "value": "RateLimiter", "doc": "Inbound throttling."},
      {"name": "tx_rate_limiter", "value": "RateLimiter", "doc": "Outbound throttling."}
    ],
    "examples": [{"invocation": "PUT /network-interfaces/eth0 {\"iface_id\":\"eth0\",\"host_dev_name\":\"tap0\",\"guest_mac\":\"AA:FC:00:00:00:01\"}", "expected_output": "204; 400 if TAP not found or wrong permissions", "scenario": "Attach primary NIC pre-boot"}],
    "source_ids": ["fc-swagger-spec", "fc-docs-network-setup"]
  },
  {
    "id": "firecracker.api.cmd.patch-guest-network-interface-by-id",
    "command": "PATCH /network-interfaces/{iface_id}",
    "purpose": "Update RX/TX rate limiters at runtime. Other fields immutable post-boot.",
    "flags": [{"name": "rx_rate_limiter / tx_rate_limiter", "value": "RateLimiter|null", "doc": "Replace or remove."}],
    "examples": [{"invocation": "PATCH /network-interfaces/eth0 {\"iface_id\":\"eth0\",\"tx_rate_limiter\":null}", "expected_output": "204", "scenario": "Lift outbound rate limit"}],
    "source_ids": ["fc-swagger-spec"]
  },
  {
    "id": "firecracker.api.cmd.put-guest-vsock",
    "command": "PUT /vsock",
    "purpose": "Attach the (single) VirtIO/vsock device. Pre-boot only.",
    "flags": [
      {"name": "vsock_id", "value": "string", "doc": "Identifier."},
      {"name": "guest_cid", "value": "u32 (>=3)", "doc": "Vsock CID seen by the guest. CIDs 0, 1, 2 are reserved."},
      {"name": "uds_path", "value": "string", "doc": "Host-side Unix socket path. Firecracker creates it; guest connections multiplex over it."}
