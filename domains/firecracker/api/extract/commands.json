    "examples": [{"invocation": "PUT /vsock {\"vsock_id\":\"vsock1\",\"guest_cid\":3,\"uds_path\":\"/tmp/vm.vsock\"}", "expected_output": "204", "scenario": "Set up vsock for control-plane host↔guest comms"}],
    "source_ids": ["fc-swagger-spec", "fc-docs-vsock"]
