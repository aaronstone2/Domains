  {"id":"docker.compose.cfg.healthcheck.test","scope":"services.<name>.healthcheck","key":"test","type":"list[string]","default_value":"image HEALTHCHECK","description":"`[\"NONE\"]`, `[\"CMD\", arg, ...]` (exec), `[\"CMD-SHELL\", \"shell\"]`. Exit 0 = healthy.","source_ids":["compose-spec-05-services","docker-docs-compose-startup-order"]},
  {"id":"docker.compose.cfg.healthcheck.interval","scope":"services.<name>.healthcheck","key":"interval","type":"duration","default_value":"30s","description":"Time between probes.","source_ids":["compose-spec-05-services"]},
