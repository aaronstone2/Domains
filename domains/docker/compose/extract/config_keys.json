  {"id":"docker.compose.cfg.deploy.resources.limits.pids","scope":"services.<name>.deploy","key":"resources.limits.pids","type":"int","default_value":null,"description":"Pids cgroup limit.","source_ids":["compose-spec-deploy"]},
