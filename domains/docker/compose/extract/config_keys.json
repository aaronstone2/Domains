  {"id":"docker.compose.cfg.deploy.resources.reservations.memory","scope":"services.<name>.deploy","key":"resources.reservations.memory","type":"bytes","default_value":null,"description":"Memory reservation.","source_ids":["compose-spec-deploy"]},
