  {"id":"docker.compose.cfg.depends_on.condition","scope":"services.<name>.depends_on","key":"<svc>.condition","type":"enum[service_started|service_healthy|service_completed_successfully]","default_value":"service_started","description":"When the dependency is satisfied.","source_ids":["docker-docs-compose-startup-order","compose-spec-05-services"]},
  {"id":"docker.compose.cfg.depends_on.restart","scope":"services.<name>.depends_on","key":"<svc>.restart","type":"bool","default_value":"false","description":"Restart this service when the dependency is restarted.","source_ids":["docker-docs-compose-startup-order"]},
