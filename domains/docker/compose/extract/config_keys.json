  {"id":"docker.compose.cfg.develop-watch.path","scope":"develop.watch","key":"path","type":"string (path)","default_value":null,"description":"Source path to monitor. Relative to project dir.","source_ids":["compose-spec-develop"]},
  {"id":"docker.compose.cfg.develop-watch.target","scope":"develop.watch","key":"target","type":"string (path)","default_value":null,"description":"Container path to sync to (sync action).","source_ids":["compose-spec-develop"]},
  {"id":"docker.compose.cfg.develop-watch.action","scope":"develop.watch","key":"action","type":"enum[rebuild|restart|sync|sync+restart|sync+exec]","default_value":null,"description":"Action on change. rebuild = full image rebuild; sync = file copy; restart = container restart; sync+exec = sync then run a command.","source_ids":["compose-spec-develop"]},
  {"id":"docker.compose.cfg.develop-watch.ignore","scope":"develop.watch","key":"ignore","type":"list[string (pattern)]","default_value":"[]","description":"Patterns to skip. Same syntax as .dockerignore. .dockerignore content is implicitly merged in.","source_ids":["compose-spec-develop"]},
  {"id":"docker.compose.cfg.develop-watch.include","scope":"develop.watch","key":"include","type":"list[string (pattern)]","default_value":"[]","description":"Patterns to include. Wildcards must be quoted in YAML to avoid alias-node interpretation.","source_ids":["compose-spec-develop"]},
  {"id":"docker.compose.cfg.develop-watch.initial_sync","scope":"develop.watch","key":"initial_sync","type":"bool","default_value":"false","description":"On a new watch session against existing containers, sync files first to bring container content up to date.","source_ids":["compose-spec-develop"]},
  {"id":"docker.compose.cfg.develop-watch.exec.command","scope":"develop.watch","key":"exec.command","type":"string | list","default_value":null,"description":"sync+exec only. Command to run after sync. Either shell form or exec form.","source_ids":["compose-spec-develop"]},
