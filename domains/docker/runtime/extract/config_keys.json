  {"id":"docker.runtime.cfg.containerd-toml.cri.cni.conf_dir","scope":"containerd-toml","key":"plugins.\"io.containerd.cri.v1.runtime\".cni.conf_dir","type":"string (path)","default_value":"/etc/cni/net.d","description":"Directory of CNI conf files.","source_ids":["containerd-cri-config"]},
