  {"id":"docker.runtime.cfg.containerd-toml.cri.registry.mirrors","scope":"containerd-toml","key":"plugins.\"io.containerd.cri.v1.images\".registry.mirrors.<host>.endpoint","type":"list[string]","default_value":"[]","description":"DEPRECATED — use registry.config_path. Per-host registry mirror endpoints.","source_ids":["containerd-cri-config"]},
  {"id":"docker.runtime.cfg.containerd-toml.cri.image_decryption.key_model","scope":"containerd-toml","key":"plugins.\"io.containerd.cri.v1.images\".image_decryption.key_model","type":"enum[node|]","default_value":"node","description":"Image decryption key model. `node` = key on the node. Used with encrypted images.","source_ids":["containerd-cri-config"]},
  {"id":"docker.runtime.cfg.containerd-toml.cri.sandbox_image","scope":"containerd-toml","key":"plugins.\"io.containerd.cri.v1.images\".pinned_images.sandbox","type":"string (image ref)","default_value":"registry.k8s.io/pause:3.10.2","description":"Pause image for pod sandboxes. Pinned: never garbage-collected.","source_ids":["containerd-cri-config"]},
  {"id":"docker.runtime.cfg.containerd-toml.cri.max_concurrent_downloads","scope":"containerd-toml","key":"plugins.\"io.containerd.cri.v1.images\".max_concurrent_downloads","type":"int","default_value":"3","description":"Max parallel layer downloads in CRI image pulls.","source_ids":["containerd-cri-config"]},
  {"id":"docker.runtime.cfg.containerd-toml.cri.image_pull_progress_timeout","scope":"containerd-toml","key":"plugins.\"io.containerd.cri.v1.images\".image_pull_progress_timeout","type":"duration","default_value":"\"5m0s\"","description":"Abort an image pull if no progress for this long. Set higher for big images on slow links.","source_ids":["containerd-cri-config"]},
  {"id":"docker.runtime.cfg.containerd-toml.cri.use_local_image_pull","scope":"containerd-toml","key":"plugins.\"io.containerd.cri.v1.images\".use_local_image_pull","type":"bool","default_value":"false","description":"v2.1+: use local pull mode instead of Transfer Service. Auto-set true if conflicting options (DiscardUnpackedLayers, Registry.Mirrors, etc.) are present.","source_ids":["containerd-cri-config"]},
  {"id":"docker.runtime.cfg.containerd-toml.cri.runtime.enable_selinux","scope":"containerd-toml","key":"plugins.\"io.containerd.cri.v1.runtime\".enable_selinux","type":"bool","default_value":"false","description":"Apply SELinux labels to containers.","source_ids":["containerd-cri-config"]},
  {"id":"docker.runtime.cfg.containerd-toml.cri.runtime.disable_apparmor","scope":"containerd-toml","key":"plugins.\"io.containerd.cri.v1.runtime\".disable_apparmor","type":"bool","default_value":"false","description":"Skip applying AppArmor profiles.","source_ids":["containerd-cri-config"]},
  {"id":"docker.runtime.cfg.containerd-toml.snapshotter.overlayfs.root_path","scope":"containerd-toml","key":"plugins.\"io.containerd.snapshotter.v1.overlayfs\".root_path","type":"string (path)","default_value":"\"\"","description":"Root path for overlayfs snapshotter. Override to put image layers on a separate disk.","source_ids":["containerd-ops"]},

  {"id":"docker.runtime.cfg.oci-image-config.created","scope":"oci-image-config","key":"created","type":"string (RFC 3339)","default_value":null,"description":"Timestamp the image was built.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.author","scope":"oci-image-config","key":"author","type":"string","default_value":null,"description":"Person/entity that built the image.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.architecture","scope":"oci-image-config","key":"architecture","type":"string (GOARCH)","default_value":null,"description":"Required. CPU arch: amd64, arm64, arm, s390x, ppc64le, riscv64, mips64le.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.os","scope":"oci-image-config","key":"os","type":"string (GOOS)","default_value":null,"description":"Required. Operating system: linux, windows, darwin, freebsd.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.os.version","scope":"oci-image-config","key":"os.version","type":"string","default_value":null,"description":"OS version (e.g. \"10.0.14393.1066\" on windows).","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.os.features","scope":"oci-image-config","key":"os.features","type":"list[string]","default_value":"[]","description":"Mandatory OS features (e.g. \"win32k\" on Windows).","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.variant","scope":"oci-image-config","key":"variant","type":"string","default_value":null,"description":"Arch variant (e.g. \"v7\" for armv7).","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.User","scope":"oci-image-config","key":"config.User","type":"string","default_value":null,"description":"Default user for `docker run`. Forms: user, uid, user:group, uid:gid.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.ExposedPorts","scope":"oci-image-config","key":"config.ExposedPorts","type":"map<port[/proto], {}>","default_value":"{}","description":"Ports the image expects to listen on. Default proto = tcp. Just metadata; doesn't auto-publish.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.Env","scope":"oci-image-config","key":"config.Env","type":"list[\"KEY=VAL\"]","default_value":"[]","description":"Default env vars merged with `docker run -e`.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.Entrypoint","scope":"oci-image-config","key":"config.Entrypoint","type":"list[string]","default_value":null,"description":"Default entrypoint. Replaceable with `--entrypoint`.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.Cmd","scope":"oci-image-config","key":"config.Cmd","type":"list[string]","default_value":null,"description":"Default args to entrypoint. If no entrypoint, first element is the executable.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.Volumes","scope":"oci-image-config","key":"config.Volumes","type":"map<path, {}>","default_value":"{}","description":"Paths the image declares as anonymous volumes.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.WorkingDir","scope":"oci-image-config","key":"config.WorkingDir","type":"string (path)","default_value":null,"description":"Default cwd.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.Labels","scope":"oci-image-config","key":"config.Labels","type":"map<string, string>","default_value":"{}","description":"Arbitrary metadata. Standard keys per opencontainers/image-spec annotation rules.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.StopSignal","scope":"oci-image-config","key":"config.StopSignal","type":"string","default_value":"SIGTERM","description":"Default kill signal on `docker stop`. Format: SIGNAME or SIGRTMIN+N.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.config.ArgsEscaped","scope":"oci-image-config","key":"config.ArgsEscaped","type":"bool","default_value":"false","description":"DEPRECATED. Windows-only legacy flag indicating Entrypoint/Cmd are pre-escaped strings.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.rootfs.type","scope":"oci-image-config","key":"rootfs.type","type":"string","default_value":"\"layers\"","description":"Currently always \"layers\".","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.rootfs.diff_ids","scope":"oci-image-config","key":"rootfs.diff_ids","type":"list[string (sha256:digest)]","default_value":"[]","description":"Ordered diff_ids from base layer to top. Combined with tar-split to compute ChainID and ImageID.","source_ids":["oci-image-spec-config"]},
  {"id":"docker.runtime.cfg.oci-image-config.history","scope":"oci-image-config","key":"history","type":"list[{created, created_by, author?, comment?, empty_layer?}]","default_value":"[]","description":"Per-layer build history. `docker history` reads this.","source_ids":["oci-image-spec-config"]},

  {"id":"docker.runtime.cfg.runc-cli-flag.bundle","scope":"runc-cli-flag","key":"--bundle, -b","type":"string (path)","default_value":"cwd","description":"Path to OCI bundle directory. Used by create/run/spec.","source_ids":["runc-create-8","runc-run-8","runc-spec-8"]},
  {"id":"docker.runtime.cfg.runc-cli-flag.console-socket","scope":"runc-cli-flag","key":"--console-socket","type":"string (path)","default_value":null,"description":"AF_UNIX socket to receive pty master fd via SCM_RIGHTS. Required if process.terminal=true.","source_ids":["runc-create-8","runc-run-8","runc-exec-8"]},
  {"id":"docker.runtime.cfg.runc-cli-flag.pid-file","scope":"runc-cli-flag","key":"--pid-file","type":"string (path)","default_value":null,"description":"Write initial container process pid to this file.","source_ids":["runc-create-8","runc-run-8","runc-exec-8"]},
  {"id":"docker.runtime.cfg.runc-cli-flag.no-pivot","scope":"runc-cli-flag","key":"--no-pivot","type":"bool","default_value":"false","description":"Use chroot+chdir instead of pivot_root. Discouraged: 'may be unsafe from a security standpoint'.","source_ids":["runc-create-8","runc-run-8"]},
  {"id":"docker.runtime.cfg.runc-cli-flag.no-new-keyring","scope":"runc-cli-flag","key":"--no-new-keyring","type":"bool","default_value":"false","description":"Don't create new session keyring; container inherits caller's.","source_ids":["runc-create-8","runc-run-8"]},
  {"id":"docker.runtime.cfg.runc-cli-flag.preserve-fds","scope":"runc-cli-flag","key":"--preserve-fds","type":"int","default_value":"0","description":"Pass N additional fds beyond stdio + $LISTEN_FDS.","source_ids":["runc-create-8","runc-run-8","runc-exec-8"]},
  {"id":"docker.runtime.cfg.runc-cli-flag.detach","scope":"runc-cli-flag","key":"--detach, -d","type":"bool","default_value":"false","description":"Detach from container's process. run/exec.","source_ids":["runc-run-8","runc-exec-8"]},
  {"id":"docker.runtime.cfg.runc-cli-flag.keep","scope":"runc-cli-flag","key":"--keep","type":"bool","default_value":"false","description":"runc-run only. Keep state directory and cgroup after container exits. Manual `runc delete` required.","source_ids":["runc-run-8"]},
  {"id":"docker.runtime.cfg.runc-cli-flag.force","scope":"runc-cli-flag","key":"--force, -f","type":"bool","default_value":"false","description":"runc-delete only. SIGKILL the container before deleting.","source_ids":["runc-delete-8"]},
  {"id":"docker.runtime.cfg.runc-cli-flag.ignore-paused","scope":"runc-cli-flag","key":"--ignore-paused","type":"bool","default_value":"false","description":"runc-exec only. Allow exec in a paused container (must resume for exec to complete).","source_ids":["runc-exec-8"]},

  {"id":"docker.runtime.cfg.oci-distribution-header.docker-content-digest","scope":"oci-distribution-header","key":"Docker-Content-Digest","type":"string (sha256:...)","default_value":null,"description":"Server-asserted digest of returned content. Client verifies blob bytes against this header.","source_ids":["oci-distribution-spec"]},
  {"id":"docker.runtime.cfg.oci-distribution-header.docker-distribution-api-version","scope":"oci-distribution-header","key":"Docker-Distribution-API-Version","type":"string","default_value":"\"registry/2.0\"","description":"Registry advertises its API version (sniff endpoint).","source_ids":["oci-distribution-spec"]},
  {"id":"docker.runtime.cfg.oci-distribution-header.range","scope":"oci-distribution-header","key":"Range","type":"string (\"bytes=START-END\")","default_value":null,"description":"Partial blob retrieval (resume-pull pattern).","source_ids":["oci-distribution-spec"]},
  {"id":"docker.runtime.cfg.oci-distribution-header.content-range","scope":"oci-distribution-header","key":"Content-Range","type":"string","default_value":null,"description":"Used in chunked-upload PATCH requests: `Content-Range: <START>-<END>`.","source_ids":["oci-distribution-spec"]},
  {"id":"docker.runtime.cfg.oci-distribution-header.content-length","scope":"oci-distribution-header","key":"Content-Length","type":"int","default_value":null,"description":"Required on monolithic upload PUT.","source_ids":["oci-distribution-spec"]},
  {"id":"docker.runtime.cfg.oci-distribution-header.location","scope":"oci-distribution-header","key":"Location","type":"string (URL)","default_value":null,"description":"Returned by `POST /v2/<name>/blobs/uploads/`. Subsequent PATCHes go to this URL.","source_ids":["oci-distribution-spec"]},
  {"id":"docker.runtime.cfg.oci-distribution-header.accept","scope":"oci-distribution-header","key":"Accept","type":"string (media-type list)","default_value":null,"description":"Used by clients to negotiate manifest format. Comma-separated mediatypes; common: `application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json,application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json`.","source_ids":["oci-distribution-spec"]},
  {"id":"docker.runtime.cfg.oci-distribution-header.authorization","scope":"oci-distribution-header","key":"Authorization","type":"string","default_value":null,"description":"`Basic <b64>` for basic auth or `Bearer <token>` for token auth.","source_ids":["oci-distribution-spec"]},
  {"id":"docker.runtime.cfg.oci-distribution-header.www-authenticate","scope":"oci-distribution-header","key":"WWW-Authenticate","type":"string","default_value":null,"description":"In 401 response. Tells client where to fetch a bearer token from.","source_ids":["oci-distribution-spec"]},
  {"id":"docker.runtime.cfg.oci-distribution-header.oci-subject","scope":"oci-distribution-header","key":"OCI-Subject","type":"string (digest)","default_value":null,"description":"Returned on PUT manifest with subject — confirms server processed the referrers relationship.","source_ids":["oci-distribution-spec"]}
