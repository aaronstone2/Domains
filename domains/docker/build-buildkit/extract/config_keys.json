[
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.FROM","scope":"dockerfile-instruction-keyword","key":"FROM <image>[:<tag>|@<digest>] [AS <stage>]","type":"instruction","default_value":null,"description":"Set base image for the next stage. `FROM scratch` for empty rootfs. Pin to digest for reproducibility.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-shell","scope":"dockerfile-instruction-keyword","key":"RUN <command>","type":"shell-form","default_value":null,"description":"Shell-form RUN. Wrapped in /bin/sh -c (or what SHELL was set to).","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-exec","scope":"dockerfile-instruction-keyword","key":"RUN [\"executable\", \"arg\"]","type":"exec-form","default_value":null,"description":"Exec-form RUN. No shell wrapping; env vars NOT expanded.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-mount-bind","scope":"dockerfile-instruction-keyword","key":"RUN --mount=type=bind,source=<path>,target=<path>[,from=<stage>][,rw]","type":"mount opt","default_value":null,"description":"Bind-mount context or another stage into RUN. Read-only by default.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-mount-cache","scope":"dockerfile-instruction-keyword","key":"RUN --mount=type=cache,target=<path>[,id=<id>][,sharing=shared|private|locked][,from=<stage>][,uid=,gid=,mode=]","type":"mount opt","default_value":null,"description":"Persistent build cache mount. Common: `RUN --mount=type=cache,target=/root/.cache/go-build go build`.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-mount-secret","scope":"dockerfile-instruction-keyword","key":"RUN --mount=type=secret,id=<name>[,target=<path>][,uid=,gid=,mode=,required=true]","type":"mount opt","default_value":null,"description":"Mount a CLI-supplied secret. Default target `/run/secrets/<id>`. Secret content NEVER in layers.","source_ids":["docker-docs-build-secrets","moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-mount-ssh","scope":"dockerfile-instruction-keyword","key":"RUN --mount=type=ssh[,id=<name>][,target=<path>][,uid=,gid=,mode=,required=true]","type":"mount opt","default_value":null,"description":"Forward host SSH agent socket. Pass key via CLI `--ssh default` or `--ssh id=<name>=<path>`.","source_ids":["docker-docs-build-secrets","moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-mount-tmpfs","scope":"dockerfile-instruction-keyword","key":"RUN --mount=type=tmpfs,target=<path>[,size=<bytes>]","type":"mount opt","default_value":null,"description":"In-memory tmpfs for the duration of one RUN.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-network","scope":"dockerfile-instruction-keyword","key":"RUN --network=default|none|host","type":"flag","default_value":"default","description":"Network for this RUN. `none` blocks egress (security hardening); `host` requires `--allow=network.host` on the build.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-security","scope":"dockerfile-instruction-keyword","key":"RUN --security=insecure|sandbox","type":"flag","default_value":"sandbox","description":"`insecure` runs RUN with full host privileges (needs `--allow=security.insecure`). For when you really need to mknod, mount, etc. during build.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.RUN-here-doc","scope":"dockerfile-instruction-keyword","key":"RUN <<EOF ... EOF","type":"heredoc","default_value":null,"description":"Multi-line script as a heredoc. Cleaner than `&&`-chained one-liners. Variants `<<-EOF` (strip leading tabs), `<<\"EOF\"` (no var interpolation).","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.COPY","scope":"dockerfile-instruction-keyword","key":"COPY [--from=<stage|image>] [--chown=<u:g>] [--chmod=<mode>] [--link] <src>... <dest>","type":"instruction","default_value":null,"description":"Copy files. `--link` makes a layer-decoupled copy (faster rebuilds when prior layers change).","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.COPY-here-doc","scope":"dockerfile-instruction-keyword","key":"COPY <<EOF /path","type":"heredoc","default_value":null,"description":"Heredoc COPY — write inline content into a file in the image without a separate context file.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ADD-url","scope":"dockerfile-instruction-keyword","key":"ADD <URL> <dest>","type":"variant","default_value":null,"description":"Fetch URL during build. Use `--checksum=sha256:<hex>` for integrity.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ADD-tar","scope":"dockerfile-instruction-keyword","key":"ADD <local.tar.gz> <dest>","type":"variant","default_value":null,"description":"Auto-extract local tarball (.tar, .tar.gz, .tar.bz2, .tar.xz) — surprising behavior; usually prefer COPY.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ADD-checksum","scope":"dockerfile-instruction-keyword","key":"ADD --checksum=sha256:<hex>","type":"flag","default_value":null,"description":"Verify URL fetch checksum.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ADD-keep-git-dir","scope":"dockerfile-instruction-keyword","key":"ADD --keep-git-dir=true <git-url> <dest>","type":"flag","default_value":"false","description":"Preserve .git dir when source is a git URL.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.CMD-shell","scope":"dockerfile-instruction-keyword","key":"CMD command arg","type":"shell-form","default_value":null,"description":"Shell-form CMD. Wrapped in /bin/sh -c.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.CMD-exec","scope":"dockerfile-instruction-keyword","key":"CMD [\"executable\", \"arg\"]","type":"exec-form","default_value":null,"description":"Exec-form CMD. Default. Preferred for production — signals propagate.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.CMD-default-args","scope":"dockerfile-instruction-keyword","key":"CMD [\"arg1\", \"arg2\"]","type":"variant","default_value":null,"description":"Default arguments to ENTRYPOINT (when ENTRYPOINT is set in exec form).","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ENTRYPOINT-shell","scope":"dockerfile-instruction-keyword","key":"ENTRYPOINT command","type":"shell-form","default_value":null,"description":"Shell-form. AVOID — pid 1 is /bin/sh, signals don't reach the binary.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ENTRYPOINT-exec","scope":"dockerfile-instruction-keyword","key":"ENTRYPOINT [\"executable\", \"arg\"]","type":"exec-form","default_value":null,"description":"Exec-form. Preferred. The binary IS pid 1.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ENV","scope":"dockerfile-instruction-keyword","key":"ENV KEY=VALUE [KEY=VALUE...]","type":"instruction","default_value":null,"description":"Set environment variables for subsequent instructions AND for the running container.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ARG","scope":"dockerfile-instruction-keyword","key":"ARG NAME[=default]","type":"instruction","default_value":null,"description":"Build-time variable. Visible after declaration. Pass via CLI `--build-arg NAME=val`.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ARG-global","scope":"dockerfile-instruction-keyword","key":"ARG NAME (before first FROM)","type":"variant","default_value":null,"description":"Global ARG — available to FROM instructions for image tag interpolation. e.g. `ARG IMAGE_TAG=latest` then `FROM nginx:$IMAGE_TAG`.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ARG-auto-platform","scope":"dockerfile-instruction-keyword","key":"BUILDPLATFORM, TARGETPLATFORM, TARGETOS, TARGETARCH, TARGETVARIANT (auto-injected)","type":"variant","default_value":null,"description":"Auto-set ARGs in multi-platform builds. `BUILDPLATFORM` = where the build runs; `TARGETPLATFORM` = what we build for. Use to fetch arch-specific binaries.","source_ids":["moby-buildkit-multi-platform","moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.LABEL","scope":"dockerfile-instruction-keyword","key":"LABEL key=value [key=value...]","type":"instruction","default_value":null,"description":"Image metadata. Standard keys: `org.opencontainers.image.{title,description,authors,vendor,licenses,source,documentation,version,revision,created}`.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.EXPOSE","scope":"dockerfile-instruction-keyword","key":"EXPOSE <port>[/<proto>]","type":"instruction","default_value":null,"description":"Declare ports. Pure metadata. Default proto tcp. -P consumes EXPOSE'd ports.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.VOLUME","scope":"dockerfile-instruction-keyword","key":"VOLUME [\"<path>\"]","type":"instruction","default_value":null,"description":"Declare a path as anonymous-volume mount point. Forms: JSON array (exec form) or whitespace-separated.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.USER","scope":"dockerfile-instruction-keyword","key":"USER <uid|name>[:<gid|group>]","type":"instruction","default_value":null,"description":"Set user for subsequent RUN/CMD/ENTRYPOINT. Hardening: drop to non-root.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.WORKDIR","scope":"dockerfile-instruction-keyword","key":"WORKDIR <path>","type":"instruction","default_value":null,"description":"Set cwd. Auto-creates if missing.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.HEALTHCHECK-CMD","scope":"dockerfile-instruction-keyword","key":"HEALTHCHECK [OPTIONS] CMD <command>","type":"instruction","default_value":null,"description":"In-image health probe. Options: --interval, --timeout, --retries, --start-period, --start-interval.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.HEALTHCHECK-NONE","scope":"dockerfile-instruction-keyword","key":"HEALTHCHECK NONE","type":"variant","default_value":null,"description":"Clear any inherited HEALTHCHECK from base image.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.ONBUILD","scope":"dockerfile-instruction-keyword","key":"ONBUILD <instruction>","type":"instruction","default_value":null,"description":"Trigger when a downstream image uses this image as base. Often surprising for downstream users — use sparingly.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.STOPSIGNAL","scope":"dockerfile-instruction-keyword","key":"STOPSIGNAL <signal>","type":"instruction","default_value":"SIGTERM","description":"Default kill signal. e.g. nginx uses SIGQUIT for graceful drain.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.SHELL","scope":"dockerfile-instruction-keyword","key":"SHELL [\"executable\", \"arg\"]","type":"instruction","default_value":"[\"/bin/sh\",\"-c\"] (Linux); [\"cmd\",\"/S\",\"/C\"] (Windows)","description":"Override shell for shell-form RUN/CMD/ENTRYPOINT. Use `[\"powershell\",\"-Command\"]` on Windows for PowerShell builds.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.MAINTAINER","scope":"dockerfile-instruction-keyword","key":"MAINTAINER <email>","type":"deprecated","default_value":null,"description":"DEPRECATED. Use `LABEL org.opencontainers.image.authors=...` instead.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.COPY-link","scope":"dockerfile-instruction-keyword","key":"COPY --link","type":"flag","default_value":"false","description":"Copy in a separate layer that doesn't depend on prior layer's hash. Speeds up rebuilds when the layer above changes.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.COPY-from-stage","scope":"dockerfile-instruction-keyword","key":"COPY --from=<stage>","type":"flag","default_value":null,"description":"Copy from an earlier multi-stage stage by name (or index `--from=0`).","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.COPY-from-image","scope":"dockerfile-instruction-keyword","key":"COPY --from=<image>","type":"flag","default_value":null,"description":"Copy from an external image without a FROM stage. e.g. `COPY --from=alpine:3.20 /etc/ssl/certs /etc/ssl/certs`.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.COPY-chown","scope":"dockerfile-instruction-keyword","key":"COPY --chown=<user>[:<group>]","type":"flag","default_value":null,"description":"Set ownership on the copied files.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.COPY-chmod","scope":"dockerfile-instruction-keyword","key":"COPY --chmod=<mode>","type":"flag","default_value":null,"description":"Set permissions on the copied files (octal).","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-instruction-keyword.COPY-parents","scope":"dockerfile-instruction-keyword","key":"COPY --parents <src>... <dest>","type":"flag","default_value":"false","description":"Preserve the parent directory structure when copying multiple sources. e.g. `COPY --parents foo/file1.txt bar/file2.txt /dest/` keeps the foo/ and bar/ subdirs.","source_ids":["moby-buildkit-dockerfile-reference"]},

  {"id":"docker.build-buildkit.cfg.dockerfile-parser-directive.syntax","scope":"dockerfile-parser-directive","key":"# syntax=<frontend-image>","type":"directive","default_value":"docker/dockerfile:1","description":"Pin frontend image. Forms: `# syntax=docker/dockerfile:1`, `# syntax=docker/dockerfile:1.6`, `# syntax=docker/dockerfile@sha256:...`, `# syntax=docker/dockerfile:1-labs` (experimental). Must be at top of file.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-parser-directive.escape","scope":"dockerfile-parser-directive","key":"# escape=<char>","type":"directive","default_value":"\\\\","description":"Line-continuation char. Set to backtick on Windows where backslash is path separator: `# escape=` ` `` ``.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-parser-directive.check","scope":"dockerfile-parser-directive","key":"# check=skip=<rule>[;<rule>...] | error=true","type":"directive","default_value":null,"description":"Build-checks linter directive. e.g. `# check=skip=JSONArgsRecommended` to skip a check, `# check=error=true` to fail on warnings.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-parser-directive.position","scope":"dockerfile-parser-directive","key":"directives must be at top","type":"rule","default_value":null,"description":"Parser directives end as soon as the parser hits a non-directive line (instruction, blank line, or non-directive comment). Order: syntax, escape, check (any order at top).","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-parser-directive.case-insensitive","scope":"dockerfile-parser-directive","key":"directive names case-insensitive","type":"rule","default_value":null,"description":"`# Syntax=`, `# SYNTAX=`, `# syntax=` all valid. Convention: lowercase.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-parser-directive.no-interpolation","scope":"dockerfile-parser-directive","key":"no var interpolation in directives","type":"rule","default_value":null,"description":"`# syntax=docker/dockerfile:$VERSION` does NOT expand $VERSION. Pin literally.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-parser-directive.experimental-1-labs","scope":"dockerfile-parser-directive","key":"# syntax=docker/dockerfile:1-labs","type":"variant","default_value":null,"description":"Opt into experimental Dockerfile syntax (new instructions, mount types). Lands in mainline `:1` once stable.","source_ids":["moby-buildkit-dockerfile-reference"]},
  {"id":"docker.build-buildkit.cfg.dockerfile-parser-directive.first-non-directive-ends","scope":"dockerfile-parser-directive","key":"non-directive line ends parser","type":"rule","default_value":null,"description":"After the first non-directive line, all subsequent `# ...=...` lines are normal comments. Common foot-gun.","source_ids":["moby-buildkit-dockerfile-reference"]},

  {"id":"docker.build-buildkit.cfg.buildkitd-toml.debug","scope":"buildkitd-toml","key":"debug","type":"bool","default_value":"false","description":"Enable debug-level logging.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.trace","scope":"buildkitd-toml","key":"trace","type":"bool","default_value":"false","description":"Trace-level logging. Very verbose, perf hit.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.root","scope":"buildkitd-toml","key":"root","type":"string (path)","default_value":"/var/lib/buildkit","description":"Persistent state root.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.insecure-entitlements","scope":"buildkitd-toml","key":"insecure-entitlements","type":"list[string]","default_value":"[]","description":"Entitlements buildkitd will grant when requested. Allowed values: network.host, security.insecure, device.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.provenanceEnvDir","scope":"buildkitd-toml","key":"provenanceEnvDir","type":"string (path)","default_value":null,"description":"Dir of extra config files added to provenance (SLSA invocation environment).","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.log.format","scope":"buildkitd-toml","key":"[log].format","type":"enum[text|json]","default_value":"text","description":"Log output format.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.dns.nameservers","scope":"buildkitd-toml","key":"[dns].nameservers","type":"list[IP]","default_value":"[]","description":"DNS servers for build steps.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.dns.options","scope":"buildkitd-toml","key":"[dns].options","type":"list[string]","default_value":"[]","description":"resolv.conf options.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.dns.searchDomains","scope":"buildkitd-toml","key":"[dns].searchDomains","type":"list[string]","default_value":"[]","description":"DNS search domains.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.grpc.address","scope":"buildkitd-toml","key":"[grpc].address","type":"list[string]","default_value":"[\"unix:///run/buildkit/buildkitd.sock\"]","description":"gRPC listen addresses. Forms: unix://, tcp://, npipe:// (Windows). Repeatable.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.grpc.debugAddress","scope":"buildkitd-toml","key":"[grpc].debugAddress","type":"string (host:port)","default_value":null,"description":"pprof / debug HTTP server address.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.grpc.uid","scope":"buildkitd-toml","key":"[grpc].uid","type":"int","default_value":"0","description":"UID owning the unix socket.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.grpc.gid","scope":"buildkitd-toml","key":"[grpc].gid","type":"int","default_value":"0","description":"GID owning the unix socket.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.grpc.tls.cert","scope":"buildkitd-toml","key":"[grpc.tls].cert","type":"string (path)","default_value":null,"description":"Server TLS cert.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.grpc.tls.key","scope":"buildkitd-toml","key":"[grpc.tls].key","type":"string (path)","default_value":null,"description":"Server TLS key.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.grpc.tls.ca","scope":"buildkitd-toml","key":"[grpc.tls].ca","type":"string (path)","default_value":null,"description":"CA cert for client mTLS.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.otel.socketPath","scope":"buildkitd-toml","key":"[otel].socketPath","type":"string (path)","default_value":null,"description":"OTEL collector trace socket path.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.cdi.disabled","scope":"buildkitd-toml","key":"[cdi].disabled","type":"bool","default_value":"false","description":"Disable CDI (Container Device Interface) support.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.cdi.specDirs","scope":"buildkitd-toml","key":"[cdi].specDirs","type":"list[path]","default_value":"[/etc/cdi, /var/run/cdi, /etc/buildkit/cdi]","description":"Dirs to scan for CDI spec files.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.history.maxAge","scope":"buildkitd-toml","key":"[history].maxAge","type":"int (seconds)","default_value":"172800","description":"Max age of build-history entries.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.history.maxEntries","scope":"buildkitd-toml","key":"[history].maxEntries","type":"int","default_value":"50","description":"Max number of history entries kept.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.enabled","scope":"buildkitd-toml","key":"[worker.oci].enabled","type":"bool","default_value":"true","description":"Enable OCI worker (runc-based).","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.platforms","scope":"buildkitd-toml","key":"[worker.oci].platforms","type":"list[string]","default_value":"[host arch]","description":"Declared platforms (auto-detected if unset).","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.snapshotter","scope":"buildkitd-toml","key":"[worker.oci].snapshotter","type":"enum[auto|overlayfs|native]","default_value":"auto","description":"Snapshotter for OCI worker.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.rootless","scope":"buildkitd-toml","key":"[worker.oci].rootless","type":"bool","default_value":"false","description":"Run worker in rootless mode.","source_ids":["moby-buildkit-buildkitd-toml","moby-buildkit-rootless"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.gc","scope":"buildkitd-toml","key":"[worker.oci].gc","type":"bool","default_value":"true","description":"Enable garbage collection.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.reservedSpace","scope":"buildkitd-toml","key":"[worker.oci].reservedSpace","type":"bytes|percent","default_value":"30%","description":"Min disk space guaranteed retained — never reclaimed.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.maxUsedSpace","scope":"buildkitd-toml","key":"[worker.oci].maxUsedSpace","type":"bytes|percent","default_value":"60%","description":"Max disk space allowed — usage above is reclaimed by GC.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.minFreeSpace","scope":"buildkitd-toml","key":"[worker.oci].minFreeSpace","type":"bytes|percent","default_value":"20GB","description":"Target free space the GC tries to leave.","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.binary","scope":"buildkitd-toml","key":"[worker.oci].binary","type":"string","default_value":"\"\" (auto: buildkit-runc or runc)","description":"Override runtime binary (e.g. `crun`).","source_ids":["moby-buildkit-buildkitd-toml"]},
  {"id":"docker.build-buildkit.cfg.buildkitd-toml.worker-oci.apparmor-profile","scope":"buildkitd-toml","key":"[worker.oci].apparmor-profile","type":"string","default_value":"\"\"","description":"AppArmor profile for build containers (must already be loaded by the host).","source_ids":["moby-buildkit-buildkitd-toml"]},
