[
  {"id":"docker.fm.cannot-connect-daemon","symptom":"`Cannot connect to the Docker daemon at unix:///var/run/docker.sock`","error_patterns":["Cannot connect to the Docker daemon","Is the docker daemon running?","permission denied while trying to connect"],"root_cause_class":"daemon-unavailable","affected_concepts":["docker.engine.dockerd","docker.engine.docker-cli","docker.engine.cfg.daemon.json.group"],"diagnostic_steps":[{"step":1,"action":"Verify daemon process running","command":"systemctl status docker","expected":"active (running)","source_id":"docker-docs-engine-daemon"},{"step":2,"action":"Check socket file exists + permissions","command":"ls -l /var/run/docker.sock","expected":"srw-rw---- root:docker","source_id":"docker-docs-cli-dockerd"},{"step":3,"action":"Check user is in docker group","command":"id $USER","expected":"groups=...,docker","source_id":"docker-docs-engine-security"},{"step":4,"action":"Check DOCKER_HOST env","command":"echo $DOCKER_HOST","expected":"empty (Unix socket) OR valid tcp://...","source_id":"docker-docs-daemon-remote-access"}],"fix_steps":[{"step":1,"action":"If daemon stopped: start","command":"sudo systemctl start docker","validation":"systemctl status docker shows active","rollback":"sudo systemctl stop docker","source_id":"docker-docs-engine-daemon"},{"step":2,"action":"If user not in docker group","command":"sudo usermod -aG docker $USER && newgrp docker","validation":"id shows docker group","rollback":"sudo gpasswd -d $USER docker","source_id":"docker-docs-engine-security"},{"step":3,"action":"If wrong DOCKER_HOST","command":"unset DOCKER_HOST","validation":"docker ps works","rollback":"export DOCKER_HOST=...","source_id":"docker-docs-daemon-remote-access"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["docker-docs-engine-daemon","docker-docs-engine-daemon-troubleshoot","docker-docs-cli-dockerd","docker-docs-daemon-remote-access"]},
  {"id":"docker.fm.exit-137-oomkilled","symptom":"Container exited with code 137; `docker inspect` shows OOMKilled=true","error_patterns":["Exit code 137","OOMKilled: true","killed: true"],"root_cause_class":"resource-limit","affected_concepts":["linux.primitives.oom-killer","docker.engine.cfg.daemon.json.storage-driver","linux.primitives.cfg.cgroup-v2-control-file.memory-max"],"diagnostic_steps":[{"step":1,"action":"Confirm OOM kill","command":"docker inspect <container> --format '{{.State.OOMKilled}} {{.State.ExitCode}}'","expected":"true 137","source_id":"docker-cli-container-inspect"},{"step":2,"action":"Check kernel OOM log","command":"dmesg -T | grep -i 'killed process'","expected":"line naming the killed process","source_id":"man7-dmesg-1"},{"step":3,"action":"Inspect memory limit set","command":"docker inspect <container> --format '{{.HostConfig.Memory}}'","expected":"in bytes (0 = unlimited)","source_id":"docker-cli-container-run"},{"step":4,"action":"Read cgroup memory.events","command":"cat /sys/fs/cgroup/system.slice/docker-<id>.scope/memory.events","expected":"oom_kill > 0","source_id":"kernel-docs-cgroup-v2"}],"fix_steps":[{"step":1,"action":"Raise --memory limit","command":"docker run --memory=2G ...","validation":"container survives previous workload","rollback":"revert to previous limit","source_id":"docker-cli-container-run"},{"step":2,"action":"Profile actual usage","command":"docker stats <container>","validation":"see real RSS pattern","rollback":null,"source_id":"docker-cli-container-stats"}],"confidence":0.98,"last_verified":"2026-05-03","source_ids":["docker-docs-engine-daemon-troubleshoot","kernel-docs-cgroup-v2"]},
  {"id":"docker.fm.docker-stop-hangs-10s","symptom":"`docker stop` takes 10 seconds before container exits (then SIGKILL)","error_patterns":["timeout exceeded","killing container after grace period"],"root_cause_class":"signal-handling","affected_concepts":["linux.primitives.pid-1-init-semantics","docker.engine.docker-init"],"diagnostic_steps":[{"step":1,"action":"Confirm pid 1 is naive","command":"docker exec <c> ps","expected":"PID 1 = your app (not tini/dumb-init)","source_id":"docker-cli-container-exec"},{"step":2,"action":"Verify SIGTERM gets dropped","command":"docker exec <c> sh -c 'kill -TERM 1; sleep 1; ps'","expected":"PID 1 still alive","source_id":"man7-signal-7"}],"fix_steps":[{"step":1,"action":"Use --init flag","command":"docker run --init <image>","validation":"docker stop returns immediately","rollback":"omit --init","source_id":"docker-cli-container-run"},{"step":2,"action":"Or set daemon-default","command":"jq '. + {\"init\": true}' /etc/docker/daemon.json","validation":"new containers default to init","rollback":"remove key","source_id":"docker-docs-cli-dockerd"},{"step":3,"action":"Or install proper init in image","command":"# Dockerfile: FROM ... AS x; ENTRYPOINT [\"tini\", \"--\"]","validation":"PID 1 in running container is tini","rollback":"remove entrypoint","source_id":"docker-cli-container-run"}],"confidence":0.92,"last_verified":"2026-05-03","source_ids":["docker-cli-container-stop","docker-cli-container-run"]},
  {"id":"docker.fm.zombie-processes-leaking","symptom":"Defunct/zombie processes accumulating inside container; `ps` shows multiple <defunct> entries","error_patterns":["<defunct>","Z stat in ps","zombie process"],"root_cause_class":"signal-handling","affected_concepts":["linux.primitives.pid-1-init-semantics","linux.primitives.zombie-reaping","docker.engine.docker-init"],"diagnostic_steps":[{"step":1,"action":"Count zombies","command":"docker exec <c> sh -c \"ps -o pid,stat,cmd | grep ' Z'\"","expected":"any rows = zombies","source_id":"docker-cli-container-exec"},{"step":2,"action":"Check pid 1","command":"docker exec <c> ps -o pid,cmd","expected":"PID 1 should be init/tini, not naive process","source_id":"docker-cli-container-exec"}],"fix_steps":[{"step":1,"action":"Run with --init","command":"docker run --init ...","validation":"no new zombies; docker-init reaps","rollback":"omit","source_id":"docker-cli-container-run"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["docker-cli-container-run","docker-docs-cli-dockerd"]},
  {"id":"docker.fm.image-pull-rate-limit","symptom":"`toomanyrequests: You have reached your pull rate limit` from docker.io","error_patterns":["toomanyrequests","pull rate limit","429"],"root_cause_class":"registry-throttle","affected_concepts":["docker.engine.image","docker.engine.cmd.image-pull"],"diagnostic_steps":[{"step":1,"action":"Verify rate-limit error","command":"docker pull <image> 2>&1","expected":"toomanyrequests","source_id":"docker-cli-image-pull"},{"step":2,"action":"Check current source IP rate-limit status","command":"TOKEN=$(curl -s 'https://auth.docker.io/token?service=registry.docker.io&scope=repository:ratelimitpreview/test:pull' | jq -r .token); curl -sI -H \"Authorization: Bearer $TOKEN\" https://registry-1.docker.io/v2/ratelimitpreview/test/manifests/latest | grep ratelimit","expected":"ratelimit-remaining","source_id":"docker-docs-engine-daemon-troubleshoot"}],"fix_steps":[{"step":1,"action":"Authenticate to docker.io","command":"docker login","validation":"authenticated pulls have higher limits (200/6h vs 100/6h anon)","rollback":"docker logout","source_id":"docker-docs-engine-security"},{"step":2,"action":"Use mirror / pull-through cache","command":"# in /etc/docker/daemon.json: {\"registry-mirrors\":[\"https://my-mirror.example.com\"]}","validation":"docker info shows registry mirror","rollback":"remove key, restart daemon","source_id":"docker-docs-cli-dockerd"},{"step":3,"action":"Move to non-throttled registry","command":"docker tag image:tag ghcr.io/me/image:tag && docker push ghcr.io/me/image:tag","validation":"future pulls from ghcr","rollback":null,"source_id":"docker-cli-image-push"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["docker-docs-engine-daemon-troubleshoot"]},
  {"id":"docker.fm.published-port-not-reachable","symptom":"`docker run -p 8080:80` succeeds but client can't reach localhost:8080","error_patterns":["Connection refused","No route to host","timeout"],"root_cause_class":"networking","affected_concepts":["linux.networking.cfg.sysctl-net-ipv4.ip-forward","docker.engine.cfg.daemon.json.iptables","linux.networking.nat-dnat"],"diagnostic_steps":[{"step":1,"action":"Verify container is listening","command":"docker exec <c> ss -tlnp","expected":"app listening on 0.0.0.0:80 (NOT 127.0.0.1:80 — that's container loopback only)","source_id":"docker-cli-container-exec"},{"step":2,"action":"Check daemon iptables enabled","command":"docker info | grep -i iptables","expected":"NOT listed as warning","source_id":"docker-docs-cli-dockerd"},{"step":3,"action":"Verify host ip_forward","command":"sysctl net.ipv4.ip_forward","expected":"= 1","source_id":"kernel-docs-net-sysctl"},{"step":4,"action":"Check DOCKER chain","command":"sudo iptables -t nat -L DOCKER -n -v","expected":"DNAT rule for :8080 → container:80","source_id":"man7-iptables-8"}],"fix_steps":[{"step":1,"action":"App must bind 0.0.0.0","command":"# in app: bind 0.0.0.0:80, not 127.0.0.1:80","validation":"ss -tlnp shows 0.0.0.0:80","rollback":null,"source_id":"man7-bind-2"},{"step":2,"action":"Enable forwarding","command":"sudo sysctl -w net.ipv4.ip_forward=1 && echo 'net.ipv4.ip_forward=1' | sudo tee /etc/sysctl.d/99-ipfwd.conf","validation":"sysctl shows 1, persists across boots","rollback":"sysctl -w net.ipv4.ip_forward=0","source_id":"kernel-docs-net-sysctl"},{"step":3,"action":"Restart daemon to re-program iptables","command":"sudo systemctl restart docker","validation":"DOCKER chain repopulated","rollback":null,"source_id":"docker-docs-cli-dockerd"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["docker-docs-network-firewall","docker-docs-engine-daemon-troubleshoot"]},
  {"id":"docker.fm.disk-full-but-df-shows-free","symptom":"`docker pull` or `docker run` fails 'no space left on device'; `df` shows host has space","error_patterns":["no space left on device","ENOSPC","disk full"],"root_cause_class":"storage","affected_concepts":["docker.engine.cfg.daemon.json.data-root","docker.engine.cfg.daemon.json.storage-driver"],"diagnostic_steps":[{"step":1,"action":"Inspect docker disk usage","command":"docker system df -v","expected":"breakdown by images/containers/volumes/build-cache","source_id":"docker-cli-system-df"},{"step":2,"action":"Inspect docker root partition","command":"df -h $(docker info -f '{{.DockerRootDir}}')","expected":"may be different filesystem from /","source_id":"docker-cli-system-df"},{"step":3,"action":"Check inode usage","command":"df -i $(docker info -f '{{.DockerRootDir}}')","expected":"inodes-free count; many tiny files in image layers can exhaust inodes before bytes","source_id":"man7-statfs-2"}],"fix_steps":[{"step":1,"action":"Aggressive prune","command":"docker system prune -a --volumes","validation":"docker system df shows reclaimed space","rollback":"none — pruned data is gone","source_id":"docker-docs-manage-pruning"},{"step":2,"action":"Move data-root to larger volume","command":"# stop docker; move /var/lib/docker → larger fs; bind-mount or symlink; update daemon.json data-root; restart","validation":"docker info shows new dir","rollback":"reverse the move","source_id":"docker-docs-cli-dockerd"}],"confidence":0.92,"last_verified":"2026-05-03","source_ids":["docker-cli-system-df","docker-docs-manage-pruning","docker-docs-engine-daemon-troubleshoot"]},
  {"id":"docker.fm.compose-depends-on-wrong","symptom":"Service starts before dependency is actually ready (e.g. app errors connecting to DB despite depends_on)","error_patterns":["Connection refused","could not connect to server","ECONNREFUSED"],"root_cause_class":"orchestration","affected_concepts":["docker.compose.depends_on","docker.compose.healthcheck"],"diagnostic_steps":[{"step":1,"action":"Check depends_on syntax","command":"yq '.services.app.depends_on' docker-compose.yaml","expected":"if just `[db]`, only START order — not READY","source_id":"docker-docs-compose-startup-order"},{"step":2,"action":"Verify dep has healthcheck","command":"yq '.services.db.healthcheck' docker-compose.yaml","expected":"non-null","source_id":"compose-spec-05-services"}],"fix_steps":[{"step":1,"action":"Define healthcheck on dep","command":"# in db service: healthcheck: { test: ['CMD','pg_isready','-U','user'], interval: 5s, retries: 10 }","validation":"docker compose ps shows db (healthy)","rollback":"remove healthcheck","source_id":"compose-spec-05-services"},{"step":2,"action":"Use long-form depends_on with condition","command":"# depends_on: { db: { condition: service_healthy } }","validation":"app waits for db healthy before starting","rollback":"revert to short-form","source_id":"docker-docs-compose-startup-order"}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["docker-docs-compose-startup-order","compose-spec-05-services"]},
  {"id":"docker.fm.image-pull-private-registry-auth","symptom":"`docker pull` from private registry: `unauthorized: incorrect username or password` or `denied: requested access to the resource is denied`","error_patterns":["unauthorized","denied","authentication required"],"root_cause_class":"registry-auth","affected_concepts":["docker.engine.docker-cli","docker.engine.cfg.daemon.json.tls"],"diagnostic_steps":[{"step":1,"action":"Check current auth state","command":"cat ~/.docker/config.json | jq .auths","expected":"entry for the registry hostname","source_id":"docker-docs-engine-security"},{"step":2,"action":"Test auth manually","command":"curl -u USER:PASS https://<registry>/v2/","expected":"200 OK or 401","source_id":"docker-docs-daemon-remote-access"}],"fix_steps":[{"step":1,"action":"Re-login","command":"docker login <registry>","validation":"docker pull succeeds","rollback":"docker logout <registry>","source_id":"docker-docs-engine-security"},{"step":2,"action":"For ECR: refresh token","command":"aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin <account>.dkr.ecr.us-east-1.amazonaws.com","validation":"login successful","rollback":"docker logout","source_id":"docker-docs-engine-security"}],"confidence":0.93,"last_verified":"2026-05-03","source_ids":["docker-docs-engine-security","docker-docs-daemon-remote-access"]},
  {"id":"docker.fm.bind-mount-source-missing","symptom":"`docker run -v /host/path:/container/path` succeeds even though /host/path doesn't exist; container sees empty dir","error_patterns":["mount source missing","empty volume","unexpected empty dir"],"root_cause_class":"volume-misconfig","affected_concepts":["docker.engine.bind-mount","docker.engine.volume"],"diagnostic_steps":[{"step":1,"action":"Verify host path","command":"ls /host/path","expected":"either dir contents or 'No such file'","source_id":"man7-mount-8"},{"step":2,"action":"Check inspect result","command":"docker inspect <c> -f '{{json .Mounts}}'","expected":"Type=bind, Source=/host/path, Destination=/container/path","source_id":"docker-cli-container-inspect"}],"fix_steps":[{"step":1,"action":"Use --mount instead of -v","command":"docker run --mount type=bind,src=/host/path,dst=/container/path,readonly ...","validation":"errors out clearly if src missing","rollback":"revert to -v","source_id":"docker-cli-container-run"},{"step":2,"action":"Or pre-create source","command":"mkdir -p /host/path","validation":"path exists with expected contents","rollback":null,"source_id":"man7-mount-8"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["docker-docs-storage-bind-mounts","docker-cli-container-run"]},
  {"id":"docker.fm.docker-build-cache-not-hitting","symptom":"`docker build` re-runs RUN steps that should be cached","error_patterns":["RUN ... (cache miss)","--no-cache used"],"root_cause_class":"build-cache","affected_concepts":["docker.engine.image-layer","docker.build-buildkit.cache"],"diagnostic_steps":[{"step":1,"action":"Inspect what changed","command":"git diff Dockerfile","expected":"ONE early COPY/RUN line invalidates everything below","source_id":"docker-docs-build-cache"},{"step":2,"action":"Check timestamp / hash of COPY sources","command":"sha256sum <copied-files>","expected":"any change invalidates cache","source_id":"docker-docs-build-cache"}],"fix_steps":[{"step":1,"action":"Re-order Dockerfile: most-stable first","command":"# COPY package.json first, RUN npm ci, then COPY . . — protects npm-install cache","validation":"build skips earlier RUN","rollback":"revert order","source_id":"docker-docs-build-cache"},{"step":2,"action":"Use --cache-from for CI","command":"docker build --cache-from <prev-image> ...","validation":"cache reuses prior build's layers","rollback":"omit","source_id":"moby-buildkit-readme"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["docker-docs-build-cache","moby-buildkit-readme"]},
  {"id":"docker.fm.container-network-host-mode-permission","symptom":"`docker run --network=host` requires root or fails","error_patterns":["operation not permitted","permission denied"],"root_cause_class":"capabilities","affected_concepts":["linux.primitives.cap-flag.cap-net-admin","docker.engine.cfg.daemon.json.userns-remap"],"diagnostic_steps":[{"step":1,"action":"Check rootless mode","command":"docker info | grep -i rootless","expected":"if Rootless=true, host networking has restrictions","source_id":"docker-docs-engine-security"},{"step":2,"action":"Check userns-remap setting","command":"docker info | grep -i 'Userns Remap'","expected":"empty (or 'default')","source_id":"docker-docs-cli-dockerd"}],"fix_steps":[{"step":1,"action":"Avoid --network=host where possible","command":"# use bridge with -p","validation":"network reachable via published ports","rollback":null,"source_id":"docker-cli-container-run"},{"step":2,"action":"For rootless: enable slirp4netns/lxc-user-nic","command":"# follow rootless install guide","validation":"rootless host networking via slirp","rollback":"reinstall rootful","source_id":"docker-docs-engine-security"}],"confidence":0.8,"last_verified":"2026-05-03","source_ids":["docker-docs-engine-security","docker-docs-rootless-troubleshoot"]},
  {"id":"docker.fm.exit-126-not-executable","symptom":"Container exit code 126","error_patterns":["exec format error","not executable","exec /entrypoint.sh: exec format error"],"root_cause_class":"image-build","affected_concepts":["docker.engine.image","linux.primitives.execve-syscall"],"diagnostic_steps":[{"step":1,"action":"Check entrypoint executable bit","command":"docker run <image> ls -l /entrypoint.sh","expected":"rwxr-xr-x","source_id":"docker-cli-container-run"},{"step":2,"action":"Check shebang","command":"docker run <image> head -1 /entrypoint.sh","expected":"#!/bin/sh or #!/bin/bash with NO Windows CRLF","source_id":"docker-cli-container-run"},{"step":3,"action":"Check architecture","command":"docker inspect <image> --format '{{.Architecture}}'","expected":"matches host (amd64 vs arm64)","source_id":"docker-cli-container-inspect"}],"fix_steps":[{"step":1,"action":"chmod in Dockerfile","command":"# RUN chmod +x /entrypoint.sh","validation":"docker run image ls -l shows x bit","rollback":"revert Dockerfile","source_id":"docker-docs-engine-daemon-troubleshoot"},{"step":2,"action":"Convert CRLF to LF","command":"# sed -i 's/\\r$//' entrypoint.sh in build","validation":"file shows no CR","rollback":"git checkout","source_id":"docker-cli-container-run"},{"step":3,"action":"Multi-arch build","command":"docker buildx build --platform linux/amd64,linux/arm64 ...","validation":"manifest lists both archs","rollback":"single-arch","source_id":"moby-buildkit-multi-platform"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["docker-docs-engine-daemon-troubleshoot","moby-buildkit-multi-platform"]},
  {"id":"docker.fm.exit-127-command-not-found","symptom":"Container exit code 127","error_patterns":["command not found","executable file not found in $PATH","exec /bin/sh: no such file or directory"],"root_cause_class":"image-build","affected_concepts":["docker.engine.image"],"diagnostic_steps":[{"step":1,"action":"Verify command path in image","command":"docker run --rm --entrypoint='' <image> which <cmd>","expected":"path","source_id":"docker-cli-container-run"},{"step":2,"action":"For distroless: shell may not exist","command":"docker run --rm --entrypoint='' <image> ls /bin/sh","expected":"no such file = it's a distroless image","source_id":"iximiuz-debugger-images"}],"fix_steps":[{"step":1,"action":"For distroless, debug via debug-sidecar","command":"docker run --rm -it --pid=container:<other> nicolaka/netshoot","validation":"can inspect target's processes","rollback":null,"source_id":"iximiuz-debugger-images"},{"step":2,"action":"Add full path in CMD","command":"# CMD [\"/usr/local/bin/myapp\"]","validation":"app starts","rollback":null,"source_id":"docker-cli-container-run"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["iximiuz-debugger-images","docker-cli-container-run"]},
  {"id":"docker.fm.docker-network-create-conflict","symptom":"`docker network create` fails with `Pool overlaps with other one on this address space`","error_patterns":["Pool overlaps","address space conflict"],"root_cause_class":"networking","affected_concepts":["docker.networking.bridge-network","docker.engine.cfg.daemon.json.bip"],"diagnostic_steps":[{"step":1,"action":"List existing networks","command":"docker network ls && docker network inspect $(docker network ls -q) --format '{{.Name}}: {{range .IPAM.Config}}{{.Subnet}} {{end}}'","expected":"see all assigned subnets","source_id":"docker-docs-network-bridge"}],"fix_steps":[{"step":1,"action":"Specify non-conflicting subnet","command":"docker network create --subnet=172.30.0.0/24 mynet","validation":"network created","rollback":"docker network rm mynet","source_id":"docker-docs-network-bridge"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.fm.iptables-docker-chain-missing","symptom":"`docker -p 80:8080` published but DNAT rule missing in iptables; daemon-restart didn't fix","error_patterns":["No DOCKER chain","iptables: Chain not found"],"root_cause_class":"networking","affected_concepts":["docker.engine.cfg.daemon.json.iptables","linux.networking.netfilter-hook-chain"],"diagnostic_steps":[{"step":1,"action":"Check daemon iptables config","command":"docker info 2>&1 | grep -i iptables; cat /etc/docker/daemon.json | jq .iptables","expected":"daemon should manage iptables (true)","source_id":"docker-docs-cli-dockerd"},{"step":2,"action":"Check kernel modules","command":"lsmod | grep -E 'iptable|netfilter'","expected":"iptable_nat, iptable_filter loaded","source_id":"man7-iptables-8"}],"fix_steps":[{"step":1,"action":"Re-enable daemon iptables management","command":"# in /etc/docker/daemon.json: \"iptables\": true; systemctl restart docker","validation":"DOCKER chain populated","rollback":"\"iptables\": false","source_id":"docker-docs-cli-dockerd"},{"step":2,"action":"Load kernel modules","command":"sudo modprobe iptable_nat iptable_filter; echo iptable_nat | sudo tee /etc/modules-load.d/iptables.conf","validation":"lsmod shows them","rollback":"rmmod","source_id":"man7-iptables-8"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["docker-docs-network-firewall","docker-docs-cli-dockerd"]},
  {"id":"docker.fm.cgroup-driver-mismatch","symptom":"Containers fail to start; kubelet logs 'Failed to start ContainerManager: ...cgroup driver: systemd vs cgroupfs'","error_patterns":["cgroup driver","systemd vs cgroupfs","container runtime is cgroupfs"],"root_cause_class":"runtime-mismatch","affected_concepts":["k8s.runtime.cgroup-driver-systemd","docker.engine.cfg.daemon.json.cgroup-driver"],"diagnostic_steps":[{"step":1,"action":"Check daemon driver","command":"docker info | grep -i 'Cgroup Driver'","expected":"systemd or cgroupfs","source_id":"docker-docs-cli-dockerd"},{"step":2,"action":"Check kubelet driver","command":"grep cgroupDriver /var/lib/kubelet/config.yaml","expected":"systemd (recommended)","source_id":"k8s-cgroups"}],"fix_steps":[{"step":1,"action":"Set daemon to systemd","command":"# in /etc/docker/daemon.json: \"exec-opts\":[\"native.cgroupdriver=systemd\"]; restart docker","validation":"docker info shows systemd","rollback":"remove key","source_id":"docker-docs-cli-dockerd"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["docker-docs-cli-dockerd","k8s-cgroups"]},
  {"id":"docker.fm.userns-remap-permissions","symptom":"With `userns-remap` enabled, container can't write to host bind-mount; permission denied","error_patterns":["permission denied","operation not permitted"],"root_cause_class":"namespace-isolation","affected_concepts":["docker.engine.cfg.daemon.json.userns-remap","linux.primitives.user-namespace-uid-mapping"],"diagnostic_steps":[{"step":1,"action":"Check effective UID","command":"docker exec <c> id","expected":"uid = 0 inside (mapped to dockremap on host)","source_id":"man7-user-namespaces-7"},{"step":2,"action":"Check host file ownership","command":"ls -ln /host/path","expected":"file owned by some host UID","source_id":"man7-stat-2"},{"step":3,"action":"Look up dockremap base UID","command":"grep dockremap /etc/subuid","expected":"e.g. dockremap:100000:65536","source_id":"man7-user-namespaces-7"}],"fix_steps":[{"step":1,"action":"chown host path to dockremap range","command":"sudo chown -R 100000:100000 /host/path","validation":"container can write","rollback":"sudo chown -R orig:orig /host/path","source_id":"man7-user-namespaces-7"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["docker-docs-cli-dockerd","docker-docs-engine-security"]},
  {"id":"docker.fm.dns-not-resolving-from-container","symptom":"Container can't resolve DNS — `getent hosts example.com` fails inside","error_patterns":["could not resolve","Name or service not known","Temporary failure in name resolution"],"root_cause_class":"dns","affected_concepts":["linux.networking.dns-resolver-glibc","docker.engine.cfg.daemon.json.dns"],"diagnostic_steps":[{"step":1,"action":"Check container's resolv.conf","command":"docker exec <c> cat /etc/resolv.conf","expected":"nameserver entries","source_id":"man7-resolv-conf-5"},{"step":2,"action":"Test from host","command":"getent hosts example.com","expected":"resolves","source_id":"man7-getent-1"},{"step":3,"action":"Inspect daemon DNS config","command":"docker inspect <c> --format '{{json .HostConfig.Dns}}'","expected":"empty (uses host's) or list","source_id":"docker-cli-container-inspect"}],"fix_steps":[{"step":1,"action":"Set --dns","command":"docker run --dns=8.8.8.8 ...","validation":"resolution works","rollback":"omit --dns","source_id":"docker-cli-container-run"},{"step":2,"action":"Or set daemon-wide","command":"# in daemon.json: \"dns\": [\"8.8.8.8\"]; restart","validation":"new containers use","rollback":"remove key","source_id":"docker-docs-cli-dockerd"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["docker-docs-cli-dockerd"]},
  {"id":"docker.fm.live-restore-skipped-version","symptom":"Container died on docker daemon major-version upgrade despite live-restore=true","error_patterns":["live restore unavailable","major version upgrade"],"root_cause_class":"daemon-upgrade","affected_concepts":["docker.engine.live-restore"],"diagnostic_steps":[{"step":1,"action":"Check old vs new daemon version","command":"docker version --format '{{.Server.Version}}'","expected":"e.g. 24.x → 26.x is major bump (live-restore unsupported)","source_id":"docker-docs-daemon-live-restore"}],"fix_steps":[{"step":1,"action":"Patch upgrades only","command":"# upgrade 24.0.7 → 24.0.8 OK; 24.x → 26.x: stop containers first","validation":"docker info shows new patch version, containers running","rollback":"package downgrade","source_id":"docker-docs-daemon-live-restore"}],"confidence":0.9,"last_verified":"2026-05-03","source_ids":["docker-docs-daemon-live-restore"]},
  {"id":"docker.fm.compose-volume-named-vs-anon","symptom":"After `docker compose down -v`, named volumes preserved unintentionally OR anonymous volumes leaking","error_patterns":["volume already exists","leaked volumes","disk full from volumes"],"root_cause_class":"volume-misconfig","affected_concepts":["docker.engine.named-volume","docker.engine.anonymous-volume"],"diagnostic_steps":[{"step":1,"action":"List volumes","command":"docker volume ls; docker volume ls -q -f dangling=true","expected":"named (top-level volumes:) + anonymous","source_id":"docker-docs-storage-volumes"}],"fix_steps":[{"step":1,"action":"Distinguish in compose","command":"# volumes: { dbdata: {} } + service.volumes: [\"dbdata:/var/lib/db\"]","validation":"named volume reused; not in dangling","rollback":"convert to bind","source_id":"compose-spec-09-volumes"},{"step":2,"action":"Prune anonymous","command":"docker volume prune","validation":"reclaimed","rollback":"none","source_id":"docker-docs-manage-pruning"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["docker-docs-storage-volumes","docker-docs-manage-pruning"]},
  {"id":"docker.fm.exit-125-daemon-error","symptom":"`docker run` exits 125 immediately","error_patterns":["docker: Error response from daemon","exit code 125"],"root_cause_class":"daemon-error","affected_concepts":["docker.engine.dockerd","docker.engine.cmd.container-run"],"diagnostic_steps":[{"step":1,"action":"Read full daemon error","command":"docker run ... 2>&1","expected":"detailed error message after 'Error response from daemon:'","source_id":"docker-cli-container-run"},{"step":2,"action":"Common: invalid flag combo","command":"# read message — e.g. 'conflicting options: --volume and --volumes-from'","expected":"specific flag conflict","source_id":"docker-cli-container-run"}],"fix_steps":[{"step":1,"action":"Fix flag conflict","command":"# remove conflicting flag, retry","validation":"container starts (or different error)","rollback":null,"source_id":"docker-cli-container-run"}],"confidence":0.8,"last_verified":"2026-05-03","source_ids":["docker-cli-container-run","docker-docs-engine-daemon-troubleshoot"]},
  {"id":"docker.fm.healthcheck-flapping","symptom":"Container repeatedly transitions between healthy/unhealthy","error_patterns":["health check failing","healthcheck timeout"],"root_cause_class":"app-health","affected_concepts":["docker.engine.health-check"],"diagnostic_steps":[{"step":1,"action":"Read healthcheck config","command":"docker inspect <c> --format '{{json .Config.Healthcheck}}'","expected":"shows test, interval, timeout, retries","source_id":"docker-cli-container-inspect"},{"step":2,"action":"Read health log","command":"docker inspect <c> --format '{{json .State.Health}}' | jq .","expected":"Status, FailingStreak, Log entries","source_id":"docker-cli-container-inspect"},{"step":3,"action":"Manually run check","command":"docker exec <c> <healthcheck-cmd>","expected":"exit 0 if healthy","source_id":"docker-cli-container-exec"}],"fix_steps":[{"step":1,"action":"Bump timeout/interval","command":"# in compose / Dockerfile: HEALTHCHECK --interval=30s --timeout=10s --start-period=60s","validation":"no flapping","rollback":"revert","source_id":"docker-cli-container-run"}],"confidence":0.85,"last_verified":"2026-05-03","source_ids":["docker-cli-container-run","docker-docs-engine-daemon-troubleshoot"]},
  {"id":"docker.fm.buildkit-secret-leaked","symptom":"Secret accidentally baked into image (visible in `docker history`)","error_patterns":["secret in image","credentials in layer"],"root_cause_class":"build-security","affected_concepts":["docker.build-buildkit.secret-mount"],"diagnostic_steps":[{"step":1,"action":"Inspect image history","command":"docker history <image> --no-trunc","expected":"see ENV / RUN with secret value","source_id":"docker-docs-engine-daemon-troubleshoot"},{"step":2,"action":"Search filesystem","command":"docker run --rm <image> grep -r 'secret-pattern' /","expected":"matches = leaked","source_id":"docker-cli-container-run"}],"fix_steps":[{"step":1,"action":"Use BuildKit --mount=type=secret","command":"# RUN --mount=type=secret,id=foo cat /run/secrets/foo","validation":"docker build --secret id=foo,src=./secret; image history shows no secret","rollback":"revert Dockerfile","source_id":"moby-buildkit-readme"},{"step":2,"action":"Rotate the leaked secret","command":"# rotate at source (AWS, vault, etc.); push new image","validation":"old secret invalid","rollback":null,"source_id":null}],"confidence":0.95,"last_verified":"2026-05-03","source_ids":["moby-buildkit-readme","docker-docs-engine-security"]}
