[
  {"id":"docker.networking.cfg.network-create-flag.driver","scope":"network-create-flag","key":"-d, --driver","type":"enum[bridge|host|overlay|ipvlan|macvlan|none|<plugin>]","default_value":"bridge","description":"Network driver. Plugin names allowed for third-party drivers.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.subnet","scope":"network-create-flag","key":"--subnet","type":"list[CIDR]","default_value":"[]","description":"IPv4/IPv6 subnet. Repeatable for v4+v6.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.ip-range","scope":"network-create-flag","key":"--ip-range","type":"list[CIDR]","default_value":"[]","description":"Sub-range of --subnet for auto-assignment. Static-pin IPs (--ip on `network connect`) can still be outside the range.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.gateway","scope":"network-create-flag","key":"--gateway","type":"list[IP]","default_value":"first usable","description":"Gateway IP for each subnet.","source_ids":["docker-cli-network-create","docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.aux-address","scope":"network-create-flag","key":"--aux-address","type":"map<key,IP>","default_value":"{}","description":"Reserve specific IPs (e.g. existing routers in a macvlan subnet). e.g. `--aux-address my-router=192.168.32.129`.","source_ids":["docker-cli-network-create","docker-docs-network-macvlan"]},
  {"id":"docker.networking.cfg.network-create-flag.ipv6","scope":"network-create-flag","key":"--ipv6","type":"bool","default_value":"false","description":"Enable IPv6 on this network.","source_ids":["docker-cli-network-create","docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.ipv4","scope":"network-create-flag","key":"--ipv4","type":"bool","default_value":"true","description":"Enable IPv4 (default true). Set false + --ipv6 for IPv6-only network.","source_ids":["docker-cli-network-create","docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.ipam-driver","scope":"network-create-flag","key":"--ipam-driver","type":"string","default_value":"default","description":"IP-address-management driver. `default` is built-in; pluggable for vendor IPAM.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.ipam-opt","scope":"network-create-flag","key":"--ipam-opt","type":"map<key,val>","default_value":"{}","description":"IPAM driver-specific options.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.opt","scope":"network-create-flag","key":"-o, --opt","type":"map<key,val>","default_value":"{}","description":"Driver-specific option. Repeatable. Keys depend on driver — see bridge-driver-opt / overlay-driver-opt / ipvlan-driver-opt / macvlan-driver-opt scopes.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.scope","scope":"network-create-flag","key":"--scope","type":"enum[local|swarm]","default_value":"per-driver","description":"Network scope. bridge defaults local; overlay defaults swarm.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.attachable","scope":"network-create-flag","key":"--attachable","type":"bool","default_value":"false","description":"Overlay-specific. Allow standalone containers to attach (otherwise only Swarm services can).","source_ids":["docker-cli-network-create","docker-docs-network-overlay"]},
  {"id":"docker.networking.cfg.network-create-flag.internal","scope":"network-create-flag","key":"--internal","type":"bool","default_value":"false","description":"Restrict external access. No NAT/MASQUERADE; cluster-internal only.","source_ids":["docker-cli-network-create","docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.ingress","scope":"network-create-flag","key":"--ingress","type":"bool","default_value":"false","description":"Create the swarm routing-mesh ingress network. Only one ingress per swarm.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.config-from","scope":"network-create-flag","key":"--config-from","type":"string","default_value":"\"\"","description":"Copy IPAM/options from a config-only network template.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.config-only","scope":"network-create-flag","key":"--config-only","type":"bool","default_value":"false","description":"Create a config-only network (template; not directly usable).","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.label","scope":"network-create-flag","key":"--label","type":"list<key=val>","default_value":"[]","description":"Network metadata. Surfaced in `docker network ls --filter label=`.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.publish-mode-vip-vs-dnsrr","scope":"network-create-flag","key":"--ingress (publish-mode VIP)","type":"VIP-only","default_value":null,"description":"Ingress overlay uses VIP-based endpoint mode by default; for >256 IPs use dnsrr endpoint mode + external LB. Documented as a swarm tradeoff in `docker-cli-network-create`.","source_ids":["docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.attach-host-network","scope":"network-create-flag","key":"<host-network has no opts>","type":"\"\"","default_value":null,"description":"Host driver doesn't accept any --opt — it's just a marker. Documented in `docker-docs-network-host`.","source_ids":["docker-docs-network-host"]},
  {"id":"docker.networking.cfg.network-create-flag.run-network","scope":"network-create-flag","key":"docker run --network <name>","type":"string","default_value":"bridge","description":"Per-run override of the network a container attaches to. `host`, `none`, `container:<id>`, `<name>`. Repeatable to attach to multiple networks at create.","source_ids":["docker-docs-network-bridge","docker-docs-network-host","docker-docs-network-none"]},
  {"id":"docker.networking.cfg.network-create-flag.network-alias","scope":"network-create-flag","key":"docker run --network-alias","type":"list[string]","default_value":"[]","description":"DNS aliases for the container on user-defined bridges/overlays. Repeatable. Equivalent to network-create's `--alias`.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.connect-alias","scope":"network-create-flag","key":"docker network connect --alias","type":"list[string]","default_value":"[]","description":"Same as --network-alias but applied to a running container's new endpoint.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.connect-ip","scope":"network-create-flag","key":"docker network connect --ip","type":"IPv4","default_value":null,"description":"Pin static IPv4 on the new endpoint. Network must have --subnet.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.connect-ip6","scope":"network-create-flag","key":"docker network connect --ip6","type":"IPv6","default_value":null,"description":"Pin static IPv6 on the new endpoint.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.connect-link","scope":"network-create-flag","key":"docker network connect --link","type":"list<container:alias>","default_value":"[]","description":"Add legacy --link entries (default-bridge only). Otherwise use embedded DNS.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.disconnect-force","scope":"network-create-flag","key":"docker network disconnect -f, --force","type":"bool","default_value":"false","description":"Force-disconnect even if container uses the network as its default.","source_ids":["docker-docs-network-bridge","docker-cli-network-create"]},
  {"id":"docker.networking.cfg.network-create-flag.run-mac-address","scope":"network-create-flag","key":"docker run --mac-address","type":"MAC","default_value":null,"description":"Pin a specific MAC for the container's endpoint.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.run-add-host","scope":"network-create-flag","key":"docker run --add-host","type":"list<host:ip>","default_value":"[]","description":"Add /etc/hosts entries. Special token `host-gateway` resolves to the host's IP (per daemon `host-gateway-ip`).","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.run-link-local-ip","scope":"network-create-flag","key":"docker run --link-local-ip","type":"list[IP]","default_value":"[]","description":"Per-container link-local IPv4/IPv6 addresses.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.network-create-flag.run-publish-all","scope":"network-create-flag","key":"docker run -P, --publish-all","type":"bool","default_value":"false","description":"Auto-publish every EXPOSE'd port to a random ephemeral host port.","source_ids":["docker-docs-network-port-publishing"]},

  {"id":"docker.networking.cfg.bridge-driver-opt.bridge-name","scope":"bridge-driver-opt","key":"com.docker.network.bridge.name","type":"string","default_value":"docker0 (default network); auto for user-defined","description":"Linux bridge interface name to create.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.enable-ip-masquerade","scope":"bridge-driver-opt","key":"com.docker.network.bridge.enable_ip_masquerade","type":"bool","default_value":"true","description":"Enable SNAT/MASQUERADE for outbound container traffic. Daemon-wide alias: --ip-masq.","source_ids":["docker-docs-network-bridge","docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.enable-icc","scope":"bridge-driver-opt","key":"com.docker.network.bridge.enable_icc","type":"bool","default_value":"true","description":"Enable inter-container communication on this bridge. Daemon-wide alias: --icc.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.host-binding-ipv4","scope":"bridge-driver-opt","key":"com.docker.network.bridge.host_binding_ipv4","type":"IPv4 (or IPv6 — name is misleading)","default_value":"0.0.0.0","description":"Default host address for `-p containerPort` (no host IP given). Set to `127.0.0.1` to default-bind only loopback. Daemon-wide alias: --ip.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.driver-mtu","scope":"bridge-driver-opt","key":"com.docker.network.driver.mtu","type":"int","default_value":"0 (no limit)","description":"MTU on this network's interfaces. Lower (1450) when behind GRE/IPsec/VXLAN. Daemon-wide alias: --mtu.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.container-iface-prefix","scope":"bridge-driver-opt","key":"com.docker.network.container_iface_prefix","type":"string","default_value":"eth","description":"Naming prefix for the container-side veth (eth0, eth1, …).","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.inhibit-ipv4","scope":"bridge-driver-opt","key":"com.docker.network.bridge.inhibit_ipv4","type":"bool","default_value":"false","description":"Skip assigning an IP address to the bridge itself (advanced; for setups doing custom routing).","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.gateway-mode-ipv4","scope":"bridge-driver-opt","key":"com.docker.network.bridge.gateway_mode_ipv4","type":"enum[nat|isolated|nat-unprotected]","default_value":"nat","description":"IPv4 gateway mode. `isolated` = no MASQUERADE, no port-publish DNAT. See `docker-docs-network-firewall`.","source_ids":["docker-docs-network-bridge","docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.gateway-mode-ipv6","scope":"bridge-driver-opt","key":"com.docker.network.bridge.gateway_mode_ipv6","type":"enum[nat|isolated|nat-unprotected]","default_value":"nat","description":"IPv6 gateway mode counterpart.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.host-ipv4","scope":"bridge-driver-opt","key":"com.docker.network.host_ipv4","type":"IPv4","default_value":null,"description":"Source NAT address (override of host's selected interface). See packet-filtering doc.","source_ids":["docker-docs-network-bridge","docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.host-ipv6","scope":"bridge-driver-opt","key":"com.docker.network.host_ipv6","type":"IPv6","default_value":null,"description":"Source NAT address (IPv6).","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.default-bridge","scope":"bridge-driver-opt","key":"com.docker.network.bridge.default_bridge","type":"bool","default_value":"true (only on the default bridge)","description":"Marker option set on the auto-created default bridge — surfaced in `docker network inspect`.","source_ids":["docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.trusted-host-interfaces","scope":"bridge-driver-opt","key":"com.docker.network.bridge.trusted_host_interfaces","type":"string (comma-sep iface list)","default_value":null,"description":"Override which host interfaces this bridge implicitly trusts for inbound traffic.","source_ids":["docker-docs-network-bridge","docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.disable-icc-via-iptables","scope":"bridge-driver-opt","key":"com.docker.network.bridge.disable_iptables_icc","type":"bool","default_value":"false","description":"Block inter-container communication via iptables FILTER rules instead of relying on Linux bridge filtering.","source_ids":["docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.bridge-driver-opt.bridge-default-driver","scope":"bridge-driver-opt","key":"-o (any unspecified)","type":"docs cross-ref","default_value":null,"description":"Daemon-wide `default-network-opts.bridge.<key>` provides defaults applied to every newly-created bridge network — use to set a global MTU or default ICC mode.","source_ids":["docker-docs-network-bridge"]},

  {"id":"docker.networking.cfg.overlay-driver-opt.encrypted","scope":"overlay-driver-opt","key":"encrypted","type":"bool (presence flag)","default_value":"false","description":"Enable IPsec encryption at the VXLAN layer. Non-trivial CPU cost. NOT supported for Windows containers.","source_ids":["docker-docs-network-overlay"]},
  {"id":"docker.networking.cfg.overlay-driver-opt.vxlanid-list","scope":"overlay-driver-opt","key":"com.docker.network.driver.overlay.vxlanid_list","type":"string (comma list of ints)","default_value":"auto","description":"Pin VXLAN VNI(s). Useful for interoperability with non-Docker VXLAN endpoints.","source_ids":["docker-docs-network-overlay","docker-cli-network-inspect"]},
  {"id":"docker.networking.cfg.overlay-driver-opt.driver-mtu","scope":"overlay-driver-opt","key":"com.docker.network.driver.mtu","type":"int","default_value":"1450 (50 below host MTU for VXLAN encap overhead)","description":"Overlay MTU. The 50-byte budget covers VXLAN+UDP+IP headers.","source_ids":["docker-docs-network-overlay"]},
  {"id":"docker.networking.cfg.overlay-driver-opt.subnet-default-blocksize","scope":"overlay-driver-opt","key":"--subnet (recommended /24 for swarm services)","type":"CIDR","default_value":"/24","description":"Per docs, /24 is the recommended block for VIP-mode swarm services. >256 IPs requires dnsrr endpoint mode + external LB.","source_ids":["docker-cli-network-create","docker-docs-network-overlay"]},
  {"id":"docker.networking.cfg.overlay-driver-opt.attachable","scope":"overlay-driver-opt","key":"--attachable (network-create flag, but overlay-specific semantics)","type":"bool","default_value":"false","description":"Required to attach standalone containers to an overlay (Swarm services attach by default).","source_ids":["docker-docs-network-overlay","docker-cli-network-create"]},
  {"id":"docker.networking.cfg.overlay-driver-opt.swarm-control-port","scope":"overlay-driver-opt","key":"swarm control plane port","type":"int (tcp)","default_value":"2377","description":"`docker swarm join --listen-addr` configurable. Required between hosts.","source_ids":["docker-docs-network-overlay"]},
  {"id":"docker.networking.cfg.overlay-driver-opt.vxlan-data-port","scope":"overlay-driver-opt","key":"VXLAN data-plane port","type":"int (udp)","default_value":"4789","description":"`docker swarm init --data-path-addr/--data-path-port` configurable. Required UDP between hosts.","source_ids":["docker-docs-network-overlay"]},
  {"id":"docker.networking.cfg.overlay-driver-opt.gossip-tcp","scope":"overlay-driver-opt","key":"swarm gossip port (tcp)","type":"int (tcp)","default_value":"7946","description":"NOT configurable. Required TCP between hosts.","source_ids":["docker-docs-network-overlay"]},
  {"id":"docker.networking.cfg.overlay-driver-opt.gossip-udp","scope":"overlay-driver-opt","key":"swarm gossip port (udp)","type":"int (udp)","default_value":"7946","description":"NOT configurable. Required UDP between hosts.","source_ids":["docker-docs-network-overlay"]},
  {"id":"docker.networking.cfg.overlay-driver-opt.encrypted-windows-warning","scope":"overlay-driver-opt","key":"encrypted (Windows containers)","type":"unsupported","default_value":null,"description":"Swarm doesn't error when Windows hosts attach to encrypted overlays, but networking for Windows containers becomes broken. Use unencrypted overlays for Windows.","source_ids":["docker-docs-network-overlay"]},

  {"id":"docker.networking.cfg.ipvlan-driver-opt.mode","scope":"ipvlan-driver-opt","key":"ipvlan_mode","type":"enum[l2|l3|l3s]","default_value":"l2","description":"IPvlan operating mode. l2 = container interfaces sit on parent's L2; l3/l3s = host routes between subnets.","source_ids":["docker-docs-network-ipvlan"]},
  {"id":"docker.networking.cfg.ipvlan-driver-opt.flag","scope":"ipvlan-driver-opt","key":"ipvlan_flag","type":"enum[bridge|private|vepa]","default_value":"bridge","description":"Sub-mode flag. private = no inter-container traffic via parent; vepa = traffic goes out parent and back via reflective relay.","source_ids":["docker-docs-network-ipvlan"]},
  {"id":"docker.networking.cfg.ipvlan-driver-opt.parent","scope":"ipvlan-driver-opt","key":"parent","type":"string (interface)","default_value":"dummy auto-created if omitted","description":"Host interface or sub-interface (e.g. eth0, eth0.10). Sub-interfaces with a `.` are created on the fly.","source_ids":["docker-docs-network-ipvlan"]},
  {"id":"docker.networking.cfg.ipvlan-driver-opt.kernel-min-version","scope":"ipvlan-driver-opt","key":"kernel >= 4.2 (recommended)","type":"requirement","default_value":null,"description":"IPvlan present in earlier kernels but buggy. Verify with `uname -r`.","source_ids":["docker-docs-network-ipvlan"]},
  {"id":"docker.networking.cfg.ipvlan-driver-opt.l2-host-isolation","scope":"ipvlan-driver-opt","key":"l2 host-side restriction","type":"property","default_value":null,"description":"Containers on an ipvlan L2 network CAN'T ping the parent host on the same parent (kernel filter for additional isolation).","source_ids":["docker-docs-network-ipvlan"]},
  {"id":"docker.networking.cfg.ipvlan-driver-opt.l3-vlan-trunk","scope":"ipvlan-driver-opt","key":"802.1Q trunk via parent.<vid>","type":"property","default_value":null,"description":"Specify `parent=eth0.<vid>` to attach to an 802.1Q VLAN sub-interface; Docker creates the sub-interface on the fly.","source_ids":["docker-docs-network-ipvlan"]},
  {"id":"docker.networking.cfg.ipvlan-driver-opt.no-iptables","scope":"ipvlan-driver-opt","key":"iptables NOT created","type":"property","default_value":null,"description":"Per docker-docs-network-firewall: 'No rules are created for ipvlan, macvlan or host networking.' Containers handle their own routing.","source_ids":["docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.ipvlan-driver-opt.no-port-publish","scope":"ipvlan-driver-opt","key":"port-publish unsupported in L2","type":"property","default_value":null,"description":"L2 mode containers get directly-routable IPs; `-p`/--publish has no effect because there's no DNAT layer.","source_ids":["docker-docs-network-ipvlan"]},

  {"id":"docker.networking.cfg.macvlan-driver-opt.mode","scope":"macvlan-driver-opt","key":"macvlan_mode","type":"enum[bridge|private|vepa|passthru]","default_value":"bridge","description":"Macvlan mode. bridge = default; private = no inter-container; vepa = reflective relay required upstream; passthru = single MAC per parent (passthrough).","source_ids":["docker-docs-network-macvlan"]},
  {"id":"docker.networking.cfg.macvlan-driver-opt.parent","scope":"macvlan-driver-opt","key":"parent","type":"string (interface)","default_value":null,"description":"Host interface (e.g. eth0). For 802.1Q trunk, use `parent=eth0.<vid>` — Docker creates the sub-interface.","source_ids":["docker-docs-network-macvlan"]},
  {"id":"docker.networking.cfg.macvlan-driver-opt.kernel-min-version","scope":"macvlan-driver-opt","key":"kernel >= 3.9 (4.0+ recommended)","type":"requirement","default_value":null,"description":"Older kernels lack stable macvlan driver.","source_ids":["docker-docs-network-macvlan"]},
  {"id":"docker.networking.cfg.macvlan-driver-opt.cloud-restriction","scope":"macvlan-driver-opt","key":"cloud-provider unsupported (typical)","type":"property","default_value":null,"description":"Most cloud NICs block macvlan because they limit MAC count per port. Need physical access to enable.","source_ids":["docker-docs-network-macvlan"]},
  {"id":"docker.networking.cfg.macvlan-driver-opt.host-comm-restriction","scope":"macvlan-driver-opt","key":"container-to-host blocked","type":"property","default_value":null,"description":"Linux kernel restriction: macvlan containers can't talk to the host directly. Workaround: also attach a bridge network, OR create a host-side macvlan iface in the same subnet.","source_ids":["docker-docs-network-macvlan"]},
  {"id":"docker.networking.cfg.macvlan-driver-opt.rootless-unsupported","scope":"macvlan-driver-opt","key":"rootless mode: NOT supported","type":"property","default_value":null,"description":"Macvlan needs CAP_NET_ADMIN on the parent — incompatible with rootless dockerd.","source_ids":["docker-docs-network-macvlan"]},
  {"id":"docker.networking.cfg.macvlan-driver-opt.no-iptables","scope":"macvlan-driver-opt","key":"iptables NOT created","type":"property","default_value":null,"description":"Same as ipvlan: no iptables rules created for macvlan networking.","source_ids":["docker-docs-network-firewall"]},

  {"id":"docker.networking.cfg.port-publish-syntax.host-port-container-port","scope":"port-publish-syntax","key":"host-port:container-port","type":"-p syntax","default_value":null,"description":"Form: `-p 8080:80`. Bind container port 80 to host's 8080 on all interfaces.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.host-ip-host-port-container-port","scope":"port-publish-syntax","key":"host-ip:host-port:container-port","type":"-p syntax","default_value":null,"description":"`-p 127.0.0.1:8080:80` — bind only to 127.0.0.1.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.colon-container-port","scope":"port-publish-syntax","key":":container-port","type":"-p syntax","default_value":null,"description":"`-p :80` — random ephemeral host port. Equivalent to a single -P entry for one port.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.proto-suffix","scope":"port-publish-syntax","key":"<port>/proto","type":"udp|tcp|sctp","default_value":"tcp","description":"Append `/udp` or `/sctp` to specify non-TCP protocols. e.g. `-p 53:53/udp`.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.host-port-range","scope":"port-publish-syntax","key":"host-range:container-port","type":"-p syntax","default_value":null,"description":"`-p 8000-9000:5000` — bind container's 5000 to a randomly available host port between 8000 and 9000.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.host-ip-colon-colon-container-port","scope":"port-publish-syntax","key":"host-ip::container-port","type":"-p syntax","default_value":null,"description":"`-p 127.0.0.1::5000` — bind to a dynamic host port on a specific host IP.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.publish-all-flag","scope":"port-publish-syntax","key":"-P, --publish-all","type":"bool","default_value":"false","description":"Auto-publish every EXPOSE'd port to a random ephemeral host port.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.expose-vs-publish","scope":"port-publish-syntax","key":"EXPOSE vs --publish","type":"semantic","default_value":null,"description":"EXPOSE in Dockerfile is metadata only — doesn't actually publish. -P consumes EXPOSE entries; -p ignores them. Common confusion.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.port-conflict","scope":"port-publish-syntax","key":"port-allocated error","type":"failure","default_value":null,"description":"`Bind for 0.0.0.0:80 failed: port is already allocated`. Cause: another process or container holds the port. Diagnose: `ss -tlnp`, `docker ps --filter publish=80`.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.repeat-flag","scope":"port-publish-syntax","key":"-p (repeatable)","type":"property","default_value":null,"description":"`-p` can appear multiple times to publish multiple ports.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.docker-port","scope":"port-publish-syntax","key":"docker port <container> [<port>[/<proto>]]","type":"introspection","default_value":null,"description":"Read back live host bindings. Required for -P (random) ports.","source_ids":["docker-docs-network-port-publishing"]},
  {"id":"docker.networking.cfg.port-publish-syntax.publish-on-default-bridge","scope":"port-publish-syntax","key":"--publish required for outside-the-bridge access","type":"property","default_value":null,"description":"Same-network containers reach each other on all ports without -p; -p is needed only for outside-the-bridge clients (host or external).","source_ids":["docker-docs-network-bridge","docker-docs-network-port-publishing"]},

  {"id":"docker.networking.cfg.daemon.json-network.bridge","scope":"daemon.json-network","key":"bridge","type":"string (interface)","default_value":"docker0","description":"Network bridge name for the default bridge network. Re-keyed under `daemon.json-network` to avoid PK collision with engine's `daemon.json` scope; engine catalogs the daemon-wide config; here we attach the networking-specific semantic.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.daemon.json-network.bip","scope":"daemon.json-network","key":"bip","type":"string (CIDR)","default_value":null,"description":"Default-bridge IPv4 (with prefix). Pin to avoid VPN-subnet collisions.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.daemon.json-network.mtu","scope":"daemon.json-network","key":"mtu","type":"int","default_value":"1500","description":"Default-bridge MTU. Lower for tunnel-behind hosts.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.daemon.json-network.ip-forward","scope":"daemon.json-network","key":"ip-forward","type":"bool","default_value":"true","description":"Enable kernel `net.ipv4.ip_forward`. Disabling kills outbound bridge traffic.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.daemon.json-network.ip-masq","scope":"daemon.json-network","key":"ip-masq","type":"bool","default_value":"true","description":"MASQUERADE on default bridge. Bridge-driver alias of `com.docker.network.bridge.enable_ip_masquerade`.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-bridge","docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.daemon.json-network.iptables","scope":"daemon.json-network","key":"iptables","type":"bool","default_value":"true","description":"Daemon-managed iptables rules. Disabling = no DNAT for `-p`. Per `docker-docs-network-firewall`, you cannot completely prevent Docker from creating SOME firewall rules.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.daemon.json-network.ip6tables","scope":"daemon.json-network","key":"ip6tables","type":"bool","default_value":"true","description":"Daemon-managed ip6tables rules. Disabling per docs may break IPv6 packet filtering and port mapping.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.daemon.json-network.userland-proxy","scope":"daemon.json-network","key":"userland-proxy","type":"bool","default_value":"true","description":"Use docker-proxy for hairpin/loopback traffic.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.daemon.json-network.userland-proxy-path","scope":"daemon.json-network","key":"userland-proxy-path","type":"string (path)","default_value":"\"\" (bundled)","description":"Path to the docker-proxy binary if shipping a custom build.","source_ids":["docker-docs-cli-dockerd"]},
  {"id":"docker.networking.cfg.daemon.json-network.default-address-pools","scope":"daemon.json-network","key":"default-address-pools","type":"list[{base, size}]","default_value":"[{base:172.17.0.0/16, size:16}]","description":"IP pool space for new user-defined networks. Configure to avoid colliding on-prem subnets.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-bridge"]},
  {"id":"docker.networking.cfg.daemon.json-network.fixed-cidr","scope":"daemon.json-network","key":"fixed-cidr","type":"string (CIDR)","default_value":"\"\"","description":"IPv4 subnet for default-bridge container IP allocation (must be within `bip`).","source_ids":["docker-docs-cli-dockerd"]},
  {"id":"docker.networking.cfg.daemon.json-network.fixed-cidr-v6","scope":"daemon.json-network","key":"fixed-cidr-v6","type":"string (CIDR)","default_value":"\"\"","description":"IPv6 subnet for default bridge.","source_ids":["docker-docs-cli-dockerd"]},
  {"id":"docker.networking.cfg.daemon.json-network.dns","scope":"daemon.json-network","key":"dns","type":"list[IP]","default_value":"[]","description":"Default DNS servers for containers. Per-container override: `--dns`.","source_ids":["docker-docs-cli-dockerd"]},
  {"id":"docker.networking.cfg.daemon.json-network.dns-search","scope":"daemon.json-network","key":"dns-search","type":"list[string]","default_value":"[]","description":"Default DNS search domains.","source_ids":["docker-docs-cli-dockerd"]},
  {"id":"docker.networking.cfg.daemon.json-network.dns-opts","scope":"daemon.json-network","key":"dns-opts","type":"list[string]","default_value":"[]","description":"resolv.conf options (e.g. `[\"ndots:1\",\"timeout:2\"]`). Critical for k8s-style cluster DNS perf.","source_ids":["docker-docs-cli-dockerd"]},
  {"id":"docker.networking.cfg.daemon.json-network.host-gateway-ip","scope":"daemon.json-network","key":"host-gateway-ip","type":"list[IP]","default_value":"[default-bridge IPs]","description":"Resolves `host-gateway` token in `--add-host=host:host-gateway`. Lets containers reach the host without baking 172.x.0.1.","source_ids":["docker-docs-cli-dockerd","docker-docs-daemon-prometheus"]},
  {"id":"docker.networking.cfg.daemon.json-network.firewall-backend","scope":"daemon.json-network","key":"firewall-backend","type":"enum[iptables|nftables]","default_value":"iptables","description":"Pick nftables on modern systems where iptables is a compat wrapper.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-firewall"]},
  {"id":"docker.networking.cfg.daemon.json-network.ip-forward-no-drop","scope":"daemon.json-network","key":"ip-forward-no-drop","type":"bool","default_value":"false","description":"Don't set FORWARD chain default policy to DROP when enabling IP forwarding. Set true if you want the host to also act as a router.","source_ids":["docker-docs-cli-dockerd","docker-docs-network-firewall"]}
